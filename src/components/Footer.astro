---
import "../styles/footer.css";

import { site } from "../config/site";
import { uiEn } from "../i18n/ui.ts";

const isEn = Astro.currentLocale === "en";
const exploreItems = isEn ? uiEn.footer.explore : site.footer.explore;
const contactItems = isEn ? uiEn.footer.contact : site.footer.contact;
const legalItems = isEn ? uiEn.footer.legal : site.footer.legal;
const exploreTitle = isEn ? uiEn.footer.exploreTitle : "Explora";
const contactTitle = isEn ? uiEn.footer.contactTitle : "Contacto";
const legalAriaLabel = isEn ? uiEn.footer.legalAriaLabel : "Información legal";
const location = isEn ? uiEn.footer.location : site.footer.location;
const copyright = isEn ? uiEn.footer.copyright : site.footer.copyright;
const tagline = isEn ? uiEn.footer.tagline : site.brand.footerTagline;
---

<footer>

  <div class="footer-grid">

    <section>

      <div class="footer-brand">
        <img
          src={site.brand.logoHorizontal}
          width="280"
          height="59"
          alt={site.brand.name}
          loading="lazy"
          decoding="async"
        />
      </div>

      <p class="footer-tagline">
        {tagline}
      </p>

    </section>

    <nav
      class="footer-col"
      aria-label={exploreTitle}
    >

      <h2 class="footer-col-title">
        {exploreTitle}
      </h2>

      {
        exploreItems.map((item) => (
          <a
            href={item.href}
            target={item.href.startsWith("http") ? "_blank" : undefined}
            rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}
          >
            {item.label}
          </a>
        ))
      }

    </nav>

    <address class="footer-col">

      <h2 class="footer-col-title">
        {contactTitle}
      </h2>

      {
        contactItems.map((item) => (
          <a
            href={item.href}
            target={item.href.startsWith("http") ? "_blank" : undefined}
            rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}
            download={"download" in item && item.download ? true : undefined}
          >
            {item.label}
          </a>
        ))
      }

      <span class="footer-location">
        {location}
      </span>

    </address>

  </div>

  <div class="footer-legal-row">

    <p class="footer-copy">
      {copyright}
    </p>

    <nav
      class="footer-legal"
      aria-label={legalAriaLabel}
    >
      {
        legalItems.map((item) => (
          <a href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>

  </div>

</footer>