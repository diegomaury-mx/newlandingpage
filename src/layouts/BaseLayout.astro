---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

import "../styles/fonts.css";
import "../styles/variables.css";
import "../styles/globals.css";

import { site } from "../config/site";

const DEFAULT_OG_IMAGE = "/og/og-general.png";
const DEFAULT_OG_ALT = "Diego Maury, Strategic Program Director.";

interface AlternateUrl {
  lang: string;
  url: string;
}

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: string;
  ogImage?: string;
  ogImageAlt?: string;
  jsonLd?: unknown;
  enableGtm?: boolean;
  enableClarity?: boolean;
  ctaHref?: string;
  ctaLabel?: string;
  // hreflang: pares { lang, url } de las versiones ES/EN de esta misma
  // pagina. Solo se declara en paginas que efectivamente tienen ambas
  // versiones — sin esto, Google puede indexar /en/* y /* como contenido
  // duplicado en vez de reconocerlas como traducciones.
  alternateUrls?: AlternateUrl[];
  // Ruta relativa de la version en el otro idioma, para el toggle del
  // navbar. Se pasa por separado de alternateUrls (que llevan URL absoluta
  // para hreflang) porque el toggle necesita una ruta navegable con <a href>.
  otherLocaleHref?: string;
}

const {
  title = site.title,
  description = site.description,
  canonicalUrl,
  ogType = "website",
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = DEFAULT_OG_ALT,
  jsonLd,
  enableGtm = false,
  enableClarity = false,
  ctaHref = site.links.scheduling,
  ctaLabel = "Hagamos que las cosas pasen",
  alternateUrls = [],
  otherLocaleHref,
}: Props = Astro.props;

const htmlLang = Astro.currentLocale === "en" ? "en" : site.language;
const ogLocale = Astro.currentLocale === "en" ? "en_US" : "es_MX";
// Acepta ruta relativa o URL absoluta (banners de caso ya vienen absolutos).
const absoluteOgImage = new URL(ogImage, Astro.site).toString();
// Las dimensiones 1200x630 PNG solo aplican a las imagenes de /og/.
const isStaticOgImage = ogImage.startsWith("/og/");
---

<!doctype html>

<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />

    {enableGtm && (
      <script is:inline>
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
          const f = d.getElementsByTagName(s)[0];
          const j = d.createElement(s);
          const dl = l !== "dataLayer" ? "&l=" + l : "";
          j.async = true;
          j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, "script", "dataLayer", "GTM-NHT5827J");
      </script>
    )}

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="theme-color"
      content="#0A0612"
    />

    <link
      rel="icon"
      href="/favicon.ico"
      sizes="32x32"
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <link
      rel="icon"
      type="image/png"
      href="/favicon-96x96.png"
      sizes="96x96"
    />

    <link
      rel="apple-touch-icon"
      href="/apple-touch-icon.png"
    />

    <link
      rel="manifest"
      href="/site.webmanifest"
    />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    {canonicalUrl && (
      <link
        rel="canonical"
        href={canonicalUrl}
      />
    )}

    {alternateUrls.map((alt) => (
      <link
        rel="alternate"
        hreflang={alt.lang}
        href={alt.url}
      />
    ))}

    <meta
      property="og:type"
      content={ogType}
    />

    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    {canonicalUrl && (
      <meta
        property="og:url"
        content={canonicalUrl}
      />
    )}

    <meta
      property="og:site_name"
      content="Diego Maury"
    />

    <meta
      property="og:locale"
      content={ogLocale}
    />

    <meta
      property="og:image"
      content={absoluteOgImage}
    />

    {isStaticOgImage && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />
      </>
    )}

    <meta
      property="og:image:alt"
      content={ogImageAlt}
    />

    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={title}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <meta
      name="twitter:image"
      content={absoluteOgImage}
    />

    <meta
      name="twitter:image:alt"
      content={ogImageAlt}
    />

    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
      />
    )}

    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <slot name="head" />
  </head>

  <body>
    {enableGtm && (
      <noscript>
        <iframe
          src="https://www.googletagmanager.com/ns.html?id=GTM-NHT5827J"
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        />
      </noscript>
    )}
    {enableClarity && <script is:inline src="/js/clarity.js"></script>}

    <a class="skip-link" href="#main">Saltar al contenido</a>

    <Navbar ctaHref={ctaHref} ctaLabel={ctaLabel} otherLocaleHref={otherLocaleHref} />

    <main id="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>
