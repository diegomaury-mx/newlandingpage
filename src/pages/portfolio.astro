---
// Home del portafolio (rediseño narrativo 2026-08-16, ver
// docs/superpowers/specs/2026-08-16-portfolio-rediseno-narrativo-design.md):
// sin indicador de evidencia en el listado (vive solo en cada caso), los 4
// casos Insignia con el mismo tratamiento visual (sin "featured"), franja de
// cifras de impacto antes de Insignia, y copy narrativo entre secciones
// editable desde Notion (bloques P1-P3+P5 en "Copy Oficial · diegomaury.mx
// SSOT", mismo mecanismo que S1-S8 de index.astro). Seccion Archivo retirada
// 2026-08-16: la capa `Archivo` de Notion sigue existiendo como estado de
// datos (ediciones/variantes conservadas para trazabilidad), simplemente ya
// no se expone en el listado publico.
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { slugify } from '../utils/slug.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { parseSiteCopySections, heading2, paragraphs } from '../utils/parseSiteCopy.ts';
import { toLocalePath } from '../utils/locale.ts';
import { caseDisplayTitle } from '../utils/caseTitle.ts';
import {
  sortInsignia,
  catalogCounts,
  impactMetrics,
  capabilityShowcase,
} from '../utils/portfolioData.ts';
import '../styles/portfolio.css';

type CaseEntry = CollectionEntry<'cases'>;

// Titulo de tarjeta = resultado como afirmacion (H1 del caso), nunca el rol.
// Cae al `title` de Notion solo si la ficha aun no tiene esa narrativa escrita.
function cardTitle(entry: CaseEntry): string {
  return caseDisplayTitle(entry.data);
}

const allCases = await getCollection('cases');

const published = allCases.filter((c) => !c.data.draft);

const insignia = sortInsignia(published.filter((c) => c.data.layer === 'Insignia'), 'es');
const soporte = published.filter((c) => c.data.layer === 'Soporte');

// Capability Showcase Grid: proyectos Soporte encabezados por capacidad, con
// filtro por chip y expansion in-line (ver design_handoff_capability_showcase_grid).
const showcase = capabilityShowcase(
  soporte,
  (c) => c.data.cardContext || c.data.objective || c.data.resultsAndActions,
  (c) => c.data.title,
);
const SHOWCASE_INITIAL = 9;

// --- Copy narrativo (Copy Oficial SSOT, bloques P1-P3+P5) ------------------------
// Mismo mecanismo que S1-S8 de index.astro. Si un bloque falta o esta vacio
// (Diego aun no lo llena en Notion), cae al borrador del spec — nunca deja
// una seccion vacia ni rompe el build.
const siteCopyEntries = await getCollection('siteCopy');
const siteCopyEntry = siteCopyEntries.find((entry) => entry.id === 'site');
const copySections = siteCopyEntry
  ? parseSiteCopySections(siteCopyEntry.data.markdown)
  : new Map();

const p1 = copySections.get('P1')?.blocks ?? [];
const p2 = copySections.get('P2')?.blocks ?? [];
const p3 = copySections.get('P3')?.blocks ?? [];
const p5 = copySections.get('P5')?.blocks ?? [];

const heroEyebrow = 'Strategic Program Director';
const heroH1 =
  heading2(p1) ||
  'Encuentro el mecanismo que frena la ejecución de operaciones complejas, y lo convierto en sistemas medibles que el equipo sostiene.';
const heroLede =
  paragraphs(p1)[0] ||
  'Programas de innovación, arquitecturas RevOps y ecosistemas de emprendimiento en LATAM. Este portafolio no publica lo que no puede probar, y lo dice en cada cifra.';

const insigniaEyebrow = copySections.get('P2')?.label ?? 'Casos insignia';
const insigniaHeadline =
  heading2(p2) || 'No son los casos más grandes. Son los que puedo defender de principio a fin.';

const soporteHeadline =
  heading2(p3) || 'El resto del registro. Menos protagonismo, la misma disciplina.';

// --- Cierre / CTA final ---------------------------------------------------
// Sin este bloque no habia ningun CTA propio de /portfolio despues del
// listado (solo el boton del navbar, facil de perder tras hacer scroll por
// Insignia+Soporte). Copy editable desde Notion (P5), mismo
// mecanismo y mismo destino canonico que el CTA del navbar/S8 del home.
const CALENDAR_HREF = 'https://calendar.notion.so/meet/diegomaurymx/5aad3vun';
const MAIL_HREF = 'mailto:dm@diegomaury.mx';
const closingEyebrow = copySections.get('P5')?.label ?? 'Siguiente paso';
const closingHeadline = heading2(p5) || '¿Este registro resuelve lo que tienes enfrente?';
const closingLede =
  paragraphs(p5)[0] ||
  'Hablemos de tu caso. Agenda una llamada o escríbeme directo.';

// --- Franja "Por los números" --------------------------------------------------
// Fila de catalogo: se calcula sola del contenido publicado, nunca se edita a
// mano — si Diego publica un caso nuevo, estas cifras se recalculan solas.
const {
  total: totalPublicadas,
  organizations: organizacionesUnicas,
  capabilities: camposUnicos,
} = catalogCounts([...insignia, ...soporte]);
// Reusa el mismo numero+calificacion que index.astro S2 (STAT_SUBLABELS[1]):
// 7+ es especifico a innovacion/ecosistemas, no la trayectoria total (esa es
// 10+, Copy LinkedIn SSOT) — ver correccion 2026-08-16 del spec tras revision.
const ANOS_EXPERIENCIA = '7+';
const ANOS_EXPERIENCIA_LABEL = 'años en innovación y ecosistemas';

// Fila de impacto: SIEMPRE leida de la coleccion `metrics` por slug, nunca
// tipeada a mano — si una metrica cambia de estado en Notion (ej. se retira),
// se refleja sola. Cada cifra renderiza su `mandatoryQualifier` sin
// excepcion (regla dura de la revision del spec: el caveat de RODI
// "cost-avoidance modelado" no puede faltar en ningun tamano tipografico).
const metricsEntries = await getCollection('metrics');
const { anchors: impactAnchors, support: impactSupport } = impactMetrics(metricsEntries);

const pageTitle = 'Portafolio · Diego Maury';
const pageDescription =
  'Portafolio con evidencia verificable, caso por caso. Programas de innovación, arquitecturas RevOps y ecosistemas de emprendimiento en LATAM.';
const canonicalUrl = new URL('/portfolio', Astro.site).toString();
const enUrl = new URL('/en/portfolio', Astro.site).toString();
const ogImage = new URL('/assets/img/diego-maury.png', Astro.site).toString();

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: [...insignia, ...soporte].map((c, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/portfolio/${slugify(c.data.title)}`, Astro.site).toString(),
    name: cardTitle(c),
  })),
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={itemListJsonLd}
  ogImage={ogImage}
  alternateUrls={[{ lang: 'es', url: canonicalUrl }, { lang: 'en', url: enUrl }]}
  otherLocaleHref={toLocalePath(Astro.url.pathname, 'en')}
  enableGtm
>
  <div class="portfolio-page">
<section class="section hero">
  <div class="wrap">
    <div class="eyebrow">{heroEyebrow}</div>
    <h1>{heroH1}</h1>
    <p>{heroLede}</p>
  </div>
</section>

<section class="section stats">
  <div class="wrap">
    <div class="eyebrow eyebrow--plain">Por los números</div>

    <div class="stats__catalog">
      <div class="stat-cat">
        <div class="stat-cat__n">{totalPublicadas}</div>
        <div class="stat-cat__l">proyectos publicados</div>
      </div>
      <div class="stat-cat">
        <div class="stat-cat__n">{organizacionesUnicas}</div>
        <div class="stat-cat__l">organizaciones distintas</div>
      </div>
      <div class="stat-cat">
        <div class="stat-cat__n">{camposUnicos}</div>
        <div class="stat-cat__l">campos de expertise</div>
      </div>
      <div class="stat-cat">
        <div class="stat-cat__n">{ANOS_EXPERIENCIA}</div>
        <div class="stat-cat__l">{ANOS_EXPERIENCIA_LABEL}</div>
      </div>
    </div>

    {impactAnchors.length > 0 && (
      <div class="label stats__impact-label">Impacto documentado</div>
    )}

    {impactAnchors.length > 0 && (
      <div class="stats__anchors">
        {impactAnchors.map((m) => (
          <div class="stat-anchor">
            <div class="stat-anchor__n">{m.data.value}</div>
            <div class="stat-anchor__l">{m.data.metric}</div>
            <div class="stat-anchor__q">{m.data.mandatoryQualifier}</div>
          </div>
        ))}
      </div>
    )}

    {impactSupport.length > 0 && (
      <div class="stats__support">
        {impactSupport.map((m) => (
          <div class="stat-support">
            <div class="stat-support__n">{m.data.value}</div>
            <div class="stat-support__l">{m.data.metric}</div>
            <div class="stat-support__q">{m.data.mandatoryQualifier}</div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>

<section class="section gallery">
  <div class="wrap">
    <div class="eyebrow">{insigniaEyebrow}</div>
    <h2>{insigniaHeadline}</h2>
    {insignia.length === 0 && (
      <p class="empty-note">Sin fichas Insignia publicadas todavía.</p>
    )}
    {insignia.length > 0 && (
      <div class="gallery__grid">
        {insignia.map((c) => (
          <a class="card card--insignia" href={`/portfolio/${slugify(c.data.title)}`}>
            {c.data.banner ? (
              <div class="card__media">
                <img src={c.data.banner} alt={c.data.title} loading="lazy" width="800" height="500" />
                {c.data.logo && <img class="card__logo" src={c.data.logo} alt="" aria-hidden="true" loading="lazy" width="40" height="40" />}
              </div>
            ) : (
              <div class="media-void"><span>Sin imagen publicable</span></div>
            )}
            <div class="card__body">
              <span class="meta">{c.data.organization ?? '—'} · {c.data.year ?? '—'}</span>
              <h3 class="card__title">{cardTitle(c)}</h3>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</section>

<section class="section testimonials">
  <div class="wrap-narrow">
    <div class="eyebrow eyebrow--plain">Testimonios</div>
    <script src="https://widget.senja.io/widget/43006bd7-ae94-43c7-845a-7bb612ede4a3/platform.js" type="text/javascript" async></script>
    <div class="senja-embed" data-id="43006bd7-ae94-43c7-845a-7bb612ede4a3" data-mode="shadow" data-lazyload="false" style="display: block; width: 100%;"></div>
  </div>
</section>

<section class="section support">
  <div class="wrap">
    <div class="showcase-head">
      <div>
        <div class="eyebrow eyebrow--plain">Capacidades en operación</div>
        <h2 class="showcase-title">Lo que sé hacer, y dónde lo hice.</h2>
      </div>
      <div class="showcase-count">
        {showcase.total} proyectos<br />
        {showcase.capabilityCount} {showcase.capabilityCount === 1 ? 'capacidad' : 'capacidades'}
      </div>
    </div>

    {showcase.total === 0 ? (
      <p class="empty-note">Sin fichas Soporte publicadas todavía.</p>
    ) : (
      <Fragment>
        <div class="showcase-chips" role="group" aria-label="Filtrar por capacidad">
          <button type="button" class="chip is-active" data-cap="" aria-pressed="true">Todos</button>
          {showcase.tags.map((tag) => (
            <button type="button" class="chip" data-cap={tag} aria-pressed="false">{tag}</button>
          ))}
        </div>

        <div
          class="showcase-grid"
          data-initial={SHOWCASE_INITIAL}
          data-cta-open="Cerrar"
          data-cta-closed="Leer más +"
        >
          {showcase.projects.map((p) => (
            <article
              class="showcase-card"
              role="button"
              tabindex="0"
              aria-expanded="false"
              aria-controls={`showcase-desc-${p.id}`}
              data-id={p.id}
              data-caps={p.tags.join('|')}
              data-default-lead={p.tags[0] ?? ''}
            >
              <div class="showcase-card__lead">{p.tags[0] ?? ''}</div>
              {p.logo ? (
                <img
                  class="showcase-card__logo showcase-card__logo--img"
                  src={p.logo}
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  width="52"
                  height="52"
                />
              ) : (
                <div class="showcase-card__logo" aria-hidden="true">{p.initials}</div>
              )}
              <div>
                <h3 class="showcase-card__title">{p.title}</h3>
                <div class="showcase-card__meta">{p.org} · {p.year ?? '—'}</div>
              </div>
              <p class="showcase-card__desc" id={`showcase-desc-${p.id}`}>{p.desc}</p>
              <div class="showcase-card__foot">
                <span class="showcase-card__cta">Leer más +</span>
                <span class="showcase-card__year">{p.year ?? ''}</span>
              </div>
              <a class="showcase-card__link" href={`/portfolio/${p.id}`}>Ver caso →</a>
            </article>
          ))}
        </div>

        {showcase.total > SHOWCASE_INITIAL && (
          <div class="showcase-more-wrap">
            <button type="button" class="showcase-more">
              Ver los <span data-remaining>{showcase.total - SHOWCASE_INITIAL}</span> restantes
            </button>
          </div>
        )}
      </Fragment>
    )}
  </div>
</section>

<script>
  import { initShowcase } from '../scripts/capabilityShowcase.ts';
  initShowcase();
</script>

<section class="section closing">
  <div class="wrap-narrow">
    <div class="eyebrow">{closingEyebrow}</div>
    <h2>{closingHeadline}</h2>
    <p>{closingLede}</p>
    <div class="closing__ctas">
      <a class="btn-primary" href={CALENDAR_HREF} target="_blank" rel="noopener">Agendar una llamada</a>
      <a class="btn-ghost" href={MAIL_HREF}>Escríbeme</a>
    </div>
  </div>
</section>
  </div>
</BaseLayout>
