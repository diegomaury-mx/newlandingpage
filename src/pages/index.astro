<!--
  Home construido desde Notion (Diego CMS). Fuente: siteCopy singleton,
  parseado por src/utils/parseSiteCopy.ts. Markup y CSS de componentes
  portados desde index.html (referencia visual del DS V2 "Ember on Ink").
-->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,700;0,800;1,400&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  /* ── TOKENS DS v2 "Ember on Ink" ── */
  :root {
    --bg:     #0A0612;
    --bg-2:   #1A1128;
    --border: #6A291B;
    --t1:     #FAF8FC;
    --t2:     #DDDBE0;
    --t3:     #A8A6AC;
    --ember:  #FF5C39;
    --ember-cta: #BF452B; /* ember oscurecido: cumple AA 4.5:1 con texto blanco en botones */
    --accent-secondary:      var(--ember);
    --accent-secondary-text: var(--ember);
    --sans:   'Plus Jakarta Sans', system-ui, sans-serif;
    --mono:   'DM Mono', ui-monospace, monospace;
    --ease:   cubic-bezier(0.16, 1, 0.3, 1);
    --ease-in-out: cubic-bezier(0.45, 0, 0.55, 1);
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: var(--sans);
    background: var(--bg);
    color: var(--t1);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  a { color: var(--ember); }
  ::selection { background: var(--ember); color: var(--bg); }
  :focus-visible { outline: 2px solid var(--ember); outline-offset: 2px; }

  /* ── SCROLL REVEAL ── */
  [data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
    transition-delay: var(--delay, 0s);
  }
  [data-reveal].is-visible { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; transition: none; }
  }

  /* ── NAV ── */
  #nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 90;
    background: rgba(10,6,18,0.92);
    border-bottom: 1px solid transparent;
    backdrop-filter: blur(16px);
    transition: border-color 250ms, background 250ms;
  }
  #nav.is-scrolled { background: rgba(10,6,18,0.98); border-bottom-color: var(--border); }
  .nav-inner {
    max-width: 1160px; margin: 0 auto; padding: 0 32px;
    height: 64px; display: flex; align-items: center; justify-content: space-between;
  }
  .nav-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .nav-mark { width: 28px; height: 28px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
  .nav-mark img { width: 28px; height: 28px; display: block; }
  .nav-name { font-size: 14px; font-weight: 700; color: var(--t1); letter-spacing: -0.01em; }
  .nav__links { display: flex; gap: 0; align-items: center; }
  .nav__link {
    font-size: 13px; font-weight: 500; color: var(--t2); padding: 7px 13px;
    border-radius: 6px; text-decoration: none;
    transition: color 150ms, background 150ms; letter-spacing: -0.01em;
  }
  .nav__link:hover { color: var(--t1); background: rgba(255,255,255,0.05); }
  .nav__link.is-active { color: var(--t1); }
  .nav-cta {
    display: inline-flex; align-items: center; background: var(--ember-cta); color: #fff;
    font-family: var(--mono); font-size: 9.5px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase;
    padding: 9px 17px; border-radius: 6px; border: none; cursor: pointer;
    text-decoration: none; margin-left: 8px; transition: opacity 150ms, transform 150ms;
  }
  .nav-cta:hover { opacity: 0.88; transform: translateY(-1px); }
  .nav__burger { display: none; background: none; border: none; cursor: pointer; padding: 6px; color: var(--t2); }
  .nav__burger svg { display: block; }
  @media (max-width: 768px) {
    .nav__links {
      display: none; position: fixed; inset: 64px 0 0 0;
      background: rgba(10,6,18,0.98); backdrop-filter: blur(16px);
      flex-direction: column; align-items: flex-start; gap: 0;
      padding: 24px 32px; border-top: 1px solid var(--border);
    }
    .nav__links.is-open { display: flex; }
    .nav__link { font-size: 17px; padding: 12px 0; width: 100%; border-radius: 0; }
    .nav-cta { margin-left: 0; margin-top: 12px; }
    .nav__burger { display: block; }
  }

  /* ── SECTION BASE ── */
  .section { padding: clamp(72px, 7vw, 112px) 32px; border-bottom: 1px solid var(--border); }
  .section:first-of-type { padding-top: calc(clamp(72px,7vw,112px) + 64px); }
  .section-inner { max-width: 1160px; margin: 0 auto; }
  .section-label {
    font-family: var(--mono); font-size: 10px; font-weight: 500;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--ember);
    display: flex; align-items: center; gap: 10px; margin-bottom: 18px;
  }
  .section-label::before { content: ''; width: 18px; height: 1px; background: var(--ember); }
  .section-title { font-size: clamp(1.65rem, 2.7vw, 2.5rem); font-weight: 700; letter-spacing: -0.028em; line-height: 1.1; margin-bottom: 12px; }
  .section-sub { font-size: 1rem; color: var(--t2); line-height: 1.7; margin-bottom: 24px; max-width: 68ch; }
  .inline-link { color: var(--ember); text-decoration: underline; text-underline-offset: 2px; }
  .inline-link:hover, .inline-link:focus-visible { color: var(--t1); }

  /* ── BUTTONS ── */
  .btn-primary {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--ember-cta); color: #fff; font-family: var(--mono);
    font-size: 10px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase;
    padding: 14px 26px; border-radius: 6px; border: none; cursor: pointer;
    text-decoration: none; transition: opacity 150ms, transform 150ms;
  }
  .btn-primary:hover { opacity: 0.88; transform: translateY(-2px); }
  .btn-ghost {
    display: inline-flex; align-items: center; gap: 8px;
    background: transparent; color: var(--t1); font-family: var(--mono);
    font-size: 10px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase;
    padding: 13px 24px; border-radius: 6px; border: 1px solid var(--border);
    cursor: pointer; text-decoration: none; transition: border-color 150ms, background 150ms, transform 150ms;
  }
  .btn-ghost:hover { border-color: var(--t2); background: rgba(255,255,255,0.03); transform: translateY(-2px); }

  /* ── HERO ── */
  .hero-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 40px; align-items: center; }
  .hero-media { border-radius: 16px; overflow: hidden; height: 380px; border: 1px solid var(--border); background: var(--bg-2); }
  .hero-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } .hero-media { height: 240px; order: -1; } }
  .hero-label {
    font-family: var(--mono); font-size: 10px; font-weight: 500;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--ember);
    margin-bottom: 28px; display: flex; align-items: center; gap: 10px;
  }
  .hero-label::before { content: ''; width: 18px; height: 1px; background: var(--ember); }
  .hero-h1 { font-size: clamp(2.4rem, 4.6vw, 4rem); font-weight: 300; letter-spacing: -0.032em; line-height: 1.05; max-width: 20ch; margin-bottom: 22px; }
  .hero-h1 .accent { color: var(--ember); }
  .hero-sub { font-size: clamp(1rem, 1.3vw, 1.13rem); color: var(--t2); line-height: 1.7; max-width: 56ch; margin-bottom: 36px; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 60px; }

  /* ── METRICS ── */
  .metrics { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--border); }
  @media (max-width: 720px) { .metrics { grid-template-columns: 1fr; } }
  .metric { padding: 28px 28px 28px 24px; border-right: 1px solid var(--border); }
  .metric:first-child { padding-left: 0; }
  .metric:last-child { border-right: none; }
  @media (max-width: 720px) {
    .metric { border-right: none; padding-right: 0; padding-left: 0; }
    .metric:not(:first-child) { border-top: 1px solid var(--border); padding-top: 22px; }
  }
  .metric-n { font-size: clamp(1.7rem, 2.5vw, 2.4rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1; color: var(--ember); font-variant-numeric: tabular-nums; }
  .metric-l { font-size: 13px; font-weight: 500; color: var(--t1); margin-top: 8px; line-height: 1.3; }
  .metric-s { font-family: var(--mono); font-size: 9px; color: var(--t3); margin-top: 4px; letter-spacing: 0.08em; text-transform: uppercase; }

  /* ── TRUST MARQUEE ── */
  .trust { margin-top: 44px; }
  .trust-label { font-family: var(--mono); font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--t3); margin-bottom: 12px; }
  .trust-track-wrap {
    overflow: hidden; position: relative;
    mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
  }
  .trust-track { display: flex; width: max-content; animation: marquee 24s linear infinite; }
  .trust-track:hover { animation-play-state: paused; }
  @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .trust-logo {
    display: flex; align-items: center; justify-content: center;
    width: 132px; height: 52px; margin: 0 6px; flex-shrink: 0;
    background: rgba(250,248,252,0.04); border: 1px solid var(--border); border-radius: 10px;
    transition: background 200ms, border-color 200ms;
  }
  .trust-logo:hover { background: rgba(250,248,252,0.08); border-color: var(--t3); }
  .trust-logo img { height: 24px; width: 90px; object-fit: contain; object-position: center; opacity: 0.82; transition: opacity 200ms; }
  .trust-logo:hover img { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .trust-track { animation: none; } }

  /* ── ABOUT ── */
  .about-section { padding: 0; border-bottom: 1px solid var(--border); overflow: hidden; }
  .about-body {
    max-width: 1160px; margin: 0 auto; padding: clamp(72px,7vw,112px) 32px clamp(56px,6vw,88px);
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 40px;
  }
  @media (max-width: 960px) { .about-body { grid-template-columns: 1fr; align-items: center; text-align: center; } }
  .about-left { display: flex; flex-direction: column; gap: 24px; padding-bottom: 56px; }
  .about-name { font-size: clamp(2.2rem, 3.6vw, 3.2rem); font-weight: 300; letter-spacing: -0.03em; line-height: 1; }
  .about-title-txt { font-family: var(--mono); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ember); margin-top: 6px; }
  .about-tagline { font-size: 14px; color: var(--t2); line-height: 1.65; max-width: 36ch; }
  .about-roles { display: flex; flex-direction: column; gap: 9px; }
  .about-role { display: flex; align-items: flex-start; gap: 10px; }
  @media (max-width: 960px) { .about-role { justify-content: center; } }
  .about-role-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--ember); flex-shrink: 0; margin-top: 8px; }
  .about-role-txt { font-size: 13px; color: var(--t2); line-height: 1.5; }
  .about-role-txt strong { color: var(--t1); }

  .about-photo-wrap { position: relative; display: flex; justify-content: center; flex-shrink: 0; align-self: flex-end; }
  .about-circle-bg {
    width: clamp(220px, 22vw, 300px); height: clamp(220px, 22vw, 300px); border-radius: 50%;
    background: rgba(255,92,57,0.08); border: 1px solid rgba(255,92,57,0.15);
    position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); z-index: 0;
  }
  .about-photo-slot {
    width: clamp(200px, 20vw, 280px); height: clamp(260px, 28vw, 360px);
    position: relative; z-index: 1; display: flex; align-items: flex-end; justify-content: center; overflow: hidden;
  }
  .about-photo-slot img {
    width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block;
    mask-image: linear-gradient(to bottom, black 82%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 82%, transparent 100%);
  }
  @media (max-width: 960px) {
    .about-circle-bg { position: relative; left: auto; transform: none; margin: 0 auto; }
    .about-photo-wrap { flex-direction: column; align-items: center; }
  }

  .about-right { display: flex; flex-direction: column; gap: 28px; padding-bottom: 56px; }
  .about-bio { font-size: 13.5px; color: var(--t2); line-height: 1.7; max-width: 36ch; }
  .about-bio strong { color: var(--t1); }
  @media (max-width: 960px) { .about-right { align-items: center; } .about-bio { text-align: center; } }

  /* ── PROBLEMA ── */
  .problema-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 32px; align-items: center; margin-bottom: 8px; }
  .problema-media {
    border-radius: 16px; overflow: hidden; height: 260px; border: 1px solid var(--border);
    background: var(--bg-2); display: flex; align-items: center; justify-content: center; padding: 28px;
  }
  .problema-media svg { width: 100%; height: 100%; max-width: 220px; }
  @media (max-width: 800px) { .problema-grid { grid-template-columns: 1fr; } .problema-media { height: 200px; } }

  .flow-diagram { display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 16px; flex-wrap: wrap; max-width: 780px; margin: 32px auto; }
  .flow-card { background: var(--bg-2); border: 1px solid var(--border); border-radius: 16px; padding: 20px 22px; flex: 1; min-width: 160px; }
  .flow-card-head {
    font-family: var(--mono); font-size: 11px; font-weight: 600; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--ember); margin-bottom: 16px; display: flex; align-items: center; gap: 9px;
  }
  .flow-card-head::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--ember); flex-shrink: 0; }
  .flow-list { list-style: none; display: grid; grid-template-columns: 1fr; gap: 8px; }
  .flow-list li { font-size: 13.5px; color: var(--t2); padding-left: 15px; position: relative; }
  .flow-list li::before { content: ''; position: absolute; left: 0; top: 0.65em; width: 7px; height: 1px; background: var(--t3); }
  .flow-connector { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 0 18px; flex-shrink: 0; }
  .flow-connector-line { width: 20px; height: 1px; background: var(--border); }
  .flow-connector-label { font-family: var(--mono); font-size: 9.5px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--t3); }
  .flow-chips { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
  .flow-chip {
    font-family: var(--mono); font-size: 11px; font-weight: 500; color: var(--t1);
    background: rgba(255,92,57,0.1); border: 1px solid rgba(255,92,57,0.3); border-radius: 999px; padding: 5px 13px;
  }
  .flow-arrow { width: 8px; height: 8px; border-right: 1.5px solid var(--ember); border-bottom: 1.5px solid var(--ember); transform: rotate(-45deg); }

  /* ── TABLA DE CAPACIDADES ── */
  .cap-table { width: 100%; border-collapse: collapse; margin: 28px 0; }
  .cap-table th, .cap-table td { text-align: left; padding: 12px 16px; border-bottom: 1px solid var(--border); font-size: 13px; color: var(--t2); }
  .cap-table th { font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--t3); font-weight: 500; }
  .cap-table td:first-child { color: var(--t1); font-weight: 600; }

  /* ── IP CARDS (evidencia + sistemas propios) ── */
  .ip-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }
  @media (max-width: 900px) { .ip-grid { grid-template-columns: 1fr; } }
  .ip {
    background: var(--bg-2); border: 1px solid var(--border); border-radius: 10px; padding: 28px 30px;
    transition: border-color 200ms, transform 250ms var(--ease); position: relative; overflow: hidden;
    display: flex; flex-direction: column;
  }
  .ip::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--ember); }
  .ip:hover { border-color: var(--t3); transform: translateY(-3px); }
  .ip-media { margin: -28px -30px 20px; height: 140px; border-radius: 10px 10px 0 0; overflow: hidden; background: var(--bg); display: flex; align-items: center; justify-content: center; }
  .ip-media img { max-width: 60%; max-height: 60%; object-fit: contain; filter: grayscale(1) brightness(1.6); opacity: 0.9; }
  .ip-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 6px; }
  .ip-label { font-family: var(--mono); font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ember); margin-bottom: 7px; }
  .ip-name { font-size: 1.1rem; font-weight: 700; color: var(--t1); }
  .ip-badge {
    font-family: var(--mono); font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap;
    padding: 4px 9px; border-radius: 3px; border: 1px solid var(--border); color: var(--t3); flex-shrink: 0;
  }
  .ip-desc { font-size: 13.5px; color: var(--t2); line-height: 1.6; margin-bottom: 12px; }
  .ip-field-label { font-family: var(--mono); font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--t3); display: block; margin-bottom: 4px; margin-top: 12px; }
  .ip-field-label:first-of-type { margin-top: 0; }
  .ip-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; padding-top: 18px; margin-top: auto; border-top: 1px solid var(--border); }
  .ip-stat-n { font-size: 1.3rem; font-weight: 700; letter-spacing: -0.02em; color: var(--ember); line-height: 1; }
  .ip-stat-l { font-family: var(--mono); font-size: 9px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--t3); margin-top: 5px; }
  .svc-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 4px; margin-top: auto; }
  .svc-item { display: flex; gap: 10px; font-size: 12.5px; color: var(--t2); line-height: 1.4; }
  .svc-item::before { content: '→'; font-family: var(--mono); font-size: 10px; color: var(--ember); flex-shrink: 0; padding-top: 1px; }
  .ip-case-link {
    display: inline-block; margin-top: 16px; font-family: var(--mono);
    font-size: 11px; font-weight: 600; letter-spacing: 0.04em; color: var(--ember); text-decoration: none;
  }
  .ip-case-link:hover { text-decoration: underline; }
  .ip-case-btn {
    display: inline-flex; align-items: center; gap: 8px; margin-top: 16px;
    background: var(--ember-cta); color: #fff; font-family: var(--mono);
    font-size: 10.5px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
    padding: 10px 18px; border: none; border-radius: 6px; text-decoration: none;
    transition: opacity 150ms, transform 150ms; align-self: flex-start;
  }
  .ip-case-btn:hover { opacity: 0.88; transform: translateY(-1px); }

  /* ── PIPELINE CREATIVO ASCENDENTE ── */
  .pipeline-creative { display: flex; align-items: flex-end; gap: 10px; margin: 40px 0 12px; max-width: 780px; }
  .pc-step { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 12px; }
  .pc-bar {
    width: 100%; border-radius: 10px 10px 3px 3px; background: var(--bg-2);
    border: 1px solid var(--border); display: flex; align-items: flex-start; justify-content: center;
    padding-top: 10px; font-family: var(--mono); font-size: 12px; font-weight: 700; color: var(--t2);
  }
  .pc-step.is-outcome .pc-bar { background: var(--ember); border-color: var(--ember); color: #fff; }
  .pc-label { font-size: 11.5px; font-weight: 600; color: var(--t2); text-align: center; }
  .pc-step.is-outcome .pc-label { color: var(--t1); }
  @media (max-width: 680px) { .pipeline-creative { gap: 6px; } .pc-label { font-size: 10px; } }

  /* ── PATTERN ACCORDION (Como trabajo) ── */
  .accordion-wrap { display: grid; grid-template-columns: 1fr 340px; gap: 28px; align-items: start; }
  @media (max-width: 760px) { .accordion-wrap { grid-template-columns: 1fr; gap: 0; } }
  .accordion-list { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; background: var(--bg-2); }
  .acc-item { border-bottom: 1px solid var(--border); }
  .acc-item:last-child { border-bottom: none; }
  .acc-item-head {
    display: flex; align-items: center; gap: 16px; padding: 20px 22px; transition: background 200ms;
    background: none; border: none; width: 100%; text-align: left; font: inherit; color: inherit; cursor: pointer;
  }
  .acc-item:hover .acc-item-head { background: rgba(250,248,252,0.03); }
  .acc-item-n { font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; color: var(--t3); flex-shrink: 0; width: 24px; transition: color 200ms; }
  .acc-item.is-active .acc-item-n { color: var(--ember); }
  .acc-item-t { font-size: 14.5px; font-weight: 700; color: var(--t2); transition: color 200ms; }
  .acc-item.is-active .acc-item-t { color: var(--t1); }
  .acc-item-head::after { content: '+'; margin-left: auto; font-family: var(--mono); font-size: 16px; color: var(--t3); }
  .acc-item.is-active .acc-item-head::after { content: '\2212'; color: var(--ember); }
  .acc-detail { max-height: 0; overflow: hidden; transition: max-height 300ms var(--ease); }
  .acc-d { font-size: 12.5px; color: var(--t2); line-height: 1.6; padding: 0 22px 20px 62px; }
  /* Valor mayor al del componente de referencia (90px): el copy real de esta
     pagina trae parrafos mas largos que el placeholder de index.html y con
     90px se recortaba texto visible. */
  .acc-item.is-active .acc-detail { max-height: 260px; }
  .acc-panel { position: sticky; top: 100px; border: 1px solid var(--border); border-radius: 10px; background: var(--bg-2); padding: 28px 26px; }
  @media (max-width: 760px) { .acc-panel { display: none; } }
  .acc-panel-n { font-family: var(--mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ember); margin-bottom: 14px; }
  .acc-panel-t { font-size: 20px; font-weight: 700; color: var(--t1); margin-bottom: 12px; }
  .acc-panel-d { font-size: 13px; color: var(--t2); line-height: 1.65; margin-bottom: 18px; }
  .acc-pips { display: flex; gap: 6px; }
  .acc-pip { width: 20px; height: 3px; border-radius: 2px; background: var(--border); transition: background 200ms; }
  .acc-pip.is-active { background: var(--ember); }

  /* "Lo que entrego": sin componente propio en el DS de referencia, se
     reutiliza el patron de lista con punto (about-roles) ya existente. */
  .deliver-heading { margin-top: 56px; font-size: clamp(1.3rem, 2.2vw, 1.7rem); font-weight: 700; letter-spacing: -0.01em; margin-bottom: 16px; }

  /* ── PRUEBA SOCIAL ── */
  .testimonial-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 32px; }
  @media (max-width: 900px) { .testimonial-grid { grid-template-columns: 1fr; } }
  .testimonial-card {
    background: var(--bg-2); border: 1px solid var(--border); border-radius: 10px; padding: 26px 26px 24px;
    display: flex; flex-direction: column; gap: 18px; transition: border-color 200ms, transform 250ms var(--ease);
  }
  .testimonial-card:hover { border-color: var(--t3); transform: translateY(-3px); }
  .testimonial-quote { font-size: 13.5px; line-height: 1.65; color: var(--t2); flex-grow: 1; }
  .testimonial-cite { display: flex; flex-direction: column; gap: 2px; padding-top: 14px; border-top: 1px solid var(--border); }
  .testimonial-name { font-size: 13px; font-weight: 700; color: var(--t1); }
  .testimonial-role { font-family: var(--mono); font-size: 10px; letter-spacing: 0.04em; color: var(--t3); }

  /* ── COLABOREMOS ── */
  .conversemos-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 32px; align-items: center; margin-bottom: 44px; }
  .conversemos-media { border-radius: 16px; overflow: hidden; height: 260px; border: 1px solid var(--border); }
  .conversemos-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media (max-width: 800px) { .conversemos-grid { grid-template-columns: 1fr; } .conversemos-media { height: 200px; } }

  .svc-argument { margin-top: 8px; padding: 28px 30px; background: var(--bg-2); border: 1px solid var(--border); border-radius: 10px; }
  .svc-argument-q { font-size: 1rem; font-weight: 700; color: var(--t1); margin-bottom: 14px; }
  .svc-argument p { font-size: 13.5px; color: var(--t2); line-height: 1.7; max-width: 68ch; }

  .talk__agenda { margin-top: 44px; padding-top: 40px; border-top: 1px solid var(--border); }
  .talk__agenda h3 { font-size: clamp(1.3rem, 2.2vw, 1.7rem); font-weight: 700; margin-bottom: 16px; }
  .talk__alt { margin-top: 20px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .talk__alt-item { display: flex; align-items: center; gap: 10px; }
  .talk__sep { font-family: var(--mono); font-size: 12px; color: var(--t3); }

  /* ── CTA FINAL (Siguiente paso) ── */
  .cta-section { text-align: center; }
  .cta-inner { max-width: 760px; margin: 0 auto; }
  .cta-label-center {
    font-family: var(--mono); font-size: 10px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ember);
    display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 24px;
  }
  .cta-label-center::before, .cta-label-center::after { content: ''; width: 24px; height: 1px; background: var(--ember); }
  .cta-h { font-size: clamp(1.9rem, 3.6vw, 3.1rem); font-weight: 300; letter-spacing: -0.03em; line-height: 1.08; margin-bottom: 18px; }
  .cta-sub { font-size: 1.02rem; color: var(--t2); line-height: 1.7; max-width: 50ch; margin: 0 auto 48px; }
  .cta-steps {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--border);
    border: 1px solid var(--border); border-radius: 10px; overflow: hidden; margin-bottom: 44px; text-align: left;
  }
  @media (max-width: 680px) { .cta-steps { grid-template-columns: 1fr; } }
  .cta-step { background: var(--bg-2); padding: 28px 26px 32px; position: relative; }
  .cta-step::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: transparent; transition: background 200ms; }
  .cta-step:hover::before { background: var(--ember); }
  .cta-step-n { font-family: var(--mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ember); margin-bottom: 18px; }
  .cta-step-d { font-size: 12.5px; color: var(--t2); line-height: 1.55; margin-bottom: 14px; }
  .cta-step-tag {
    font-family: var(--mono); font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--t3);
    border: 1px solid var(--border); border-radius: 3px; padding: 3px 7px; display: inline-block;
  }
  .cta-buttons { display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .cta-trust { font-family: var(--mono); font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--t3); display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: center; }
  .dot { width: 2px; height: 2px; border-radius: 50%; background: var(--border); }

  /* ── FOOTER ── */
  footer { background: var(--bg); border-top: 1px solid var(--border); padding: 3rem 0 2rem; }
  .footer-grid { max-width: 1160px; margin: 0 auto; padding: 0 32px; display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: 2rem; }
  @media (max-width: 720px) { .footer-grid { grid-template-columns: 1fr; gap: 1.75rem; } }
  .footer-brand { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
  .footer-brand img { width: 24px; height: 24px; display: block; flex-shrink: 0; }
  .footer-name { font-size: 14px; font-weight: 700; color: var(--t1); }
  .footer-tagline { font-size: 12.5px; color: var(--t2); line-height: 1.6; max-width: 32ch; }
  .footer-col-title { font-family: var(--mono); font-size: 9px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ember); margin-bottom: 12px; }
  .footer-col { display: flex; flex-direction: column; gap: 9px; }
  .footer-col a, .footer-col span { font-size: 12.5px; color: var(--t2); text-decoration: none; transition: color 150ms; }
  .footer-col a:hover { color: var(--t1); }
  .footer-legal-row { max-width: 1160px; margin: 28px auto 0; padding: 18px 32px 0; border-top: 1px solid var(--border); }
  .footer-copy { font-family: var(--mono); font-size: 10px; letter-spacing: 0.04em; color: var(--t3); }
</style>
</head>
<body>
<!-- Google Tag Manager -->
<script is:inline src="/js/gtm.js"></script>
<!-- End Google Tag Manager -->

<nav id="nav" aria-label="Navegación principal">
  <div class="nav-inner">
    <a href={`#${SECTION_IDS.S1}`} class="nav-brand" aria-label={`${heroName || 'Diego Maury'}, Inicio`}>
      <div class="nav-mark"><img src="/assets/img/isotipo-ember.svg" width="28" height="28" alt=""></div>
      <span class="nav-name">{heroName || 'Diego Maury'}</span>
    </a>
    <div class="nav__links" id="navLinks">
      {navItems.map((item) => <a href={item.href} class="nav__link">{item.label}</a>)}
    </div>
    <a href={`#${SECTION_IDS.S4}`} class="nav-cta">Ver casos de estudio</a>
    <button type="button" class="nav__burger" id="navBurger" aria-label="Abrir menú" aria-expanded="false" aria-controls="navLinks">
      <svg width="22" height="16" viewBox="0 0 22 16" fill="none" aria-hidden="true">
        <path d="M1 1h20M1 8h20M1 15h20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</nav>

<!-- S1 HERO -->
<section class="section" id={SECTION_IDS.S1}>
  <div class="section-inner">
    <div class="hero-grid">
      <div>
        <div class="hero-label" data-reveal>{heroRole || 'Strategic Program Director'}</div>
        <h1 class="hero-h1" data-reveal style="--delay:.08s">
          {heroHeadlineBefore}{heroHeadlineAccent && <span class="accent">{heroHeadlineAccent}</span>}{heroHeadlineAfter}
        </h1>
        {heroSub && <p class="hero-sub" data-reveal style="--delay:.14s">{heroSub}</p>}
        {heroCtas.length > 0 && (
          <div class="hero-ctas" data-reveal style="--delay:.2s">
            {heroCtas.map((label, i) => {
              const t = ctaTarget(label);
              return (
                <a
                  href={t.href}
                  class={i === 0 ? 'btn-primary' : 'btn-ghost'}
                  download={t.download}
                  target={t.external ? '_blank' : undefined}
                  rel={t.external ? 'noopener' : undefined}
                >{label}</a>
              );
            })}
          </div>
        )}
      </div>
      <div class="hero-media" data-reveal style="--delay:.1s">
        <img src={slotSrc('foto-diego', '/cms-media/diego/diegomaurypng.png')} alt={heroName || 'Diego Maury'} loading="eager" fetchpriority="high" width="700" height="875">
      </div>
    </div>
    {heroLogos.length > 0 && (
      <div class="trust" data-reveal style="--delay:.32s">
        <div class="trust-label">He trabajado con</div>
        <div class="trust-track-wrap">
          <div class="trust-track">
            {heroLogos.map((logo) => <div class="trust-logo"><img src={logo.src} alt={logo.alt} loading="lazy"></div>)}
            {heroLogos.map((logo) => <div class="trust-logo" aria-hidden="true"><img src={logo.src} alt="" loading="lazy"></div>)}
          </div>
        </div>
      </div>
    )}
  </div>
</section>

<!-- S2 QUIEN SOY -->
<section class="about-section" id={SECTION_IDS.S2}>
  <div class="about-body">
    <div class="about-left" data-reveal>
      <div>
        <div class="about-name">{heroName || 'Diego Maury'}</div>
        {heroRole && <div class="about-title-txt">{heroRole}</div>}
      </div>
      {aboutTagline && <p class="about-tagline">{aboutTagline}</p>}
      {aboutIntro.map((p) => <p class="about-tagline">{p}</p>)}
      {aboutRoles.length > 0 && (
        <div class="about-roles">
          {aboutRoles.map((role) => (
            <div class="about-role">
              <div class="about-role-dot"></div>
              <div class="about-role-txt">{role}</div>
            </div>
          ))}
        </div>
      )}
    </div>

    <div class="about-photo-wrap" data-reveal style="--delay:.1s">
      <div class="about-circle-bg"></div>
      <div class="about-photo-slot">
        <img src={slotSrc('foto-diego', '/cms-media/diego/diegomaurypng.png')} width="700" height="700" alt={heroName || 'Diego Maury'} loading="lazy">
      </div>
    </div>

    <div class="about-right" data-reveal style="--delay:.18s">
      {aboutBio && <p class="about-bio">{aboutBio}</p>}
      {aboutHeadline && <p class="about-bio">{aboutHeadline}</p>}
    </div>
  </div>
  {aboutStats.length > 0 && (
    <div style="max-width:1160px;margin:0 auto;padding:0 32px">
      <div class="metrics" data-reveal style="--delay:.26s">
        {aboutStats.map((stat) => (
          <div class="metric">
            <div class="metric-n" data-count={stat.countTo || undefined}>{stat.n}</div>
            <div class="metric-l">{stat.l}</div>
            {stat.s && <div class="metric-s">{stat.s}</div>}
          </div>
        ))}
      </div>
    </div>
  )}
</section>

<!-- S3 EL PROBLEMA QUE RESUELVO -->
<section class="section" id={SECTION_IDS.S3}>
  <div class="section-inner">
    <div class="problema-grid">
      <div>
        <div class="section-label" data-reveal>{problemLabel}</div>
        <h2 class="section-title" data-reveal style="--delay:.06s">{problemHeadline}</h2>
        {problemParas.map((p) => <p class="section-sub" data-reveal>{p}</p>)}
      </div>
      <div class="problema-media" data-reveal style="--delay:.1s" role="img" aria-label="Diagrama: estrategia y operación conectadas por un sistema">
        <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="40" cy="40" r="16" stroke="var(--border)" stroke-width="2" fill="var(--bg)"></circle>
          <circle cx="160" cy="40" r="16" stroke="var(--border)" stroke-width="2" fill="var(--bg)"></circle>
          <circle cx="100" cy="160" r="22" stroke="var(--ember)" stroke-width="2.5" fill="rgba(255,92,57,0.1)"></circle>
          <line x1="40" y1="56" x2="92" y2="142" stroke="var(--border)" stroke-width="2"></line>
          <line x1="160" y1="56" x2="108" y2="142" stroke="var(--border)" stroke-width="2"></line>
          <line x1="56" y1="40" x2="144" y2="40" stroke="var(--border)" stroke-width="2" stroke-dasharray="4 5"></line>
        </svg>
      </div>
    </div>

    {problemDiagram && (
      <div class="flow-diagram" data-reveal style="--delay:.22s">
        <div class="flow-card">
          <div class="flow-card-head">{problemDiagram.fromLabel}</div>
          <ul class="flow-list">{problemDiagram.fromItems.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div class="flow-connector">
          <span class="flow-connector-line"></span>
          <span class="flow-connector-label">{problemDiagram.connectorLabel}</span>
          <div class="flow-chips">
            {problemDiagram.connectorItems.map((item) => <span class="flow-chip">{item}</span>)}
          </div>
          <span class="flow-connector-line"></span>
          <span class="flow-arrow"></span>
        </div>
        <div class="flow-card">
          <div class="flow-card-head">{problemDiagram.toLabel}</div>
          <ul class="flow-list">{problemDiagram.toItems.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
    )}

    {problemQuote && <p class="section-sub" data-reveal style="--delay:.28s"><strong>{problemQuote}</strong></p>}
  </div>
</section>

<!-- S4 EVIDENCIA -->
<section class="section" id={SECTION_IDS.S4}>
  <div class="section-inner">
    <div class="section-label" data-reveal>{evidenceLabel}</div>
    <h2 class="section-title" data-reveal style="--delay:.06s">{evidenceHeadline}</h2>
    {evidenceIntro.map((p) => <p class="section-sub" data-reveal>{p}</p>)}

    {evidenceTable && (
      <table class="cap-table" data-reveal style="--delay:.16s">
        <thead>
          <tr>{evidenceTable.header.map((cell) => <th>{cell}</th>)}</tr>
        </thead>
        <tbody>
          {evidenceTable.rows.map((row) => (
            <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
          ))}
        </tbody>
      </table>
    )}

    {evidenceStatLine && <p class="section-sub" data-reveal style="--delay:.2s"><strong>{evidenceStatLine}</strong></p>}
    <a class="btn-primary" href="/portfolio" data-reveal style="--delay:.22s; display:inline-flex; margin-bottom:44px;">{evidenceCtaLabel} →</a>

    {evidenceCards.length > 0 && (
      <>
        <h3 class="section-title" data-reveal style="--delay:.24s; font-size: 1.4rem;">Casos destacados</h3>
        <div class="ip-grid" data-reveal style="--delay:.28s">
          {evidenceCards.map((card) => {
            const { label, name } = splitIpTitle(card.title);
            const logo = cardLogo(card.title);
            const link = caseLink(card.title);
            return (
              <div class="ip">
                {logo && <div class="ip-media"><img src={logo.src} alt={logo.alt} loading="lazy"></div>}
                <div class="ip-row">
                  <div>
                    {label && <div class="ip-label">{label}</div>}
                    <div class="ip-name">{name}</div>
                  </div>
                </div>
                {card.situation && <><span class="ip-field-label">Situación</span><p class="ip-desc">{card.situation}</p></>}
                {card.action && <><span class="ip-field-label">Acción</span><p class="ip-desc">{card.action}</p></>}
                {card.results.length > 0 && (
                  <>
                    <span class="ip-field-label">Resultados</span>
                    <ul class="svc-list">
                      {card.results.map((result) => <li class="svc-item">{result}</li>)}
                    </ul>
                  </>
                )}
                {link && <a href={link} class="ip-case-btn">Ver caso completo →</a>}
              </div>
            );
          })}
        </div>
      </>
    )}

    {evidenceStages.length > 0 && (
      <div class="pipeline-creative" data-reveal style="--delay:.4s">
        {evidenceStages.map((stage, i) => (
          <div class={`pc-step${i === evidenceStages.length - 1 ? ' is-outcome' : ''}`}>
            <div class="pc-bar" style={`height:${stageBarHeight(i, evidenceStages.length)}`}>{i + 1}</div>
            <div class="pc-label">{stage}</div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>

<!-- S5 CÓMO TRABAJO -->
<section class="section" id={SECTION_IDS.S5}>
  <div class="section-inner">
    <div class="section-label" data-reveal>{workLabel}</div>
    <h2 class="section-title" data-reveal style="--delay:.06s">{workHeadline}</h2>
    {workIntro.map((p) => <p class="section-sub" data-reveal>{p}</p>)}

    {workSteps.length > 0 && (
      <div class="accordion-wrap" data-reveal style="--delay:.18s">
        <div class="accordion-list" id="accList">
          {workSteps.map((step, i) => {
            const [n, ...titleParts] = step.title.split('·');
            const title = titleParts.join('·').trim() || step.title;
            return (
              <div class={`acc-item${i === 0 ? ' is-active' : ''}`} data-n={n.trim()} data-t={title}>
                <button type="button" class="acc-item-head">
                  <span class="acc-item-n">{n.trim()}</span>
                  <span class="acc-item-t">{title}</span>
                </button>
                <div class="acc-detail">
                  <div class="acc-d">{step.paragraphs[0]}</div>
                </div>
              </div>
            );
          })}
        </div>
        <div class="acc-panel" id="accPanel">
          <div class="acc-panel-n">{workSteps[0]?.title.split('·')[0]?.trim()}</div>
          <div class="acc-panel-t">{workSteps[0]?.title.split('·').slice(1).join('·').trim()}</div>
          <div class="acc-panel-d">{workSteps[0]?.paragraphs[0]}</div>
          <div class="acc-pips">
            {workSteps.map((_, i) => <span class={`acc-pip${i === 0 ? ' is-active' : ''}`}></span>)}
          </div>
        </div>
      </div>
    )}

    <h3 class="deliver-heading">Lo que entrego</h3>
    {deliverIntro.map((p) => <p class="section-sub">{p}</p>)}
    {deliverItems.length > 0 && (
      <div class="about-roles">
        {deliverItems.map((item) => (
          <div class="about-role">
            <div class="about-role-dot"></div>
            <div class="about-role-txt">{item}</div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>

<!-- S6 SISTEMAS PROPIOS -->
<section class="section" id={SECTION_IDS.S6}>
  <div class="section-inner">
    <div class="section-label" data-reveal>{systemsLabel}</div>
    <h2 class="section-title" data-reveal style="--delay:.06s">{systemsHeadline}</h2>
    {systemsIntro.map((p) => <p class="section-sub" data-reveal>{p}</p>)}

    {systemsCards.length > 0 && (
      <div class="ip-grid" data-reveal style="--delay:.18s">
        {systemsCards.map((card) => {
          const logo = cardLogo(card.title);
          const link = systemsCaseLink(card.title);
          return (
            <div class="ip">
              {logo && <div class="ip-media"><img src={logo.src} alt={logo.alt} loading="lazy"></div>}
              <div class="ip-row">
                <div class="ip-name">{card.title}</div>
              </div>
              {card.paragraphs.map((p) => <p class="ip-desc">{p}</p>)}
              {link && <a href={link} class="ip-case-link">Ver caso completo →</a>}
            </div>
          );
        })}
      </div>
    )}

    <div style="margin-top:56px;padding-top:40px;border-top:1px solid var(--border)">
      <h3 class="deliver-heading" style="margin-top:0">{systemsClosingHeading}</h3>
      {systemsClosing.map((p) => <p class="section-sub">{p}</p>)}
    </div>
  </div>
</section>

<!-- S6b PRUEBA SOCIAL -->
<section class="section" id={SECTION_IDS.S6b}>
  <div class="section-inner">
    <div class="section-label" data-reveal>{testimonialsLabel}</div>
    <h2 class="section-title" data-reveal style="--delay:.06s">{testimonialsHeadline}</h2>
    {testimonialsIntro.map((p) => <p class="section-sub" data-reveal>{p}</p>)}

    {testimonialItems.length > 0 && (
      <div class="testimonial-grid">
        {testimonialItems.map((item, i) => (
          <blockquote class="testimonial-card" data-reveal style={`--delay:${0.18 + i * 0.06}s`}>
            <p class="testimonial-quote">{item.quote}</p>
            <footer class="testimonial-cite">
              <span class="testimonial-name">{item.name}</span>
              {item.roleLines.map((line) => <span class="testimonial-role">{line}</span>)}
            </footer>
          </blockquote>
        ))}
      </div>
    )}
  </div>
</section>

<!-- S7 COLABOREMOS -->
<section class="section" id={SECTION_IDS.S7}>
  <div class="section-inner">
    <div class="section-label" data-reveal>{talkLabel}</div>
    <h2 class="section-title" data-reveal style="--delay:.06s">{talkHeadline}</h2>
    {talkIntro.map((p) => <p class="section-sub" data-reveal>{p}</p>)}

    <div class="conversemos-grid" data-reveal style="--delay:.18s">
      {talkTopics.length > 0 && (
        <div>
          {talkTopicsHeading && <h3 class="section-title" style="font-size:1.2rem;margin-bottom:20px">{talkTopicsHeading}</h3>}
          <div class="about-roles">
            {talkTopics.map((topic) => (
              <div class="about-role">
                <div class="about-role-dot"></div>
                <div class="about-role-txt">{topic}</div>
              </div>
            ))}
          </div>
        </div>
      )}
      <div class="conversemos-media">
        <img src={slotSrc('foto-diego', '/cms-media/diego/diegomaurypng.png')} alt={heroName || 'Diego Maury'} loading="lazy" width="700" height="875">
      </div>
    </div>

    {hiringText && (
      <div class="svc-argument" data-reveal style="--delay:.24s">
        <p>{hiringText}</p>
        {hiringCtas.length > 0 && (
          <div class="hero-ctas" style="margin-top:20px;margin-bottom:0">
            {hiringCtas.map((label, i) => {
              const t = ctaTarget(label);
              return (
                <a
                  href={t.href}
                  class={i === 0 ? 'btn-primary' : 'btn-ghost'}
                  download={t.download}
                  target={t.external ? '_blank' : undefined}
                  rel={t.external ? 'noopener' : undefined}
                >{label}</a>
              );
            })}
          </div>
        )}
      </div>
    )}

    <div class="talk__agenda">
      <h3>{agendaHeading}</h3>
      {agendaIntro.map((p) => <p class="section-sub">{p}</p>)}
      {(() => {
        const t = ctaTarget(agendaCtaLabel);
        return (
          <a
            href={t.href}
            class="btn-primary"
            download={t.download}
            target={t.external ? '_blank' : undefined}
            rel={t.external ? 'noopener' : undefined}
          >{agendaCtaLabel}</a>
        );
      })()}
      {talkAltLinks.length > 0 && (
        <div class="talk__alt">
          {talkAltLinks.map((label, i) => {
            const t = ctaTarget(label);
            return (
              <span class="talk__alt-item">
                {i > 0 && <span class="talk__sep">o</span>}
                <a href={t.href} class="inline-link" target={t.external ? '_blank' : undefined} rel={t.external ? 'noopener' : undefined}>{label}</a>
              </span>
            );
          })}
        </div>
      )}
    </div>
  </div>
</section>

{finalHeadline && (
  <section class="section cta-section" id={SECTION_IDS.S8}>
    <div class="section-inner cta-inner">
      <div class="cta-label-center" data-reveal>{finalLabel}</div>
      <h2 class="cta-h" data-reveal style="--delay:.06s">{finalHeadline}</h2>
      {finalIntro.map((p) => <p class="cta-sub" data-reveal>{p}</p>)}

      {finalSteps.length > 0 && (
        <div class="cta-steps" data-reveal style="--delay:.18s">
          {finalSteps.map((step) => (
            <div class="cta-step">
              <div class="cta-step-n">{step.title}</div>
              {step.description && <div class="cta-step-d">{step.description}</div>}
              {step.tag && <div class="cta-step-tag">{step.tag}</div>}
            </div>
          ))}
        </div>
      )}

      <div class="cta-buttons" data-reveal style="--delay:.24s">
        {finalCtas.length > 0 && (
          <div class="hero-ctas" style="justify-content:center;margin-bottom:0">
            {finalCtas.map((label, i) => {
              const t = ctaTarget(label);
              return (
                <a
                  href={t.href}
                  class={i === 0 ? 'btn-primary' : 'btn-ghost'}
                  download={t.download}
                  target={t.external ? '_blank' : undefined}
                  rel={t.external ? 'noopener' : undefined}
                >{label}</a>
              );
            })}
          </div>
        )}
        {finalTrustParts.length > 0 && (
          <div class="cta-trust">
            {finalTrustParts.map((part, i) => (
              <>
                {i > 0 && <span class="dot"></span>}
                <span>{part}</span>
              </>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>
)}

<footer>
  <div class="footer-grid">
    <div>
      <div class="footer-brand">
        <img src="/assets/img/isotipo-ember.svg" width="24" height="24" alt="">
        <span class="footer-name">{footerBrandName}</span>
      </div>
      {footerTagline && <p class="footer-tagline">{footerTagline}</p>}
    </div>
    {exploreItems.length > 0 && (
      <div class="footer-col">
        <div class="footer-col-title">Explora</div>
        {exploreItems.map((item) => (
          EXPLORE_HREF[item]
            ? <a href={EXPLORE_HREF[item]} target={EXPLORE_HREF[item].startsWith('http') ? '_blank' : undefined} rel={EXPLORE_HREF[item].startsWith('http') ? 'noopener' : undefined}>{item}</a>
            : <span>{item}</span>
        ))}
      </div>
    )}
    {contactItems.length > 0 && (
      <div class="footer-col">
        <div class="footer-col-title">Contacto</div>
        {contactItems.map((item) => (
          CONTACT_ITEM_HREF[item]
            ? <a href={CONTACT_ITEM_HREF[item]} target={CONTACT_ITEM_HREF[item].startsWith('http') ? '_blank' : undefined} rel={CONTACT_ITEM_HREF[item].startsWith('http') ? 'noopener' : undefined}>{item}</a>
            : <span>{item}</span>
        ))}
      </div>
    )}
  </div>
  <div class="footer-legal-row">
    <p class="footer-copy">{copyrightLine}</p>
  </div>
</footer>

<script>
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Nav: fondo solido al hacer scroll + link activo por seccion visible ──
  const navEl = document.getElementById('nav');
  const navLinks = document.querySelectorAll('.nav__link[href^="#"]');
  const navSections = [...navLinks]
    .map((link) => document.querySelector(link.getAttribute('href') ?? ''))
    .filter((el): el is Element => el !== null);

  window.addEventListener('scroll', () => {
    navEl?.classList.toggle('is-scrolled', window.scrollY > 8);
  }, { passive: true });

  if (navSections.length > 0) {
    const sectionObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        navLinks.forEach((link) => {
          link.classList.toggle('is-active', link.getAttribute('href') === `#${entry.target.id}`);
        });
      });
    }, { rootMargin: '-40% 0px -55% 0px' });
    navSections.forEach((section) => sectionObserver.observe(section));
  }

  // ── Nav: menu movil (burger) ──
  const navBurger = document.getElementById('navBurger');
  const navLinksWrap = document.getElementById('navLinks');
  navBurger?.addEventListener('click', () => {
    const isOpen = navLinksWrap?.classList.toggle('is-open') ?? false;
    navBurger.setAttribute('aria-expanded', String(isOpen));
    navBurger.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
  });
  navLinksWrap?.querySelectorAll('.nav__link').forEach((link) => {
    link.addEventListener('click', () => {
      navLinksWrap.classList.remove('is-open');
      navBurger?.setAttribute('aria-expanded', 'false');
    });
  });

  // ── Scroll reveal ──
  if (!prefersReduced) {
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -60px 0px', threshold: 0.08 });
    document.querySelectorAll('[data-reveal]').forEach((el) => revealObserver.observe(el));
  } else {
    document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-visible'));
  }

  // ── Acordeon "Como trabajo" ──
  const accItems = document.querySelectorAll('.acc-item');
  const accPanelN = document.getElementById('accPanel')?.querySelector('.acc-panel-n');
  const accPanelT = document.getElementById('accPanel')?.querySelector('.acc-panel-t');
  const accPanelD = document.getElementById('accPanel')?.querySelector('.acc-panel-d');
  const accPips = document.querySelectorAll('.acc-pip');

  accItems.forEach((item, idx) => {
    const head = item.querySelector('.acc-item-head');
    head?.addEventListener('click', () => {
      accItems.forEach((other) => other.classList.remove('is-active'));
      item.classList.add('is-active');

      if (accPanelN) accPanelN.textContent = (item as HTMLElement).dataset.n ?? '';
      if (accPanelT) accPanelT.textContent = (item as HTMLElement).dataset.t ?? '';
      if (accPanelD) accPanelD.textContent = item.querySelector('.acc-d')?.textContent ?? '';
      accPips.forEach((pip, pIdx) => pip.classList.toggle('is-active', pIdx === idx));
    });
  });

  // ── Contadores de metricas ──
  if (!prefersReduced) {
    const countEls = document.querySelectorAll('[data-count]');
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

    function animateCount(el: Element) {
      const target = parseInt((el as HTMLElement).dataset.count ?? '0', 10);
      const duration = 1400;
      const start = performance.now();

      function frame(now: number) {
        const elapsed = now - start;
        const progress = Math.min(elapsed / duration, 1);
        const value = Math.round(easeOut(progress) * target);
        el.textContent = value.toLocaleString('es-MX');
        if (progress < 1) requestAnimationFrame(frame);
      }

      requestAnimationFrame(frame);
    }

    const counterObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animateCount(entry.target);
          counterObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });

    countEls.forEach((el) => counterObserver.observe(el));
  }
</script>

</body>
</html>

