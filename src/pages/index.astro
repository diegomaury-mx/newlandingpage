---
// Home real del sitio, construido desde el CMS de Notion (Diego CMS —
// tarea "CMS: construir Home desde fuentes de Notion"). Lee el singleton
// `siteCopy` (pagina "Copy Oficial · diegomaury.mx (SSOT)", columna
// "Version Actual") y parsea sus secciones S1-S8 con parseSiteCopy.ts.
//
// Cuarto corte (2026-07-24): port de markup + CSS de componentes reales
// desde index.html (referencia visual del DS V2 "Ember on Ink" construida a
// mano antes de la migracion a Astro) sobre esta misma logica dinamica de
// Notion. index.html queda como referencia muerta para LIVE (ver CLAUDE.md);
// esta pagina es ahora la unica fuente de verdad visual + de contenido.
// S7b Confianza directa se sigue omitiendo a proposito: su copy declara "sin
// copy propio, lo resuelve el widget" (Senja), pendiente de activar.
//
// Sigue construyendo a dist/, no toca el sitio LIVE (astro.config.mjs).
import { getCollection } from 'astro:content';
import {
  parseSiteCopySections,
  heading1,
  heading2,
  paragraphs,
  ctaLabels,
  valueAfter,
  blocksBeforeHeading,
  blocksAfterHeading,
  bulletItems,
  headingCards,
  testimonials,
  caseCards,
  firstTable,
  firstCodeBlock,
  parseFlowDiagram,
} from '../utils/parseSiteCopy.ts';

const siteCopyEntries = await getCollection('siteCopy');
const siteCopy = siteCopyEntries.find((entry) => entry.id === 'site');
const sections = siteCopy ? parseSiteCopySections(siteCopy.data.markdown) : new Map();

const metricsEntries = await getCollection('metrics');
const incmtyMetric = metricsEntries.find((entry) => entry.id === 'incmty-participantes-inscritos');

// --- CMS Imagenes (base "🖼️ CMS Imágenes — Portafolio D") --------------------
// Slots hoy editables desde Notion (foto de Diego, logos de trust bar). Un
// slot sin archivo publicado (status !== 'Listo' o sin imageUrl) cae al
// fallback hardcodeado actual, para no romper el sitio mientras se migra
// contenido caso por caso.
const imageSlotEntries = await getCollection('imageSlots');
function slotSrc(slotId: string, fallback: string): string {
  const entry = imageSlotEntries.find((e) => e.id === slotId);
  return entry?.data.status === 'Listo' && entry.data.imageUrl ? entry.data.imageUrl : fallback;
}

// --- Identidad interna de las secciones ---------------------------------------
// Los ids/anclas usan el CODIGO INTERNO del SSOT (S1..S8), no el titulo
// visible. Diego renombra secciones en Notion ("Hablemos" -> "Colaboremos" en
// el pivote del 2026-07-24) y un ancla derivada del titulo se rompe en cada
// renombre. El codigo interno es estable; la etiqueta visible del nav se lee
// del SSOT en cada build.
const SECTION_IDS = {
  S1: 's1-hero',
  S2: 's2-quien-soy',
  S3: 's3-problema',
  S4: 's4-evidencia',
  S5: 's5-como-trabajo',
  S6: 's6-sistemas-propios',
  S6b: 's6b-prueba-social',
  S7: 's7-colaboremos',
  S8: 's8-siguiente-paso',
} as const;

/** Items del nav: codigo interno fijo + etiqueta viva del SSOT. */
const NAV_KEYS = ['S2', 'S3', 'S4', 'S5', 'S6', 'S7'] as const;
const navItems = NAV_KEYS.filter((key) => sections.has(key)).map((key) => ({
  href: `#${SECTION_IDS[key]}`,
  label: sections.get(key)!.label,
}));

// --- S1 · Hero ---------------------------------------------------------------
const s1 = sections.get('S1')?.blocks ?? [];
const heroName = heading1(s1);
const heroHeadline =
  heading2(s1) ||
  `${heroName} — Diseño programas, procesos y sistemas para convertir la visión en resultados tangibles.`;
// Acento ember sobre la frase de cierre, igual al tratamiento del H1 en el sitio LIVE.
const HERO_ACCENT_PHRASE = 'resultados tangibles';
const heroAccentIndex = heroHeadline.toLowerCase().indexOf(HERO_ACCENT_PHRASE);
const heroHeadlineBefore = heroAccentIndex >= 0 ? heroHeadline.slice(0, heroAccentIndex) : heroHeadline;
const heroHeadlineAccent = heroAccentIndex >= 0 ? heroHeadline.slice(heroAccentIndex, heroAccentIndex + HERO_ACCENT_PHRASE.length) : '';
const heroHeadlineAfter = heroAccentIndex >= 0 ? heroHeadline.slice(heroAccentIndex + HERO_ACCENT_PHRASE.length) : '';
const heroParas = paragraphs(s1);
const heroRole = heroParas[0] ?? '';
const heroSub = heroParas[1] ?? '';
const heroCtas = ctaLabels(s1);
const heroLogosLine = heroParas[3] ?? '';
const heroLogoNames = heroLogosLine.replace(/^Logos sugeridos:\s*/i, '').split('·').map((s) => s.trim()).filter(Boolean);

const LOGO_MAP: Record<string, { src: string; alt: string }> = {
  HEINEKEN: { src: slotSrc('logo-heineken', '/cms-media/logos/heineken-mexico-logo-png_seeklogo-370450.png'), alt: 'HEINEKEN Mexico' },
  'Tecnológico de Monterrey': { src: slotSrc('logo-tec-de-monterrey', '/cms-media/logos/tec%20de%20monterrey.png'), alt: 'Tecnológico de Monterrey' },
  INCmty: { src: slotSrc('logo-incmty', '/cms-media/logos/incmty.png'), alt: 'INCmty' },
  EBC: { src: slotSrc('logo-ebc', '/cms-media/logos/EBC.png'), alt: 'EBC' },
  FlipHouse: { src: slotSrc('logo-fliphouse', '/cms-media/logos/Fliphouse_logo1.png'), alt: 'FlipHouse' },
};
const heroLogos = heroLogoNames.map((name) => LOGO_MAP[name]).filter(Boolean);

// Badge de logo por tarjeta (Evidencia, Sistemas propios): solo donde el
// nombre del cliente sigue siendo publico en el copy. PropTech/SOFI se
// generalizaron a proposito (anonimizacion del cliente real) y no llevan
// logo, para no des-anonimizarlos visualmente.
function cardLogo(title: string): { src: string; alt: string } | null {
  if (/heineken/i.test(title)) return LOGO_MAP.HEINEKEN;
  // Solo REDUX (institucionalizado en el Tec de Monterrey per copy S6), no
  // HackSureste Ops: esa es marca propia de Diego, sin logo de cliente.
  if (/redux/i.test(title)) return LOGO_MAP['Tecnológico de Monterrey'];
  return null;
}

// --- S2 · Quien soy ------------------------------------------------------------
const s2 = sections.get('S2')?.blocks ?? [];
const aboutHeadline = heading2(s2);
const aboutParas = paragraphs(s2);
const aboutTagline = aboutParas[0] ?? '';
const aboutIntro = aboutParas.slice(1, 4);
const aboutRoles = aboutParas.slice(4, 7);
const aboutBio = aboutParas[7] ?? '';
const aboutStatsLine = aboutParas[8] ?? '';
const aboutStatsRaw = aboutStatsLine.split('•').map((s) => s.trim()).filter(Boolean);
// Sub-labels ya publicados en el sitio LIVE (index.html, .metric-s) — no son
// cifras nuevas, se reusan tal cual. El 3er stat ademas trae animacion
// count-up, igual que en LIVE, usando el valor real de la coleccion `metrics`.
const STAT_SUBLABELS = [
  'Trayectoria acumulada, cifra propia',
  '7+ en innovación y ecosistemas',
  incmtyMetric?.data.mandatoryQualifier || 'Agregado de programas INCmty (HGC incluido), estimado',
];
const aboutStats = aboutStatsRaw.map((raw, i) => {
  const match = raw.match(/^([\d.,]+\+?)\s*(.+)$/);
  const n = match ? match[1] : raw;
  const l = match ? match[2] : '';
  const countTo = i === 2 ? (incmtyMetric?.data.value ?? n).replace(/\D/g, '') : '';
  return { n, l, s: STAT_SUBLABELS[i] ?? '', countTo };
});

// --- S3 · El problema que resuelvo ---------------------------------------------
const s3 = sections.get('S3')?.blocks ?? [];
const problemLabel = sections.get('S3')?.label ?? 'El problema que resuelvo';
const problemHeadline = heading2(s3);
// Excluye tambien etiquetas sueltas del diagrama ASCII de "Asi trabajo"
// (ej. "TRADUZCO EN"): nunca aparece prosa en mayusculas en esta seccion.
const problemParas = paragraphs(s3).filter(
  (p) => !p.includes('\n') && !p.startsWith('┌') && p !== p.toUpperCase(),
);
const problemQuote = s3.find((b: string) => b.trim().startsWith('>'))?.trim().slice(1).trim() ?? '';
const problemDiagram = parseFlowDiagram(firstCodeBlock(s3));

// --- S4 · Evidencia ------------------------------------------------------------
const s4 = sections.get('S4')?.blocks ?? [];
const evidenceLabel = sections.get('S4')?.label ?? 'Evidencia';
const evidenceHeadline = heading1(s4);
const evidenceIntro = paragraphs(blocksBeforeHeading(s4, ['# Casos destacados']));
const evidenceCards = caseCards(s4);

// Slugs reales de la coleccion `cases` (verificados contra el build de
// portfolio/[slug].astro). El copy anonimiza "PropTech" en vez de nombrar
// FlipHouse, pero el caso real detras de esa tarjeta es SOFI.
function caseLink(title: string): string | null {
  const key = title.toLowerCase();
  if (key.includes('proptech')) return '/portfolio/sofi';
  if (key.includes('heineken')) return '/portfolio/heineken-green-challenge';
  if (key.includes('hacksureste')) return '/portfolio/hacksureste';
  return null;
}

// El componente real del DS (.ip, ver index.html "Casos destacados"/"Sistemas
// propios") separa una etiqueta de categoria (ip-label) del nombre del
// entregable (ip-name). El copy de Notion sigue el mismo patron "Categoria ·
// Nombre" que ya usa workSteps() para "01 · Definir el destino": se reutiliza
// el mismo split, nunca se inventa la etiqueta.
function splitIpTitle(title: string): { label: string; name: string } {
  const parts = title.split('·');
  if (parts.length > 1) {
    return { label: parts[0].trim(), name: parts.slice(1).join('·').trim() };
  }
  return { label: '', name: title.trim() };
}

// "111 ideas validadas en una sola edicion" no esta en el SSOT de metricas
// (assets/data/metrics.json): no se puede verificar ni publicar per el SOP
// de metricas, asi que se retira del render aunque siga en el copy de
// Notion (pendiente de correccion en la fuente, ver spec 2026-07-24).
const UNVERIFIED_METRIC_FRAGMENTS = [' · 111 ideas validadas en una sola edición'];
function stripUnverifiedMetrics(cell: string): string {
  return UNVERIFIED_METRIC_FRAGMENTS.reduce((acc, fragment) => acc.replace(fragment, ''), cell);
}
const rawEvidenceTable = firstTable(s4);
const evidenceTable = rawEvidenceTable && {
  ...rawEvidenceTable,
  rows: rawEvidenceTable.rows.map((row) => row.map(stripUnverifiedMetrics)),
};
// El diagrama pasa de bloque de texto (una etapa por linea, separadas por
// "↓") al componente real "pipeline-creative" (barras ascendentes, ver
// index.html S4): solo se necesitan los nombres de etapa, en orden. La
// altura de cada barra se calcula proporcional a su posicion (rampa
// generica), no son valores fijos como en el HTML de referencia porque el
// numero de etapas es dinamico segun el copy.
const evidenceStages = firstCodeBlock(s4)
  .split('\n')
  .map((line) => line.trim())
  .filter((line) => line && line !== '↓');
function stageBarHeight(index: number, total: number): string {
  const min = 44;
  const max = 118;
  const step = total > 1 ? (max - min) / (total - 1) : 0;
  return `${Math.round(min + step * index)}px`;
}
const evidenceStatLine = s4.find((b: string) => b.includes('proyectos documentados'))?.trim() ?? '';
const evidenceCtaLabel =
  s4
    .find((b: string) => b.toLowerCase().includes('explorar portafolio'))
    ?.replace(/→\s*/, '')
    .replace(/#portafolio\s*$/i, '')
    .trim() || 'Explorar portafolio completo';

// --- S5 · Como trabajo -----------------------------------------------------
const s5 = sections.get('S5')?.blocks ?? [];
const workLabel = sections.get('S5')?.label ?? 'Cómo trabajo';
const workHeadline = heading1(s5);
const workIntro = paragraphs(blocksBeforeHeading(s5, ['## Mi modelo de intervención']));
const afterModel = blocksAfterHeading(s5, '## Mi modelo de intervención');
const workSteps = headingCards(blocksBeforeHeading(afterModel, ['## Lo que entrego']), '### ');
const afterDeliver = blocksAfterHeading(s5, '## Lo que entrego');
const deliverIntro = paragraphs(afterDeliver);
const deliverItems = bulletItems(afterDeliver);

// --- S6 · Sistemas propios ---------------------------------------------------
const s6 = sections.get('S6')?.blocks ?? [];
const systemsLabel = sections.get('S6')?.label ?? 'Sistemas propios';
const systemsHeadline = heading1(s6);
const systemsIntro = paragraphs(blocksBeforeHeading(s6, ['## REDUX']));
const systemsCards = headingCards(blocksBeforeHeading(s6, ['## El verdadero entregable']), '## ');
const systemsClosingHeading =
  s6.find((b: string) => b.trim().startsWith('## El verdadero entregable'))?.trim().slice(3).trim() ??
  'El verdadero entregable';
const systemsClosing = paragraphs(blocksAfterHeading(s6, '## El verdadero entregable'));

// Los 3 sistemas propios (REDUX, HackSureste Ops, SOFI) enlazan a la pagina
// de caso real cuando existe. SOFI vive en la coleccion `cases` de Astro;
// REDUX y HackSureste Ops solo tienen ficha legacy estatica servida via
// public/portfolio/redux-incmty.html (ver CLAUDE.md, "Decisiones cerradas":
// portfolio/redux-incmty.html congelado por REM-005).
function systemsCaseLink(title: string): string | null {
  const key = title.toLowerCase();
  if (key.includes('sofi')) return '/portfolio/sofi';
  if (key.includes('redux') || key.includes('hacksureste')) return '/portfolio/redux-incmty.html';
  return null;
}

// --- S6b · Prueba social ------------------------------------------------------
const s6b = sections.get('S6b')?.blocks ?? [];
const testimonialsLabel = sections.get('S6b')?.label ?? 'Prueba social';
const testimonialsHeadline = heading1(s6b);
const testimonialsIntro = paragraphs(blocksBeforeHeading(s6b, ['>']));
const testimonialItems = testimonials(s6b);

// --- S7 · Colaboremos ---------------------------------------------------------
// Los headings de esta seccion los renombra Diego en el SSOT (el pivote del
// 2026-07-24 cambio "En una primera conversacion" -> "Temas en los que puedo
// aportar" y "Agenda una conversacion" -> "Conversemos"). Se localizan por
// nivel y posicion, nunca por su texto literal.
const s7 = sections.get('S7')?.blocks ?? [];
const talkLabel = sections.get('S7')?.label ?? 'Colaboremos';
const talkHeadline = heading1(s7);
const talkIntro = paragraphs(blocksBeforeHeading(s7, ['### ', '## ']));
const talkTopicsHeading = s7.find((b: string) => b.trim().startsWith('### '))?.trim().slice(4).trim() ?? '';
const talkTopics = bulletItems(s7);

// Bloque "Estas contratando?": parrafo protagonista + su par de CTAs.
const hiringIndex = s7.findIndex((b: string) => b.trim().startsWith('¿Estás contratando?'));
const hiringText = hiringIndex >= 0 ? s7[hiringIndex].trim() : '';
const hiringCtas = hiringIndex >= 0 ? ctaLabels(s7.slice(hiringIndex + 1)) : [];

// Sub-bloque de agenda: ultimo heading_2 de la seccion.
const agendaHeadingBlock = [...s7].reverse().find((b) => b.trim().startsWith('## '));
const agendaHeading = agendaHeadingBlock?.trim().slice(3).trim() ?? 'Conversemos';
const afterAgenda = agendaHeadingBlock ? blocksAfterHeading(s7, agendaHeadingBlock.trim()) : [];
const talkAltLine = afterAgenda.find((b) => b.toLowerCase().includes('envíame un correo'))?.trim() ?? '';
const talkAltLinks = talkAltLine.split('·').map((s) => s.trim()).filter(Boolean);
// paragraphs() no filtra el separador "o" ni la linea de links alternos (no son
// bullets/headings/etc.): se excluyen aparte para no duplicarlos como texto plano.
const agendaIntro = paragraphs(afterAgenda).filter((p) => p !== 'o' && p !== talkAltLine);
const agendaCtaLabel = ctaLabels(afterAgenda)[0] || 'Agendar conversación (30 min)';

// --- Destinos de CTA ----------------------------------------------------------
// Se resuelven por la ETIQUETA del boton, nunca por su posicion: el SSOT
// reordena y renombra CTAs (el pivote del 2026-07-24 cambio el primario del
// hero de "Agendar diagnostico" a "Ver casos de estudio") y un mapeo
// posicional mandaria "Ver casos de estudio" a Calendly.
const CV_HREF = '/cv/diego-maury-cv.pdf';
const LINKEDIN_HREF = 'https://www.linkedin.com/in/diegomaury';
const MAIL_HREF = 'mailto:dm@diegomaury.mx';
const CALENDAR_HREF = 'https://calendar.notion.so/meet/diegomaurymx/5aad3vun';

interface CtaTarget {
  href: string;
  download?: boolean;
  external?: boolean;
}

function ctaTarget(label: string): CtaTarget {
  const l = label.toLowerCase();
  if (l.includes('caso') || l.includes('portafolio')) return { href: `#${SECTION_IDS.S4}` };
  if (l.includes('cv')) return { href: CV_HREF, download: true };
  if (l.includes('linkedin')) return { href: LINKEDIN_HREF, external: true };
  if (l.includes('correo')) return { href: MAIL_HREF };
  return { href: CALENDAR_HREF, external: true };
}

// --- S8 · Siguiente paso -------------------------------------------------------
// Recuperada 2026-07-24 (spec docs/superpowers/specs/2026-07-24-recuperar-s8-y-cifras-s6.md):
// no existia en el primer corte, Diego la pego en Notion despues.
const s8 = sections.get('S8')?.blocks ?? [];
const finalLabel = sections.get('S8')?.label ?? 'Siguiente paso';
const finalHeadline = heading2(s8);
const finalIntro = paragraphs(blocksBeforeHeading(s8, ['### ']));
const finalStepCards = headingCards(s8, '### ');
const finalSteps = finalStepCards.map((card) => ({
  title: card.title,
  description: card.paragraphs[0] ?? '',
  tag: card.paragraphs[1] ?? '',
}));
const afterSteps = finalStepCards.length
  ? blocksAfterHeading(s8, `### ${finalStepCards[finalStepCards.length - 1].title}`)
  : [];
const finalCtas = ctaLabels(afterSteps);
const finalTrustLine = afterSteps.find((b) => b.includes('·') && !ctaLabels([b]).length)?.trim() ?? '';
const finalTrustParts = finalTrustLine.split('·').map((s) => s.trim()).filter(Boolean);

// --- SEO -------------------------------------------------------------------
const seo = sections.get('SEO')?.blocks ?? [];
const pageTitle = valueAfter(seo, 'Title') || 'Diego Maury · Strategic Program Director';
const pageDescription =
  valueAfter(seo, 'Meta description') ||
  'Strategic Program Director: diseño programas, procesos y sistemas que convierten la estrategia en ejecución y capacidad organizacional.';

// --- Footer ------------------------------------------------------------------
// El heading "## Footer" no matchea SECTION_HEADING (necesita "# Sn ·"), asi
// que su contenido queda dentro de los blocks de la seccion SEO: se extrae
// manualmente a partir de ese heading.
const footerBlocks = blocksAfterHeading(seo, '## Footer');
const beforeExplore = blocksBeforeHeading(footerBlocks, ['### Explora']);
const footerBrandName = heading2(beforeExplore) || 'Diego Maury';
const footerTagline = paragraphs(beforeExplore)[0] ?? '';
const exploreItems = bulletItems(blocksBeforeHeading(blocksAfterHeading(footerBlocks, '### Explora'), ['### Contacto']));
const afterContacto = blocksAfterHeading(footerBlocks, '### Contacto');
const contactParagraphs = paragraphs(afterContacto);
const contactItems = contactParagraphs.filter((p) => !p.startsWith('©'));
const copyrightLine = contactParagraphs.find((p) => p.startsWith('©')) ?? '© 2026 Diego Maury. Todos los derechos reservados.';

const EXPLORE_HREF: Record<string, string> = {
  Portafolio: '/portfolio',
  'Casos de estudio': `#${SECTION_IDS.S4}`,
  'Sobre mí': `#${SECTION_IDS.S2}`,
  Newsletter: 'https://diegomaury.substack.com',
  LinkedIn: 'https://www.linkedin.com/in/diegomaury',
};
const CONTACT_ITEM_HREF: Record<string, string> = {
  'Correo electrónico': 'mailto:dm@diegomaury.mx',
  LinkedIn: 'https://www.linkedin.com/in/diegomaury',
  Calendly: 'https://calendar.notion.so/meet/diegomaurymx/5aad3vun',
};
---

