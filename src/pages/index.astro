---
// Home real del sitio, construido desde el CMS de Notion (Diego CMS —
// tarea "CMS: construir Home desde fuentes de Notion"). Lee el singleton
// `siteCopy` (pagina "Copy Oficial · diegomaury.mx (SSOT)", columna
// "Version Actual") y parsea sus secciones S1-S8 con parseSiteCopy.ts.
//
// Cuarto corte (2026-07-24): port de markup + CSS de componentes reales
// desde index.html (referencia visual del DS V2 "Ember on Ink" construida a
// mano antes de la migracion a Astro) sobre esta misma logica dinamica de
// Notion. index.html queda como referencia muerta para LIVE (ver CLAUDE.md);
// esta pagina es ahora la unica fuente de verdad visual + de contenido.
// S7 Colaboremos se retiro (2026-07-31): su contenido quedo absorbido por S6b
// (testimonios + widget Senja, ya activado via script al final del archivo) y
// S8 (CTA final). El nav "Contacto" apunta a S8, no a un ancla S7.
//
// Sigue construyendo a dist/, no toca el sitio LIVE (astro.config.mjs).
import { getCollection } from 'astro:content';
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/home.css";
import {
  parseSiteCopySections,
  heading1,
  heading2,
  paragraphs,
  ctaLabels,
  valueAfter,
  blocksBeforeHeading,
  blocksAfterHeading,
  bulletItems,
  headingCards,
  testimonials,
  firstCodeBlock,
  parseFlowDiagram,
} from '../utils/parseSiteCopy.ts';

const siteCopyEntries = await getCollection('siteCopy');
const siteCopy = siteCopyEntries.find((entry) => entry.id === 'site');
const sections = siteCopy ? parseSiteCopySections(siteCopy.data.markdown) : new Map();

const metricsEntries = await getCollection('metrics');
const incmtyMetric = metricsEntries.find((entry) => entry.id === 'incmty-participantes-inscritos');

// --- CMS Imagenes (base "🖼️ CMS Imágenes — Portafolio D") --------------------
// Slots hoy editables desde Notion (foto de Diego, logos de trust bar). Un
// slot sin archivo publicado (status !== 'Listo' o sin imageUrl) cae al
// fallback hardcodeado actual, para no romper el sitio mientras se migra
// contenido caso por caso.
const imageSlotEntries = await getCollection('imageSlots');
function slotSrc(slotId: string, fallback: string): string {
  const entry = imageSlotEntries.find((e) => e.id === slotId);
  return entry?.data.status === 'Listo' && entry.data.imageUrl ? entry.data.imageUrl : fallback;
}

// Slot del diagrama de S3 "El problema que resuelvo": sin archivo publicado en
// Notion (status !== 'Listo'), el sitio conserva el SVG dibujado a mano como
// fallback en vez de romper el layout.
const problemaDiagramaSlot = imageSlotEntries.find((e) => e.id === 'diagrama-problema');
const problemaDiagramaReady = Boolean(problemaDiagramaSlot?.data.status === 'Listo' && problemaDiagramaSlot.data.imageUrl);

// --- Identidad interna de las secciones ---------------------------------------
// Los ids/anclas usan el CODIGO INTERNO del SSOT (S1..S8), no el titulo
// visible. Diego renombra secciones en Notion ("Hablemos" -> "Colaboremos" en
// el pivote del 2026-07-24) y un ancla derivada del titulo se rompe en cada
// renombre. El codigo interno es estable; la etiqueta visible del nav se lee
// del SSOT en cada build.
const SECTION_IDS = {
  S1: 's1-hero',
  S2: 's2-quien-soy',
  S3: 's3-problema',
  S4: 's4-evidencia',
  S5: 's5-como-trabajo',
  S6: 's6-sistemas-propios',
  S6b: 's6b-prueba-social',
  S8: 's8-siguiente-paso',
} as const;

// --- S1 · Hero ---------------------------------------------------------------
const s1 = sections.get('S1')?.blocks ?? [];
const heroName = heading1(s1);
const heroHeadline =
  heading2(s1) ||
  `${heroName}. Diseño programas, procesos y sistemas para convertir la visión en resultados tangibles.`;
// Acento ember sobre la frase de cierre, igual al tratamiento del H1 en el sitio LIVE.
const HERO_ACCENT_PHRASE = 'resultados tangibles';
const heroAccentIndex = heroHeadline.toLowerCase().indexOf(HERO_ACCENT_PHRASE);
const heroHeadlineBefore = heroAccentIndex >= 0 ? heroHeadline.slice(0, heroAccentIndex) : heroHeadline;
const heroHeadlineAccent = heroAccentIndex >= 0 ? heroHeadline.slice(heroAccentIndex, heroAccentIndex + HERO_ACCENT_PHRASE.length) : '';
const heroHeadlineAfter = heroAccentIndex >= 0 ? heroHeadline.slice(heroAccentIndex + HERO_ACCENT_PHRASE.length) : '';
const heroParas = paragraphs(s1);
const heroRole = heroParas[0] ?? '';
const heroSub = heroParas[1] ?? '';
const heroCtas = ctaLabels(s1);
const heroLogosLine = heroParas[3] ?? '';
const heroLogoNames = heroLogosLine.replace(/^Logos sugeridos:\s*/i, '').split('·').map((s) => s.trim()).filter(Boolean);

// Fallbacks hardcodeados solo para los 4 logos originales (pre-CMS dinamico).
// Un logo nuevo agregado desde Notion no necesita fallback aqui: si su slot
// no esta "Listo" en CMS Imagenes, simplemente no se renderiza (ver
// resolveLogo) en vez de romper con una ruta que no existe.
const LOGO_FALLBACKS: Record<string, string> = {
  HEINEKEN: '/cms-media/logos/heineken-mexico-logo-png_seeklogo-370450.png',
  'Tecnológico de Monterrey': '/cms-media/logos/tec%20de%20monterrey.png',
  INCmty: '/cms-media/logos/incmty.png',
  EBC: '/cms-media/logos/EBC.png',
};

// FlipHouse deliberadamente bloqueado (2026-08-11): es el cliente real y
// confidencial detras del caso SOFI/PropTech. Mostrar su logo en el trust bar
// del home desanonimiza el caso al instante. No quitar este guardrail aunque
// "FlipHouse" siga apareciendo en la linea "Logos sugeridos" de Notion S1 —
// ese texto tambien debe corregirse (ver CLAUDE.md).
const BLOCKED_LOGO_NAMES = new Set(['flipHouse'.toLowerCase()]);

// El slot id de Notion es texto libre tecleado por Diego, no auto-generado —
// "Tecnológico de Monterrey" ya vive como `logo-tec-de-monterrey` (abreviado),
// no como el slug literal del nombre completo. Excepciones a la convencion
// por defecto van aqui para no romper filas ya creadas en CMS Imagenes.
const LOGO_SLOT_OVERRIDES: Record<string, string> = {
  'Tecnológico de Monterrey': 'logo-tec-de-monterrey',
};

function slugifyLogoName(name: string): string {
  return name
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-+|-+$)/g, '');
}

// Cinturon de logos 100% dinamico desde Notion (2026-08-13): agregar un logo
// nuevo ya no requiere tocar este archivo — solo (1) sumar el nombre a la
// linea "Logos sugeridos" en S1 y (2) crear su fila en CMS Imagenes con slot
// `logo-<nombre-slugificado>` (o la excepcion de LOGO_SLOT_OVERRIDES) en
// Estado "Listo". Un slot ausente o no listo se omite del cinturon en vez de
// mostrar una imagen rota.
function resolveLogo(name: string): { src: string; alt: string } | null {
  if (BLOCKED_LOGO_NAMES.has(name.toLowerCase())) return null;
  const slotId = LOGO_SLOT_OVERRIDES[name] ?? `logo-${slugifyLogoName(name)}`;
  const src = slotSrc(slotId, LOGO_FALLBACKS[name] ?? '');
  return src ? { src, alt: name } : null;
}
const heroLogos = heroLogoNames.map(resolveLogo).filter((logo): logo is { src: string; alt: string } => logo !== null);

function systemsLogo(title: string): { src: string; alt: string } | null {
  const key = title.toLowerCase();
  if (key.includes('redux')) return { src: slotSrc('ip-logo-redux','/assets/img/logos/redux.svg'), alt:'REDUX' };
  if (key.includes('hacksureste')) return { src: slotSrc('ip-logo-hacksureste','/assets/img/logos/hacksureste.svg'), alt:'HackSureste' };
  if (key.includes('sofi')) return { src: slotSrc('ip-logo-sofi','/assets/img/logos/sofi.svg'), alt:'SOFI' };
  return null;
}

// --- S2 · Quien soy ------------------------------------------------------------
const s2 = sections.get('S2')?.blocks ?? [];
const aboutHeadline = heading2(s2);
const aboutParas = paragraphs(s2);
const aboutTagline = aboutParas[0] ?? '';
const aboutIntro = aboutParas.slice(1, 4);
const aboutRoles = aboutParas.slice(4, 7);
const aboutBio = aboutParas[7] ?? '';
const aboutStatsLine = aboutParas[8] ?? '';
const aboutStatsRaw = aboutStatsLine.split('•').map((s) => s.trim()).filter(Boolean);
// Sub-labels ya publicados en el sitio LIVE (index.html, .metric-s) — no son
// cifras nuevas, se reusan tal cual. El 3er stat ademas trae animacion
// count-up, igual que en LIVE, usando el valor real de la coleccion `metrics`.
const STAT_SUBLABELS = [
  'Trayectoria acumulada, cifra propia',
  '7+ en innovación y ecosistemas',
  incmtyMetric?.data.mandatoryQualifier || 'Agregado de programas INCmty (HGC incluido), estimado',
];
const aboutStats = aboutStatsRaw.map((raw, i) => {
  const match = raw.match(/^([\d.,]+\+?)\s*(.+)$/);
  const n = match ? match[1] : raw;
  const l = match ? match[2] : '';
  const countTo = i === 2 ? (incmtyMetric?.data.value ?? n).replace(/\D/g, '') : '';
  return { n, l, s: STAT_SUBLABELS[i] ?? '', countTo };
});

// --- S3 · El problema que resuelvo ---------------------------------------------
const s3 = sections.get('S3')?.blocks ?? [];
const problemLabel = sections.get('S3')?.label ?? 'El problema que resuelvo';
const problemHeadline = heading2(s3);
// Excluye tambien etiquetas sueltas del diagrama ASCII de "Asi trabajo"
// (ej. "TRADUZCO EN"): nunca aparece prosa en mayusculas en esta seccion.
const problemParas = paragraphs(s3).filter(
  (p) => !p.includes('\n') && !p.startsWith('┌') && p !== p.toUpperCase(),
);
const problemQuote = s3.find((b: string) => b.trim().startsWith('>'))?.trim().slice(1).trim() ?? '';
const problemDiagram = parseFlowDiagram(firstCodeBlock(s3));

// --- S4 · Evidencia ------------------------------------------------------------
// Rediseño 2026-08-12 (instrucciones de Diego): la seccion deja de listar
// marcas/casos/metricas (eso vive en /portfolio y en las fichas de caso) y
// pasa a un diagrama radial que solo comunica amplitud de campos de
// aplicacion. Copy vuelve a salir del bloque S4 de Notion (Copy Oficial
// SSOT), con una estructura nueva: heading1 = titulo, primer parrafo =
// intro, "Centro" (bold) + valor = nodo central, bloque de codigo = un campo
// por linea, parrafo final = cierre. Mientras Diego no pegue este formato en
// Notion, s4 sigue teniendo el contenido viejo (tabla) y estos campos caen
// vacios — el render se protege abajo con guards de longitud.
const s4 = sections.get('S4')?.blocks ?? [];
const evidenceLabel = sections.get('S4')?.label ?? 'Evidencia';
const evidenceTitle = heading1(s4);
const evidenceIntroText = paragraphs(blocksBeforeHeading(s4, ['Centro']))[0] ?? '';
const evidenceCenterNode = valueAfter(s4, 'Centro');
const evidenceFieldLabels = firstCodeBlock(s4)
  .split('\n')
  .map((line) => line.trim())
  .filter(Boolean);
const afterFieldsFence = blocksAfterHeading(blocksAfterHeading(s4, '```'), '```');
const evidenceClosing = paragraphs(afterFieldsFence)[0] ?? '';

// Orden = orden de lectura mobile (el mismo orden en que Diego escribe las
// lineas en Notion). El mismo orden define la posicion en el radial desktop
// (i=0 arriba, avanzando en sentido horario), asi que un solo array gobierna
// las tres variantes responsive. La key es solo un hook tecnico para
// asociar cada campo con su linea/punto en el hover — no viene de Notion.
const EVIDENCE_FIELDS = evidenceFieldLabels.map((label, i) => ({ key: `field-${i}`, label }));

// Geometria del diagrama radial (solo desktop, >960px): nodos distribuidos
// a partes iguales alrededor de 360°, empezando arriba (-90°), en un sistema
// de coordenadas 0-100 que mapea 1:1 a porcentajes CSS sobre un contenedor
// cuadrado (aspect-ratio:1). Hibrido D+C (decision 2026-08-12): los campos
// son texto puro, sin caja ni fondo opaco, asi que a diferencia de la
// primera version SI hace falta un gap real entre el final de la linea y el
// texto — por eso el radio de la linea/punto terminal (EVIDENCE_DOT_RADIUS)
// queda notoriamente mas corto que el radio del texto (EVIDENCE_NODE_RADIUS).
const EVIDENCE_NODE_RADIUS = 40;
const EVIDENCE_DOT_RADIUS = 31;
// Medio ancho/alto (en el mismo sistema 0-100) de la caja del nodo central:
// el punto de arranque de cada linea se recorta al borde de esa caja en vez
// de partir del centro exacto (50,50), para que ninguna linea atraviese el
// texto "La misma metodologia. Distintas industrias."
const EVIDENCE_CENTER_HALF_WIDTH = 21;
const EVIDENCE_CENTER_HALF_HEIGHT = 11;
function evidencePoint(index: number, total: number, radius: number): { x: number; y: number } {
  const angle = ((-90 + index * (360 / total)) * Math.PI) / 180;
  return {
    x: Math.round((50 + radius * Math.cos(angle)) * 100) / 100,
    y: Math.round((50 + radius * Math.sin(angle)) * 100) / 100,
  };
}
function evidenceLineStart(index: number, total: number): { x: number; y: number } {
  const angle = ((-90 + index * (360 / total)) * Math.PI) / 180;
  const c = Math.cos(angle);
  const s = Math.sin(angle);
  const t = Math.min(
    Math.abs(c) > 1e-6 ? EVIDENCE_CENTER_HALF_WIDTH / Math.abs(c) : Infinity,
    Math.abs(s) > 1e-6 ? EVIDENCE_CENTER_HALF_HEIGHT / Math.abs(s) : Infinity,
  );
  return {
    x: Math.round((50 + t * c) * 100) / 100,
    y: Math.round((50 + t * s) * 100) / 100,
  };
}
const evidenceNodes = EVIDENCE_FIELDS.map((field, i) => ({
  ...field,
  node: evidencePoint(i, EVIDENCE_FIELDS.length, EVIDENCE_NODE_RADIUS),
  dot: evidencePoint(i, EVIDENCE_FIELDS.length, EVIDENCE_DOT_RADIUS),
  lineStart: evidenceLineStart(i, EVIDENCE_FIELDS.length),
}));

// --- S5 · Como trabajo -----------------------------------------------------
const s5 = sections.get('S5')?.blocks ?? [];
const workLabel = sections.get('S5')?.label ?? 'Cómo trabajo';
const workHeadline = heading1(s5);
const workIntro = paragraphs(blocksBeforeHeading(s5, ['## Mi modelo de intervención']));
const afterModel = blocksAfterHeading(s5, '## Mi modelo de intervención');
const workSteps = headingCards(blocksBeforeHeading(afterModel, ['## Lo que entrego']), '### ');
const afterDeliver = blocksAfterHeading(s5, '## Lo que entrego');
const deliverIntro = paragraphs(afterDeliver);
const deliverItems = bulletItems(afterDeliver);

// --- S6 · Sistemas propios ---------------------------------------------------
const s6 = sections.get('S6')?.blocks ?? [];
const systemsLabel = sections.get('S6')?.label ?? 'Sistemas propios';
const systemsHeadline = heading1(s6);
const systemsIntro = paragraphs(blocksBeforeHeading(s6, ['## REDUX']));
const systemsCards = headingCards(blocksBeforeHeading(s6, ['## El verdadero entregable']), '## ');
const systemsClosingHeading =
  s6.find((b: string) => b.trim().startsWith('## El verdadero entregable'))?.trim().slice(3).trim() ??
  'El verdadero entregable';
const systemsClosing = paragraphs(blocksAfterHeading(s6, '## El verdadero entregable'));

// Los 3 sistemas propios (REDUX, HackSureste Ops, SOFI) enlazan a la pagina
// de caso real cuando existe. SOFI vive en la coleccion `cases` de Astro;
// HackSureste Ops enlaza al caso real del CMS (/portfolio/hacksureste,
// decision 2026-08-13 que reemplaza el mapping legacy congelado por REM-005,
// obsoleto desde que ese caso se publico en el CMS). REDUX sigue sin ficha
// propia en el CMS, solo la legacy estatica public/portfolio/redux-incmty.html.
function systemsCaseLink(title: string): string | null {
  const key = title.toLowerCase();
  if (key.includes('sofi')) return '/portfolio/sofi';
  if (key.includes('hacksureste')) return '/portfolio/hacksureste';
  if (key.includes('redux')) return '/portfolio/redux-incmty.html';
  return null;
}

// --- S6b · Prueba social ------------------------------------------------------
const s6b = sections.get('S6b')?.blocks ?? [];
const testimonialsLabel = sections.get('S6b')?.label ?? 'Prueba social';
const testimonialsHeadline = heading1(s6b);
const testimonialsIntro = paragraphs(blocksBeforeHeading(s6b, ['>']));
const testimonialItems = testimonials(s6b);
const moreExperiencesHeading =
  s6b.find((b: string) => b.trim() === '## Más experiencias')
    ?.replace(/^##\s*/, '') ?? '';

const moreExperiences = blocksAfterHeading(s6b, '## Más experiencias');
const senjaId = moreExperiences[0]?.trim();

// --- Destinos de CTA ----------------------------------------------------------
// Se resuelven por la ETIQUETA del boton, nunca por su posicion: el SSOT
// reordena y renombra CTAs (el pivote del 2026-07-24 cambio el primario del
// hero de "Agendar diagnostico" a "Ver casos de estudio") y un mapeo
// posicional mandaria "Ver casos de estudio" a Calendly.
const CV_HREF = '/cv/diego-maury-cv.pdf';
const LINKEDIN_HREF = 'https://www.linkedin.com/in/diegomaury';
const MAIL_HREF = 'mailto:dm@diegomaury.mx';
const CALENDAR_HREF = 'https://calendar.notion.so/meet/diegomaurymx/5aad3vun';

interface CtaTarget {
  href: string;
  download?: boolean;
  external?: boolean;
}

function ctaTarget(label: string): CtaTarget {
  const l = label.toLowerCase();
  if (l.includes('caso') || l.includes('portafolio')) return { href: '/portfolio' };
  if (l.includes('cv')) return { href: CV_HREF, download: true };
  if (l.includes('linkedin')) return { href: LINKEDIN_HREF, external: true };
  if (l.includes('correo')) return { href: MAIL_HREF };
  return { href: CALENDAR_HREF, external: true };
}

// --- S8 · Siguiente paso -------------------------------------------------------
// Recuperada 2026-07-24 (spec docs/superpowers/specs/2026-07-24-recuperar-s8-y-cifras-s6.md):
// no existia en el primer corte, Diego la pego en Notion despues.
const s8 = sections.get('S8')?.blocks ?? [];
const finalLabel = sections.get('S8')?.label ?? 'Siguiente paso';
const finalHeadline = heading2(s8);
const finalIntro = paragraphs(blocksBeforeHeading(s8, ['### ']));
const finalStepCards = headingCards(s8, '### ');
const finalSteps = finalStepCards.map((card) => ({
  title: card.title,
  description: card.paragraphs[0] ?? '',
  tag: card.paragraphs[1] ?? '',
}));
const afterSteps = finalStepCards.length
  ? blocksAfterHeading(s8, `### ${finalStepCards[finalStepCards.length - 1].title}`)
  : [];
const finalCtas = ctaLabels(afterSteps);
const finalTrustLine = afterSteps.find((b) => b.includes('·') && !ctaLabels([b]).length)?.trim() ?? '';
const finalTrustParts = finalTrustLine.split('·').map((s) => s.trim()).filter(Boolean);

// --- SEO -------------------------------------------------------------------
const seo = sections.get('SEO')?.blocks ?? [];
const pageTitle = valueAfter(seo, 'Title') || 'Diego Maury · Strategic Program Director';
// "consultor" es un experimento paralelo en capa invisible (meta description +
// knowsAbout del JSON-LD), aprobado 2026-08-03: evaluar a 90 dias con Search
// Console; si el CTR de queries con "consultor" pierde contra las de rol
// ("director de programas"), se retira. El copy visible (S1-S8) no se toca.
const pageDescription =
  valueAfter(seo, 'Meta description') ||
  'Strategic Program Director y consultor de innovación: diseño programas y sistemas que convierten estrategia en ejecución.';
const canonicalUrl = new URL('/', Astro.site).toString();
const ogImage = new URL('/assets/img/diego-maury.png', Astro.site).toString();
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Diego Maury',
  url: 'https://diegomaury.mx',
  jobTitle: 'Strategic Program Director',
  sameAs: ['https://www.linkedin.com/in/diegomaury/'],
  knowsAbout: [
    'Dirección de programas de innovación',
    'RevOps',
    'Ecosistemas de emprendimiento en LATAM',
    'Consultoría de innovación',
  ],
};
---
<BaseLayout
  canonicalUrl={canonicalUrl}
  jsonLd={personJsonLd}
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImage}
>
<!-- Google Tag Manager -->
<script is:inline src="/js/gtm.js"></script>
<!-- End Google Tag Manager -->

<!-- S1 HERO -->
<section class="section" id={SECTION_IDS.S1}>
  <div class="section-inner">
    <div class="hero-grid">
      <div>
        <div class="hero-label" data-reveal>{heroRole || 'Strategic Program Director'}</div>
        <h1 class="hero-h1" data-reveal style="--delay:.08s">
          {heroHeadlineBefore}{heroHeadlineAccent && <span class="accent">{heroHeadlineAccent}</span>}{heroHeadlineAfter}
        </h1>
        {heroSub && <p class="hero-sub" data-reveal style="--delay:.14s">{heroSub}</p>}
        {heroCtas.length > 0 && (
          <div class="hero-ctas" data-reveal style="--delay:.2s">
            {heroCtas.map((label, i) => {
              const t = ctaTarget(label);
              return (
                <a
                  href={t.href}
                  class={i === 0 ? 'btn-primary' : 'btn-ghost'}
                  download={t.download}
                  target={t.external ? '_blank' : undefined}
                  rel={t.external ? 'noopener' : undefined}
                >{label}</a>
              );
            })}
          </div>
        )}
      </div>
      <div class="hero-media" data-reveal style="--delay:.1s">
        <img src={slotSrc('foto-diego-hero', '/cms-media/diego/diegomaurypng.png')} alt={heroName || 'Diego Maury'} loading="eager" fetchpriority="high" width="700" height="875">
      </div>
    </div>
    {heroLogos.length > 0 && (
      <div class="trust" data-reveal style="--delay:.32s">
        <div class="trust-label">He trabajado con</div>
        <div class="trust-track-wrap">
          <div class="trust-track">
            {heroLogos.map((logo) => <div class="trust-logo"><img src={logo.src} alt={logo.alt} loading="lazy"></div>)}
            {heroLogos.map((logo) => <div class="trust-logo" aria-hidden="true"><img src={logo.src} alt="" loading="lazy"></div>)}
          </div>
        </div>
      </div>
    )}
  </div>
</section>

<!-- S2 QUIEN SOY -->
<section class="about-section" id={SECTION_IDS.S2}>
  <div class="about-body">
    <div class="about-header" data-reveal>
      <div class="about-name">{heroName || 'Diego Maury'}</div>
      {heroRole && <div class="about-title-txt">{heroRole}</div>}
      {aboutTagline && <p class="about-tagline">{aboutTagline}</p>}
    </div>

    {aboutIntro.length > 0 && (
      <div class="about-intro-full" data-reveal style="--delay:.14s">
        {aboutIntro.map((p) => <p class="about-intro-p">{p}</p>)}
      </div>
    )}

    {aboutRoles.length > 0 && (
      <div class="about-roles" data-reveal style="--delay:.18s">
        {aboutRoles.map((role) => (
          <div class="about-role">
            <div class="about-role-dot"></div>
            <div class="about-role-txt">{role}</div>
          </div>
        ))}
      </div>
    )}

    <div class="about-photo-wrap" data-reveal style="--delay:.1s">
      <div class="about-circle-bg"></div>
      <div class="about-photo-slot">
        <img src={slotSrc('foto-diego-about', '/cms-media/diego/diegomaurypng.png')} width="700" height="700" alt={heroName || 'Diego Maury'} loading="lazy">
      </div>
    </div>

    <div class="about-right" data-reveal style="--delay:.22s">
      {aboutBio && <p class="about-bio">{aboutBio}</p>}
      {aboutHeadline && <p class="about-bio">{aboutHeadline}</p>}
