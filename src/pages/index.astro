            : <span>{item}</span>
        ))}
      </div>
    )}
  </div>
  <div class="wrap">
    <p class="site-footer__legal">{copyrightLine}</p>
  </div>
</footer>

<script>
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Nav: fondo solido al hacer scroll + link activo por seccion visible ──
  const navEl = document.getElementById('nav');
  const navLinks = document.querySelectorAll('.nav__link[href^="#"]');
  const navSections = [...navLinks]
    .map((link) => document.querySelector(link.getAttribute('href') ?? ''))
    .filter((el): el is Element => el !== null);

  window.addEventListener('scroll', () => {
    navEl?.classList.toggle('is-scrolled', window.scrollY > 8);
  }, { passive: true });

  if (navSections.length > 0) {
    const sectionObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        navLinks.forEach((link) => {
          link.classList.toggle('is-active', link.getAttribute('href') === `#${entry.target.id}`);
        });
      });
    }, { rootMargin: '-40% 0px -55% 0px' });
    navSections.forEach((section) => sectionObserver.observe(section));
  }

  // ── Nav: menu movil (burger) ──
  const navBurger = document.getElementById('navBurger');
  const navLinksWrap = document.getElementById('navLinks');
  navBurger?.addEventListener('click', () => {
    const isOpen = navLinksWrap?.classList.toggle('is-open') ?? false;
    navBurger.setAttribute('aria-expanded', String(isOpen));
    navBurger.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
  });
  navLinksWrap?.querySelectorAll('.nav__link, .nav__cta').forEach((link) => {
    link.addEventListener('click', () => {
      navLinksWrap.classList.remove('is-open');
      navBurger?.setAttribute('aria-expanded', 'false');
    });
  });

  // ── Acordeon "Como trabajo" ──
  const accItems = document.querySelectorAll('.acc-item');
  const accPanelN = document.getElementById('accPanel')?.querySelector('.acc-panel-n');
  const accPanelT = document.getElementById('accPanel')?.querySelector('.acc-panel-t');
  const accPanelD = document.getElementById('accPanel')?.querySelector('.acc-panel-d');
  const accPips = document.querySelectorAll('.acc-pip');

  accItems.forEach((item, idx) => {
    const head = item.querySelector('.acc-item-head');
    head?.addEventListener('click', () => {
      accItems.forEach((other) => {
        other.classList.remove('is-active');
        const toggle = other.querySelector('.acc-item-toggle');
        if (toggle) toggle.textContent = '+';
      });
      item.classList.add('is-active');
      const toggle = item.querySelector('.acc-item-toggle');
      if (toggle) toggle.textContent = '−';

      if (accPanelN) accPanelN.textContent = item.dataset.n ?? '';
      if (accPanelT) accPanelT.textContent = item.dataset.t ?? '';
      if (accPanelD) accPanelD.textContent = item.querySelector('.acc-detail p')?.textContent ?? '';
      accPips.forEach((pip, pIdx) => pip.classList.toggle('is-active', pIdx === idx));
    });
  });

  // ── Contadores de metricas ──
  if (!prefersReduced) {
    const countEls = document.querySelectorAll('[data-count]');
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

    function animateCount(el: Element) {
      const target = parseInt((el as HTMLElement).dataset.count ?? '0', 10);
      const duration = 1400;
      const start = performance.now();

      function frame(now: number) {
        const elapsed = now - start;
        const progress = Math.min(elapsed / duration, 1);
        const value = Math.round(easeOut(progress) * target);
        el.textContent = value.toLocaleString('es-MX');
        if (progress < 1) requestAnimationFrame(frame);
      }

      requestAnimationFrame(frame);
    }

    const counterObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animateCount(entry.target);
          counterObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });

    countEls.forEach((el) => counterObserver.observe(el));
  }
</script>

