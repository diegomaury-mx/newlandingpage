              <line class="evidence-line" data-field={n.key} x1={n.lineStart.x} y1={n.lineStart.y} x2={n.dot.x} y2={n.dot.y}></line>
            ))}
            {evidenceNodes.map((n) => (
              <circle class="evidence-dot" data-field={n.key} cx={n.dot.x} cy={n.dot.y} r="1.4"></circle>
