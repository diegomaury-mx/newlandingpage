---
// Home real del sitio, construido desde el CMS de Notion (Diego CMS —
// tarea "CMS: construir Home desde fuentes de Notion"). Lee el singleton
// `siteCopy` (pagina "Copy Oficial · diegomaury.mx (SSOT)", columna
// "Version Actual") y parsea sus secciones S1-S8 con parseSiteCopy.ts.
//
// Tercer corte (2026-07-24): se agregan S5 Como trabajo, S6 Sistemas
// propios, S6b Prueba social (solo los 3 testimonios explicitos del copy),
// S7 Formas de trabajar conmigo y el Footer. S7b Confianza directa se omite
// a proposito: su copy declara "sin copy propio, lo resuelve el widget"
// (Senja), y los testimonios via widget dinamico siguen pendientes de
// activar (ver memoria del proyecto). Los links de "Ver caso completo" por
// tarjeta de S4 siguen pendientes (requieren mapear el anchor del copy al
// slug real de cada ficha). Nota de diseno: esta pagina reusa los tokens de
// color del DS V2 pero NO replica el layout/componentes reales del
// index.html LIVE (nav con links, tira de metricas, etc.) — alineacion
// visual completa pendiente de un corte dedicado (decision explicita de
// Diego 2026-07-24: pausar diseno, priorizar copy).
//
// Sigue construyendo a dist/, no toca el sitio LIVE (astro.config.mjs).
import { getCollection } from 'astro:content';
import {
  parseSiteCopySections,
  heading1,
  heading2,
  paragraphs,
  ctaLabels,
  valueAfter,
  blocksBeforeHeading,
  blocksAfterHeading,
  bulletItems,
  headingCards,
  testimonials,
  caseCards,
  firstTable,
  firstCodeBlock,
  parseFlowDiagram,
} from '../utils/parseSiteCopy.ts';

const siteCopyEntries = await getCollection('siteCopy');
const siteCopy = siteCopyEntries.find((entry) => entry.id === 'site');
const sections = siteCopy ? parseSiteCopySections(siteCopy.data.markdown) : new Map();

const metricsEntries = await getCollection('metrics');
const incmtyMetric = metricsEntries.find((entry) => entry.id === 'incmty-participantes-inscritos');

// --- S1 · Hero ---------------------------------------------------------------
const s1 = sections.get('S1')?.blocks ?? [];
const heroName = heading1(s1);
const heroHeadline =
  heading2(s1) ||
  `${heroName} — Diseño programas, procesos y sistemas para convertir la visión en resultados tangibles.`;
// Acento ember sobre la frase de cierre, igual al tratamiento del H1 en el sitio LIVE.
const HERO_ACCENT_PHRASE = 'resultados tangibles';
const heroAccentIndex = heroHeadline.toLowerCase().indexOf(HERO_ACCENT_PHRASE);
const heroHeadlineBefore = heroAccentIndex >= 0 ? heroHeadline.slice(0, heroAccentIndex) : heroHeadline;
const heroHeadlineAccent = heroAccentIndex >= 0 ? heroHeadline.slice(heroAccentIndex, heroAccentIndex + HERO_ACCENT_PHRASE.length) : '';
const heroHeadlineAfter = heroAccentIndex >= 0 ? heroHeadline.slice(heroAccentIndex + HERO_ACCENT_PHRASE.length) : '';
const heroParas = paragraphs(s1);
const heroRole = heroParas[0] ?? '';
const heroSub = heroParas[1] ?? '';
const heroCtas = ctaLabels(s1);
const heroLogosLine = heroParas[3] ?? '';
const heroLogoNames = heroLogosLine.replace(/^Logos sugeridos:\s*/i, '').split('·').map((s) => s.trim()).filter(Boolean);

const LOGO_MAP: Record<string, { src: string; alt: string }> = {
  HEINEKEN: { src: '/cms-media/logos/heineken-mexico-logo-png_seeklogo-370450.png', alt: 'HEINEKEN Mexico' },
  'Tecnológico de Monterrey': { src: '/cms-media/logos/tec%20de%20monterrey.png', alt: 'Tecnológico de Monterrey' },
  INCmty: { src: '/cms-media/logos/incmty.png', alt: 'INCmty' },
  EBC: { src: '/cms-media/logos/EBC.png', alt: 'EBC' },
  FlipHouse: { src: '/cms-media/logos/Fliphouse_logo1.png', alt: 'FlipHouse' },
};
const heroLogos = heroLogoNames.map((name) => LOGO_MAP[name]).filter(Boolean);

// Badge de logo por tarjeta (Evidencia, Sistemas propios): solo donde el
// nombre del cliente sigue siendo publico en el copy. PropTech/SOFI se
// generalizaron a proposito (anonimizacion del cliente real) y no llevan
// logo, para no des-anonimizarlos visualmente.
function cardLogo(title: string): { src: string; alt: string } | null {
  if (/heineken/i.test(title)) return LOGO_MAP.HEINEKEN;
  // Solo REDUX (institucionalizado en el Tec de Monterrey per copy S6), no
  // HackSureste Ops: esa es marca propia de Diego, sin logo de cliente.
  if (/redux/i.test(title)) return LOGO_MAP['Tecnológico de Monterrey'];
  return null;
}

// --- S2 · Quien soy ------------------------------------------------------------
const s2 = sections.get('S2')?.blocks ?? [];
const aboutHeadline = heading2(s2);
const aboutParas = paragraphs(s2);
const aboutTagline = aboutParas[0] ?? '';
const aboutIntro = aboutParas.slice(1, 4);
const aboutRoles = aboutParas.slice(4, 7);
const aboutBio = aboutParas[7] ?? '';
const aboutStatsLine = aboutParas[8] ?? '';
const aboutStatsRaw = aboutStatsLine.split('•').map((s) => s.trim()).filter(Boolean);
// Sub-labels ya publicados en el sitio LIVE (index.html, .metric-s) — no son
// cifras nuevas, se reusan tal cual. El 3er stat ademas trae animacion
// count-up, igual que en LIVE, usando el valor real de la coleccion `metrics`.
const STAT_SUBLABELS = [
  'Trayectoria acumulada, cifra propia',
  '7+ en innovación y ecosistemas',
  incmtyMetric?.data.mandatoryQualifier || 'Agregado de programas INCmty (HGC incluido), estimado',
];
const aboutStats = aboutStatsRaw.map((raw, i) => {
  const match = raw.match(/^([\d.,]+\+?)\s*(.+)$/);
  const n = match ? match[1] : raw;
  const l = match ? match[2] : '';
  const countTo = i === 2 ? (incmtyMetric?.data.value ?? n).replace(/\D/g, '') : '';
  return { n, l, s: STAT_SUBLABELS[i] ?? '', countTo };
});

// --- S3 · El problema que resuelvo ---------------------------------------------
const s3 = sections.get('S3')?.blocks ?? [];
const problemLabel = sections.get('S3')?.label ?? 'El problema que resuelvo';
const problemHeadline = heading2(s3);
// Excluye tambien etiquetas sueltas del diagrama ASCII de "Asi trabajo"
// (ej. "TRADUZCO EN"): nunca aparece prosa en mayusculas en esta seccion.
const problemParas = paragraphs(s3).filter(
  (p) => !p.includes('\n') && !p.startsWith('┌') && p !== p.toUpperCase(),
);
const problemQuote = s3.find((b) => b.trim().startsWith('>'))?.trim().slice(1).trim() ?? '';
const problemDiagram = parseFlowDiagram(firstCodeBlock(s3));

// --- S4 · Evidencia ------------------------------------------------------------
const s4 = sections.get('S4')?.blocks ?? [];
const evidenceLabel = sections.get('S4')?.label ?? 'Evidencia';
const evidenceHeadline = heading1(s4);
const evidenceIntro = paragraphs(blocksBeforeHeading(s4, ['# Casos destacados']));
const evidenceCards = caseCards(s4);

// Slugs reales de la coleccion `cases` (verificados contra el build de
// portfolio/[slug].astro). El copy anonimiza "PropTech" en vez de nombrar
// FlipHouse, pero el caso real detras de esa tarjeta es SOFI.
function caseLink(title: string): string | null {
  const key = title.toLowerCase();
  if (key.includes('proptech')) return '/portfolio/sofi';
  if (key.includes('heineken')) return '/portfolio/heineken-green-challenge';
  if (key.includes('hacksureste')) return '/portfolio/hacksureste';
  return null;
}

// "111 ideas validadas en una sola edicion" no esta en el SSOT de metricas
// (assets/data/metrics.json): no se puede verificar ni publicar per el SOP
// de metricas, asi que se retira del render aunque siga en el copy de
// Notion (pendiente de correccion en la fuente, ver spec 2026-07-24).
const UNVERIFIED_METRIC_FRAGMENTS = [' · 111 ideas validadas en una sola edición'];
function stripUnverifiedMetrics(cell: string): string {
  return UNVERIFIED_METRIC_FRAGMENTS.reduce((acc, fragment) => acc.replace(fragment, ''), cell);
}
const rawEvidenceTable = firstTable(s4);
const evidenceTable = rawEvidenceTable && {
  ...rawEvidenceTable,
  rows: rawEvidenceTable.rows.map((row) => row.map(stripUnverifiedMetrics)),
};
// El diagrama pasa de bloque de texto (una etapa por linea, separadas por
// "↓") a un grafico visual de barras ascendentes: solo se necesitan los
// nombres de etapa, en orden.
const evidenceStages = firstCodeBlock(s4)
  .split('\n')
  .map((line) => line.trim())
  .filter((line) => line && line !== '↓');
const evidenceStatLine = s4.find((b) => b.includes('proyectos documentados'))?.trim() ?? '';
const evidenceCtaLabel =
  s4
    .find((b) => b.toLowerCase().includes('explorar portafolio'))
    ?.replace(/→\s*/, '')
    .replace(/#portafolio\s*$/i, '')
    .trim() || 'Explorar portafolio completo';

// --- S5 · Como trabajo -----------------------------------------------------
const s5 = sections.get('S5')?.blocks ?? [];
const workLabel = sections.get('S5')?.label ?? 'Cómo trabajo';
const workHeadline = heading1(s5);
const workIntro = paragraphs(blocksBeforeHeading(s5, ['## Mi modelo de intervención']));
const afterModel = blocksAfterHeading(s5, '## Mi modelo de intervención');
const workSteps = headingCards(blocksBeforeHeading(afterModel, ['## Lo que entrego']), '### ');
const afterDeliver = blocksAfterHeading(s5, '## Lo que entrego');
const deliverIntro = paragraphs(afterDeliver);
const deliverItems = bulletItems(afterDeliver);

// --- S6 · Sistemas propios ---------------------------------------------------
const s6 = sections.get('S6')?.blocks ?? [];
const systemsLabel = sections.get('S6')?.label ?? 'Sistemas propios';
const systemsHeadline = heading1(s6);
const systemsIntro = paragraphs(blocksBeforeHeading(s6, ['## REDUX']));
const systemsCards = headingCards(blocksBeforeHeading(s6, ['## El verdadero entregable']), '## ');
const systemsClosingHeading =
  s6.find((b) => b.trim().startsWith('## El verdadero entregable'))?.trim().slice(3).trim() ??
  'El verdadero entregable';
const systemsClosing = paragraphs(blocksAfterHeading(s6, '## El verdadero entregable'));

// --- S6b · Prueba social ------------------------------------------------------
const s6b = sections.get('S6b')?.blocks ?? [];
const testimonialsLabel = sections.get('S6b')?.label ?? 'Prueba social';
const testimonialsHeadline = heading1(s6b);
const testimonialsIntro = paragraphs(blocksBeforeHeading(s6b, ['>']));
const testimonialItems = testimonials(s6b);

// --- S7 · Formas de trabajar conmigo ------------------------------------------
const s7 = sections.get('S7')?.blocks ?? [];
const talkLabel = sections.get('S7')?.label ?? 'Formas de trabajar conmigo';
const talkHeadline = heading1(s7);
const talkIntro = paragraphs(blocksBeforeHeading(s7, ['### En una primera conversación']));
const talkTopicsHeading =
  s7.find((b) => b.trim().startsWith('### En una primera conversación'))?.trim().slice(4).trim() ?? '';
const talkTopics = bulletItems(blocksAfterHeading(s7, '### En una primera conversación'));
const afterAgenda = blocksAfterHeading(s7, '## Agenda una conversación');
const talkAltLine = afterAgenda.find((b) => b.toLowerCase().includes('envíame un correo'))?.trim() ?? '';
const talkAltLinks = talkAltLine.split('·').map((s) => s.trim()).filter(Boolean);
// paragraphs() no filtra el separador "o" ni la linea de links alternos (no son
// bullets/headings/etc.): se excluyen aparte para no duplicarlos como texto plano.
const agendaIntro = paragraphs(afterAgenda).filter((p) => p !== 'o' && p !== talkAltLine);
const agendaCtaLabel = ctaLabels(afterAgenda)[0] || 'Agendar diagnóstico (30 min)';
const CONTACT_HREF: Record<string, string> = {
  linkedin: 'https://www.linkedin.com/in/diegomaury',
  correo: 'mailto:dm@diegomaury.mx',
};
function contactHref(label: string): string {
  const key = label.toLowerCase().includes('linkedin') ? 'linkedin' : 'correo';
  return CONTACT_HREF[key];
}

// --- S8 · Siguiente paso -------------------------------------------------------
// Recuperada 2026-07-24 (spec docs/superpowers/specs/2026-07-24-recuperar-s8-y-cifras-s6.md):
// no existia en el primer corte, Diego la pego en Notion despues.
const s8 = sections.get('S8')?.blocks ?? [];
const finalLabel = sections.get('S8')?.label ?? 'Siguiente paso';
const finalHeadline = heading2(s8);
const finalIntro = paragraphs(blocksBeforeHeading(s8, ['### Paso 01']));
const finalStepCards = headingCards(s8, '### ');
const finalSteps = finalStepCards.map((card) => ({
  title: card.title,
  description: card.paragraphs[0] ?? '',
  tag: card.paragraphs[1] ?? '',
}));
const afterSteps = blocksAfterHeading(s8, `### ${finalStepCards[finalStepCards.length - 1]?.title ?? ''}`);
const finalCtas = ctaLabels(afterSteps);
const finalTrustLine = afterSteps.find((b) => b.includes('·') && !ctaLabels([b]).length)?.trim() ?? '';

// --- SEO -------------------------------------------------------------------
const seo = sections.get('SEO')?.blocks ?? [];
const pageTitle = valueAfter(seo, 'Title') || 'Diego Maury · Strategic Program Director';
const pageDescription =
  valueAfter(seo, 'Meta description') ||
  'Strategic Program Director: diseño programas, procesos y sistemas que convierten la estrategia en ejecución y capacidad organizacional.';

// --- Footer ------------------------------------------------------------------
// El heading "## Footer" no matchea SECTION_HEADING (necesita "# Sn ·"), asi
// que su contenido queda dentro de los blocks de la seccion SEO: se extrae
// manualmente a partir de ese heading.
const footerBlocks = blocksAfterHeading(seo, '## Footer');
const beforeExplore = blocksBeforeHeading(footerBlocks, ['### Explora']);
const footerBrandName = heading2(beforeExplore) || 'Diego Maury';
const footerTagline = paragraphs(beforeExplore)[0] ?? '';
const exploreItems = bulletItems(blocksBeforeHeading(blocksAfterHeading(footerBlocks, '### Explora'), ['### Contacto']));
const afterContacto = blocksAfterHeading(footerBlocks, '### Contacto');
const contactParagraphs = paragraphs(afterContacto);
const contactItems = contactParagraphs.filter((p) => !p.startsWith('©'));
const copyrightLine = contactParagraphs.find((p) => p.startsWith('©')) ?? '© 2026 Diego Maury. Todos los derechos reservados.';

const EXPLORE_HREF: Record<string, string> = {
  Portafolio: '/portfolio',
  'Casos de estudio': '#evidencia',
  'Sobre mí': '#quien-soy',
  Newsletter: 'https://diegomaury.substack.com',
  LinkedIn: 'https://www.linkedin.com/in/diegomaury',
};
const CONTACT_ITEM_HREF: Record<string, string> = {
  'Correo electrónico': 'mailto:dm@diegomaury.mx',
  LinkedIn: 'https://www.linkedin.com/in/diegomaury',
  Calendly: 'https://calendar.notion.so/meet/diegomaurymx/5aad3vun',
};
---

<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>{pageTitle}</title>
<meta name="description" content={pageDescription}>
<meta property="og:type" content="website">
<meta property="og:title" content={pageTitle}>
<meta property="og:description" content={pageDescription}>
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content={pageTitle}>
<meta name="twitter:description" content={pageDescription}>
<!--
  Home construido desde Notion (Diego CMS). Fuente: siteCopy singleton,
  parseado por src/utils/parseSiteCopy.ts. Scaffold, no desplegado: construye
  a dist/, no toca el sitio LIVE (astro.config.mjs).
-->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,700;0,800;1,400&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0A0612;
    --bg-2: #1A1128;
    --border: #6A291B;
    --t1: #FAF8FC;
    --t2: #DDDBE0;
    --t3: #A8A6AC;
    --ember: #FF5C39;
    --ember-cta: #BF452B;
    --sans: 'Plus Jakarta Sans', system-ui, sans-serif;
    --mono: 'DM Mono', ui-monospace, monospace;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --wrap: 1160px;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg); color: var(--t1);
    font-family: var(--sans); line-height: 1.6; min-height: 100vh;
    -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;
  }
  a { color: var(--ember); }
  ::selection { background: var(--ember); color: var(--bg); }
  :focus-visible { outline: 2px solid var(--ember); outline-offset: 3px; border-radius: 4px; }

  .wrap { max-width: var(--wrap); margin: 0 auto; padding: 0 32px; }

  .eyebrow {
    font-family: var(--mono); font-size: 10px; font-weight: 500;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--ember);
    display: flex; align-items: center; gap: 10px;
  }
  .eyebrow::before { content: ""; width: 18px; height: 1px; background: var(--ember); }

  /* ── NAV ── */
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: rgba(10,6,18,0.92); backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent; transition: border-color 250ms, background 250ms;
  }
  .nav.is-scrolled { background: rgba(10,6,18,0.98); border-bottom-color: var(--border); }
  .nav__inner { height: 60px; display: flex; align-items: center; justify-content: space-between; }
  .nav__brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--t1); font-size: 14px; font-weight: 700; letter-spacing: -0.01em; }
  .nav__mark { width: 22px; height: 22px; background: var(--ember); clip-path: polygon(50% 0%,100% 25%,100% 75%,50% 100%,0% 75%,0% 25%); flex-shrink: 0; }
  .nav__badge { font-family: var(--mono); font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--t3); border: 1px solid var(--border); padding: 5px 10px; border-radius: 5px; }
  .nav__links { display: flex; gap: 0; align-items: center; }
  .nav__link { font-size: 13px; font-weight: 500; color: var(--t2); padding: 7px 13px; border-radius: 6px; text-decoration: none; transition: color 150ms, background 150ms; letter-spacing: -0.01em; }
  .nav__link:hover { color: var(--t1); background: rgba(255,255,255,0.05); }
  .nav__link.is-active { color: var(--t1); }
  .nav__cta {
    display: inline-flex; align-items: center; background: var(--ember-cta); color: #fff;
    font-family: var(--mono); font-size: 9.5px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase;
    padding: 9px 17px; border-radius: 6px; text-decoration: none; margin-left: 8px; transition: opacity 150ms, transform 150ms;
  }
  .nav__cta:hover { opacity: 0.88; transform: translateY(-1px); }
  .nav__burger { display: none; background: none; border: none; cursor: pointer; padding: 6px; color: var(--t2); }
  .nav__burger svg { display: block; }
  @media (max-width: 900px) {
    .nav__links {
      display: none; position: fixed; inset: 60px 0 0 0;
      background: rgba(10,6,18,0.98); backdrop-filter: blur(16px);
      flex-direction: column; align-items: flex-start; gap: 0;
      padding: 24px 32px; border-top: 1px solid var(--border); z-index: 49;
    }
    .nav__links.is-open { display: flex; }
    .nav__link { font-size: 17px; padding: 12px 0; width: 100%; border-radius: 0; }
    .nav__cta { margin-left: 0; margin-top: 12px; }
    .nav__burger { display: block; }
  }

  /* ── HERO ── */
  .hero { padding: 96px 0 64px; }
  .hero__grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 56px; align-items: center; }
  .hero h1 {
    margin-top: 22px; font-size: clamp(2.4rem, 4.6vw, 4rem); font-weight: 800;
    letter-spacing: -0.032em; line-height: 1.05; max-width: 20ch;
  }
  .hero h1 .accent { color: var(--ember); }
  .hero p.sub { margin-top: 24px; font-size: 16px; color: var(--t2); max-width: 52ch; line-height: 1.7; }
  .hero__ctas { display: flex; gap: 14px; margin-top: 32px; flex-wrap: wrap; }
  .btn-primary, .btn-ghost {
    font-size: 14px; font-weight: 600; padding: 13px 24px; border-radius: 8px;
    text-decoration: none; transition: transform 160ms var(--ease), border-color 160ms var(--ease);
    display: inline-flex; align-items: center;
  }
  .btn-primary { background: var(--ember-cta); color: #fff; }
  .btn-primary:hover { transform: translateY(-1px); }
  .btn-ghost { border: 1px solid var(--border); color: var(--t1); }
  .btn-ghost:hover { border-color: var(--ember); }
  .hero__media {
    aspect-ratio: 4/5; border-radius: 16px; border: 1px solid var(--border);
    background: var(--bg-2); display: flex; align-items: center; justify-content: center;
    color: var(--t3); font-size: 12px; font-family: var(--mono); overflow: hidden;
  }
  .hero__media img { width: 100%; height: 100%; object-fit: cover; }

  .trust { margin-top: 64px; border-top: 1px solid var(--border); padding-top: 28px; }
  .trust__label { font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--t3); margin-bottom: 16px; }
  .trust__track-wrap {
    overflow: hidden; position: relative;
    mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
  }
  .trust__track { display: flex; width: max-content; gap: 28px; animation: marquee 24s linear infinite; }
  .trust__track:hover { animation-play-state: paused; }
  @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .trust__track img { height: 24px; width: auto; filter: grayscale(1) brightness(1.6); opacity: 0.7; }
  @media (prefers-reduced-motion: reduce) { .trust__track { animation: none; } }

  /* ── QUIEN SOY ── */
  .about { padding: 88px 0; background: var(--bg-2); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .about__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; }
  .about__tagline { font-family: var(--mono); font-size: 12px; letter-spacing: 0.06em; color: var(--ember); text-transform: uppercase; margin-bottom: 16px; }
  .about h2 { font-size: clamp(2rem, 3.2vw, 2.8rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.15; margin-bottom: 20px; }
  .about p { color: var(--t2); font-size: 15px; line-height: 1.75; margin-bottom: 16px; }
  .about__roles { margin-top: 24px; display: flex; flex-direction: column; gap: 14px; }
  .about__role { display: flex; gap: 12px; font-size: 14px; color: var(--t2); line-height: 1.6; }
  .about__role-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--ember); margin-top: 8px; flex-shrink: 0; }
  .about__bio { font-size: 15px; color: var(--t2); line-height: 1.75; }
  .about__stats { margin-top: 32px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; border-top: 1px solid var(--border); padding-top: 24px; }
  .about__stat-n { font-family: var(--mono); font-size: clamp(1.5rem, 2.3vw, 2rem); font-weight: 800; letter-spacing: -0.02em; color: var(--ember); line-height: 1; font-variant-numeric: tabular-nums; }
  .about__stat-l { font-size: 13px; color: var(--t1); font-weight: 500; margin-top: 6px; }
  .about__stat-s { font-family: var(--mono); font-size: 9.5px; color: var(--t3); margin-top: 4px; letter-spacing: 0.04em; }

  /* ── PROBLEMA ── */
  .problem { padding: 96px 0; }
  .problem__grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 32px; align-items: center; }
  .problem h2 { margin-top: 14px; font-size: clamp(1.65rem, 2.7vw, 2.5rem); font-weight: 800; letter-spacing: -0.028em; line-height: 1.1; max-width: 26ch; }
  .problem p { margin-top: 20px; font-size: 15px; color: var(--t2); line-height: 1.75; max-width: 68ch; }
  .problem__media {
    aspect-ratio: 1/1; max-width: 260px; margin: 0 auto; border-radius: 16px; border: 1px solid var(--border);
    background: var(--bg-2); display: flex; align-items: center; justify-content: center; padding: 32px;
  }
  .problem__media svg { width: 100%; height: 100%; }
  .problem blockquote {
    margin-top: 40px; padding: 28px 32px; border-left: 2px solid var(--ember);
    background: var(--bg-2); border-radius: 0 10px 10px 0; font-size: 16px;
    color: var(--t1); font-weight: 500; line-height: 1.6;
  }
  .flow-diagram { display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap; margin: 28px 0 4px; }
  .flow-card { background: var(--bg-2); border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; flex: 1; min-width: 150px; }
  .flow-card h3 { font-family: var(--mono); font-size: 10px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ember); margin-bottom: 10px; display: flex; align-items: center; gap: 8px; }
  .flow-card h3::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--ember); flex-shrink: 0; }
  .flow-card ul { list-style: none; display: flex; flex-direction: column; gap: 5px; }
  .flow-card li { font-size: 12.5px; color: var(--t2); padding-left: 13px; position: relative; }
  .flow-card li::before { content: ""; position: absolute; left: 0; top: 0.6em; width: 6px; height: 1px; background: var(--t3); }
  .flow-connector { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 0 10px; flex-shrink: 0; }
  .flow-connector__line { width: 20px; height: 1px; background: var(--border); }
  .flow-connector__label { font-family: var(--mono); font-size: 9.5px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--t3); }
  .flow-chips { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
  .flow-chip { font-family: var(--mono); font-size: 11px; font-weight: 500; color: var(--t1); background: rgba(255,92,57,0.1); border: 1px solid rgba(255,92,57,0.3); border-radius: 20px; padding: 5px 13px; }
  .flow-arrow { width: 8px; height: 8px; border-right: 1.5px solid var(--ember); border-bottom: 1.5px solid var(--ember); transform: rotate(-45deg); }

  /* ── EVIDENCIA ── */
  .evidence { padding: 96px 0; background: var(--bg-2); border-top: 1px solid var(--border); }
  .evidence h2 { margin-top: 14px; font-size: clamp(1.65rem, 2.7vw, 2.5rem); font-weight: 800; letter-spacing: -0.028em; line-height: 1.1; max-width: 30ch; }
  .evidence > .wrap > p { margin-top: 16px; font-size: 15px; color: var(--t2); line-height: 1.75; max-width: 68ch; }
  .evidence > .wrap > p:first-of-type { font-weight: 600; color: var(--t1); }

  .evidence__cards { margin-top: 48px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .case-card { background: var(--bg); border: 1px solid var(--border); border-radius: 14px; padding: 28px; display: flex; flex-direction: column; gap: 14px; }
  .case-card__logo { display: block; height: 22px; width: auto; max-width: 100px; object-fit: contain; filter: grayscale(1) brightness(1.6); opacity: 0.85; margin-bottom: 12px; }
  .case-card h3 { font-size: 17px; font-weight: 700; letter-spacing: -0.01em; line-height: 1.35; }
  .case-card p { font-size: 13.5px; color: var(--t2); line-height: 1.65; }
  .case-card__label { display: block; font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ember); margin-bottom: 4px; }
  .case-card__results { list-style: none; display: flex; flex-direction: column; gap: 8px; margin-top: auto; }
  .case-card__results li { font-family: var(--mono); font-size: 12.5px; color: var(--t1); padding-left: 16px; position: relative; }
  .case-card__results li::before { content: ""; position: absolute; left: 0; top: 7px; width: 6px; height: 6px; border-radius: 50%; background: var(--ember); }
  .case-card__link { font-family: var(--mono); font-size: 11px; letter-spacing: 0.06em; color: var(--t2); text-decoration: none; padding-top: 6px; transition: color 150ms; }
  .case-card__link:hover { color: var(--ember); }

  /* Tabla simple: sin caja/borde envolvente, solo lineas divisorias — el estilo que Diego prefiere. */
  .evidence__table { width: 100%; border-collapse: collapse; margin-top: 64px; font-size: 13px; }
  .evidence__table th, .evidence__table td { text-align: left; padding: 12px 16px; border-bottom: 1px solid var(--border); color: var(--t2); }
  .evidence__table th { font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--t3); font-weight: 500; }
  .evidence__table td:first-child { color: var(--t1); font-weight: 600; }

  /* Flujo horizontal de pasos conectados ("glass" sin blur: fondo translucido + borde, sin backdrop-filter). */
  .evidence__diagram { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin: 48px auto 0; max-width: 760px; justify-content: center; }
  .diagram-step { display: flex; align-items: center; gap: 6px; }
  .diagram-pill {
    display: flex; align-items: center; gap: 8px; padding: 9px 16px; border-radius: 20px;
    background: rgba(250,248,252,0.05); border: 1px solid var(--border);
  }
  .diagram-pill-n { font-family: var(--mono); font-size: 10px; color: var(--t3); }
  .diagram-label { font-size: 12.5px; font-weight: 600; color: var(--t2); white-space: nowrap; }
  .diagram-step.is-outcome .diagram-pill { background: rgba(255,92,57,0.14); border-color: var(--ember); }
  .diagram-step.is-outcome .diagram-pill-n { color: var(--ember); }
  .diagram-step.is-outcome .diagram-label { color: var(--t1); }
  .diagram-connector { width: 14px; height: 1px; background: var(--border); flex-shrink: 0; }

  .evidence__footer { margin-top: 48px; display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; }
  .evidence__stat { font-family: var(--mono); font-size: 13px; color: var(--t1); font-weight: 600; }

  /* ── COMO TRABAJO (acordeon) ── */
  .how-we-work { padding: 96px 0; }
  .how-we-work h2 { margin-top: 14px; font-size: clamp(1.65rem, 2.7vw, 2.5rem); font-weight: 800; letter-spacing: -0.028em; line-height: 1.1; max-width: 30ch; }
  .how-we-work > .wrap > p { margin-top: 16px; font-size: 15px; color: var(--t2); line-height: 1.75; max-width: 68ch; }
  .accordion-wrap { margin-top: 48px; display: grid; grid-template-columns: 1fr 340px; gap: 28px; align-items: start; }
  @media (max-width: 760px) { .accordion-wrap { grid-template-columns: 1fr; gap: 0; } }
  .accordion-list { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; background: var(--bg-2); }
  .acc-item { border-bottom: 1px solid var(--border); cursor: pointer; }
  .acc-item:last-child { border-bottom: none; }
  .acc-item-head { display: flex; align-items: center; gap: 16px; padding: 20px 22px; transition: background 200ms; background: none; border: none; width: 100%; text-align: left; font: inherit; color: inherit; cursor: pointer; }
  .acc-item:hover .acc-item-head { background: rgba(250,248,252,0.03); }
  .acc-item-n { font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; color: var(--t3); flex-shrink: 0; width: 24px; transition: color 200ms; }
  .acc-item.is-active .acc-item-n { color: var(--ember); }
  .acc-item-t { font-size: 14.5px; font-weight: 700; color: var(--t2); transition: color 200ms; }
  .acc-item.is-active .acc-item-t { color: var(--t1); }
  .acc-item-toggle { margin-left: auto; font-family: var(--mono); font-size: 16px; color: var(--t3); }
  .acc-item.is-active .acc-item-toggle { color: var(--ember); }
  .acc-detail { max-height: 0; overflow: hidden; transition: max-height 300ms var(--ease); }
  .acc-item.is-active .acc-detail { max-height: 200px; }
  .acc-detail p { font-size: 12.5px; color: var(--t2); line-height: 1.6; padding: 0 22px 20px 62px; }
  .acc-panel { position: sticky; top: 24px; border: 1px solid var(--border); border-radius: 12px; background: var(--bg-2); padding: 28px 26px; }
  @media (max-width: 760px) { .acc-panel { display: none; } }
  .acc-panel-n { font-family: var(--mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ember); margin-bottom: 14px; }
  .acc-panel-t { font-size: 20px; font-weight: 800; color: var(--t1); margin-bottom: 12px; }
  .acc-panel-d { font-size: 13px; color: var(--t2); line-height: 1.65; margin-bottom: 18px; }
  .acc-pips { display: flex; gap: 6px; }
  .acc-pip { width: 20px; height: 3px; border-radius: 2px; background: var(--border); transition: background 200ms; }
  .acc-pip.is-active { background: var(--ember); }
  .deliver-heading { margin-top: 64px; font-size: clamp(1.3rem, 2.2vw, 1.7rem); font-weight: 700; letter-spacing: -0.01em; }
  .deliver-cards { margin-top: 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; }
  .deliver-card { background: var(--bg-2); border: 1px solid var(--border); border-radius: 12px; padding: 18px 20px; font-size: 14px; color: var(--t1); line-height: 1.5; display: flex; align-items: flex-start; gap: 12px; }
  .deliver-card__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--ember); margin-top: 8px; flex-shrink: 0; }

  /* ── SISTEMAS PROPIOS ── */
  .systems { padding: 96px 0; background: var(--bg-2); border-top: 1px solid var(--border); }
  .systems h2 { margin-top: 14px; font-size: clamp(1.65rem, 2.7vw, 2.5rem); font-weight: 800; letter-spacing: -0.028em; line-height: 1.1; max-width: 30ch; }
  .systems > .wrap > p { margin-top: 16px; font-size: 15px; color: var(--t2); line-height: 1.75; max-width: 68ch; }
  .systems__cards { margin-top: 48px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .system-card { background: var(--bg); border: 1px solid var(--border); border-radius: 14px; padding: 28px; }
  .system-card h3 { font-size: 17px; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 14px; }
  .system-card p { font-size: 13.5px; color: var(--t2); line-height: 1.65; margin-bottom: 10px; }
  .system-card p:last-child { margin-bottom: 0; }
  .systems__closing { margin-top: 56px; padding-top: 40px; border-top: 1px solid var(--border); }
  .systems__closing h3 { font-size: clamp(1.3rem, 2.2vw, 1.7rem); font-weight: 700; letter-spacing: -0.01em; margin-bottom: 16px; }
  .systems__closing p { font-size: 14px; color: var(--t2); line-height: 1.7; max-width: 68ch; margin-bottom: 10px; }

  /* ── PRUEBA SOCIAL ── */
  .testimonials { padding: 96px 0; }
  .testimonials h2 { margin-top: 14px; font-size: clamp(1.65rem, 2.7vw, 2.5rem); font-weight: 800; letter-spacing: -0.028em; line-height: 1.1; max-width: 30ch; }
  .testimonials > .wrap > p { margin-top: 16px; font-size: 15px; color: var(--t2); line-height: 1.75; max-width: 68ch; }
  .testimonial-grid { margin-top: 48px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .testimonial-card { background: var(--bg-2); border: 1px solid var(--border); border-radius: 14px; padding: 26px; display: flex; flex-direction: column; gap: 16px; }
  .testimonial-card p { font-size: 13.5px; color: var(--t2); line-height: 1.65; }
  .testimonial-card footer { border-top: 1px solid var(--border); padding-top: 14px; display: flex; flex-direction: column; gap: 2px; }
  .testimonial-card footer strong { font-size: 13px; color: var(--t1); }
  .testimonial-card footer span { font-family: var(--mono); font-size: 10px; letter-spacing: 0.04em; color: var(--t3); }

  /* ── HABLEMOS ── */
  .talk { padding: 96px 0; background: var(--bg-2); border-top: 1px solid var(--border); }
  .talk h2 { margin-top: 14px; font-size: clamp(1.65rem, 2.7vw, 2.5rem); font-weight: 800; letter-spacing: -0.028em; line-height: 1.1; max-width: 30ch; }
  .talk > .wrap > p { margin-top: 16px; font-size: 15px; color: var(--t2); line-height: 1.75; max-width: 68ch; }
  .talk__grid { margin-top: 48px; display: grid; grid-template-columns: 1.3fr 1fr; gap: 32px; align-items: center; }
  .talk__media { border-radius: 16px; overflow: hidden; aspect-ratio: 4/5; max-width: 280px; margin: 0 auto; border: 1px solid var(--border); }
  .talk__media img { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 800px) { .talk__grid { grid-template-columns: 1fr; } }
  .talk__topics { margin-top: 0; }
  .talk__topics h3 { font-size: 15px; font-weight: 700; margin-bottom: 16px; }
  .talk__topics ul { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
  .talk__topics li { font-size: 14px; color: var(--t2); padding-left: 18px; position: relative; }
  .talk__topics li::before { content: ""; position: absolute; left: 0; top: 8px; width: 6px; height: 6px; border-radius: 50%; background: var(--ember); }
  .talk__agenda { margin-top: 56px; padding-top: 40px; border-top: 1px solid var(--border); }
  .talk__agenda h3 { font-size: clamp(1.3rem, 2.2vw, 1.7rem); font-weight: 700; margin-bottom: 16px; }
  .talk__agenda p { font-size: 14px; color: var(--t2); line-height: 1.7; max-width: 60ch; margin-bottom: 24px; }
  .talk__alt { margin-top: 20px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .talk__alt-item { display: flex; align-items: center; gap: 10px; }
  .talk__sep { font-family: var(--mono); font-size: 12px; color: var(--t3); }
  .inline-link { color: var(--ember); text-decoration: underline; text-underline-offset: 2px; font-size: 14px; }
  .inline-link:hover, .inline-link:focus-visible { color: var(--t1); }

  /* ── SIGUIENTE PASO (S8, cierre) ── */
  .final-cta { padding: 96px 0; text-align: center; }
  .final-cta__inner { max-width: 760px; margin: 0 auto; }
  .final-cta .eyebrow { justify-content: center; }
  .final-cta h2 { margin-top: 18px; font-size: clamp(1.9rem, 3.6vw, 3.1rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.08; }
  .final-cta p { margin-top: 18px; font-size: 1.02rem; color: var(--t2); line-height: 1.7; max-width: 50ch; margin-left: auto; margin-right: auto; }
  .final-cta__steps { margin-top: 44px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 13px; overflow: hidden; text-align: left; }
  .final-cta__step { background: var(--bg-2); padding: 28px 26px 32px; }
  .final-cta__step-n { font-family: var(--mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ember); margin-bottom: 18px; }
  .final-cta__step-t { font-size: 14px; font-weight: 700; margin-bottom: 8px; color: var(--t1); }
  .final-cta__step-d { font-size: 12.5px; color: var(--t2); line-height: 1.55; margin-bottom: 14px; }
  .final-cta__step-tag { font-family: var(--mono); font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--t3); border: 1px solid var(--border); border-radius: 3px; padding: 3px 7px; display: inline-block; }
  .final-cta__buttons { margin-top: 44px; display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .final-cta__ctas { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }
  .final-cta__trust { font-family: var(--mono); font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--t3); }
  @media (max-width: 680px) { .final-cta__steps { grid-template-columns: 1fr; } }

  /* ── FOOTER ── */
  .site-footer { padding: 64px 0 32px; border-top: 1px solid var(--border); }
  .site-footer__grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: 32px; }
  .site-footer__brand { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; font-size: 14px; font-weight: 700; }
  .site-footer__tagline { font-size: 12.5px; color: var(--t2); line-height: 1.6; max-width: 32ch; }
  .site-footer__col-title { font-family: var(--mono); font-size: 9px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ember); margin-bottom: 12px; }
  .site-footer__col { display: flex; flex-direction: column; gap: 9px; }
  .site-footer__col a, .site-footer__col span { font-size: 12.5px; color: var(--t2); text-decoration: none; }
  .site-footer__col a:hover { color: var(--t1); }
  .site-footer__legal { margin-top: 28px; padding-top: 18px; border-top: 1px solid var(--border); font-family: var(--mono); font-size: 10px; color: var(--t3); }

  @media (max-width: 860px) {
    .hero__grid, .about__grid, .problem__grid { grid-template-columns: 1fr; }
    .hero__media { max-width: 320px; margin: 0 auto; }
    .about__stats { grid-template-columns: 1fr; }
    .evidence__cards, .systems__cards, .testimonial-grid { grid-template-columns: 1fr; }
    .site-footer__grid { grid-template-columns: 1fr; gap: 24px; }
  }
</style>
</head>
<body>

<nav class="nav" id="nav" aria-label="Navegación principal">
  <div class="wrap nav__inner">
    <a href="#hero" class="nav__brand">
      <span class="nav__mark" aria-hidden="true"></span>
      <span>Diego Maury</span>
    </a>
    <div class="nav__links" id="navLinks">
      <a href="#quien-soy" class="nav__link">Quién soy</a>
      <a href="#problema" class="nav__link">El problema</a>
      <a href="#evidencia" class="nav__link">Evidencia</a>
      <a href="#como-trabajo" class="nav__link">Cómo trabajo</a>
      <a href="#sistemas-propios" class="nav__link">Sistemas propios</a>
      <a href="#hablemos" class="nav__link">Conversemos</a>
      <a href="https://calendar.notion.so/meet/diegomaurymx/5aad3vun" class="nav__cta" target="_blank" rel="noopener">Agendar diagnóstico</a>
    </div>
    <button type="button" class="nav__burger" id="navBurger" aria-label="Abrir menú" aria-expanded="false" aria-controls="navLinks">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
        <path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</nav>

<section class="hero" id="hero">
  <div class="wrap">
    <div class="hero__grid">
      <div>
        <div class="eyebrow">{heroRole || 'Strategic Program Director'}</div>
        <h1>{heroHeadlineBefore}{heroHeadlineAccent && <span class="accent">{heroHeadlineAccent}</span>}{heroHeadlineAfter}</h1>
        {heroSub && <p class="sub">{heroSub}</p>}
        {heroCtas.length > 0 && (
          <div class="hero__ctas">
            <a href="https://calendar.notion.so/meet/diegomaurymx/5aad3vun" class="btn-primary" target="_blank" rel="noopener">{heroCtas[0]}</a>
            {heroCtas[1] && <a href="/cv/diego-maury-cv.pdf" class="btn-ghost" download>{heroCtas[1]}</a>}
          </div>
        )}
      </div>
      <div class="hero__media">
        <img src="/cms-media/diego/diegomaurypng.png" alt={heroName || 'Diego Maury'} loading="eager" fetchpriority="high" width="700" height="875">
      </div>
    </div>
    {heroLogos.length > 0 && (
      <div class="trust">
        <div class="trust__label">He trabajado con</div>
        <div class="trust__track-wrap">
          <div class="trust__track">
            {heroLogos.map((logo) => <img src={logo.src} alt={logo.alt} loading="lazy">)}
            {heroLogos.map((logo) => <img src={logo.src} alt="" aria-hidden="true" loading="lazy">)}
          </div>
        </div>
      </div>
    )}
  </div>
</section>

<section class="about" id="quien-soy">
  <div class="wrap about__grid">
    <div>
      <div class="about__tagline">{aboutTagline}</div>
      <h2>{aboutHeadline}</h2>
      {aboutIntro.map((p) => <p>{p}</p>)}
      <div class="about__roles">
        {aboutRoles.map((role) => (
          <div class="about__role">
            <div class="about__role-dot"></div>
            <div>{role}</div>
          </div>
        ))}
      </div>
    </div>
    <div>
      <p class="about__bio">{aboutBio}</p>
      {aboutStats.length > 0 && (
        <div class="about__stats">
          {aboutStats.map((stat) => (
            <div>
              <div class="about__stat-n" data-count={stat.countTo || undefined}>{stat.n}</div>
              <div class="about__stat-l">{stat.l}</div>
              {stat.s && <div class="about__stat-s">{stat.s}</div>}
            </div>
