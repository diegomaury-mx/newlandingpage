---
// Home real del sitio, construido desde el CMS de Notion (Diego CMS —
// tarea "CMS: construir Home desde fuentes de Notion"). Lee el singleton
// `siteCopy` (pagina "Copy Oficial · diegomaury.mx (SSOT)", columna
// "Version Actual") y parsea sus secciones S1-S8 con parseSiteCopy.ts.
//
// Primer corte (2026-07-24): solo S1 Hero, S2 Quien soy y S3 El problema
// que resuelvo. El resto de las secciones (S4 Evidencia, S5 Como trabajo,
// S6 Sistemas propios, S6b Prueba social, S7 Formas de trabajar, S7b
// Confianza directa) quedan pendientes de un siguiente corte.
//
// Sigue construyendo a dist/, no toca el sitio LIVE (astro.config.mjs).
import { getCollection } from 'astro:content';
import {
  parseSiteCopySections,
  heading1,
  heading2,
  paragraphs,
  ctaLabels,
  valueAfter,
} from '../utils/parseSiteCopy.ts';

const siteCopyEntries = await getCollection('siteCopy');
const siteCopy = siteCopyEntries.find((entry) => entry.id === 'site');
const sections = siteCopy ? parseSiteCopySections(siteCopy.data.markdown) : new Map();

// --- S1 · Hero ---------------------------------------------------------------
const s1 = sections.get('S1')?.blocks ?? [];
const heroName = heading1(s1);
const heroHeadline = heading2(s1);
const heroParas = paragraphs(s1);
const heroRole = heroParas[0] ?? '';
const heroSub = heroParas[1] ?? '';
const heroCtas = ctaLabels(s1);
const heroLogosLine = heroParas[3] ?? '';
const heroLogoNames = heroLogosLine.replace(/^Logos sugeridos:\s*/i, '').split('·').map((s) => s.trim()).filter(Boolean);

const LOGO_MAP: Record<string, { src: string; alt: string }> = {
  HEINEKEN: { src: '/cms-media/logos/heineken-mexico-logo-png_seeklogo-370450.png', alt: 'HEINEKEN Mexico' },
  'Tecnológico de Monterrey': { src: '/cms-media/logos/tec%20de%20monterrey.png', alt: 'Tecnológico de Monterrey' },
  INCmty: { src: '/cms-media/logos/incmty.png', alt: 'INCmty' },
  EBC: { src: '/cms-media/logos/EBC.png', alt: 'EBC' },
  FlipHouse: { src: '/cms-media/logos/Fliphouse_logo1.png', alt: 'FlipHouse' },
};
const heroLogos = heroLogoNames.map((name) => LOGO_MAP[name]).filter(Boolean);

// --- S2 · Quien soy ------------------------------------------------------------
const s2 = sections.get('S2')?.blocks ?? [];
const aboutHeadline = heading2(s2);
const aboutParas = paragraphs(s2);
const aboutTagline = aboutParas[0] ?? '';
const aboutIntro = aboutParas.slice(1, 4);
const aboutRoles = aboutParas.slice(4, 7);
const aboutBio = aboutParas[7] ?? '';
const aboutStatsLine = aboutParas[8] ?? '';
const aboutStats = aboutStatsLine.split('•').map((s) => s.trim()).filter(Boolean);

// --- S3 · El problema que resuelvo ---------------------------------------------
const s3 = sections.get('S3')?.blocks ?? [];
const problemLabel = sections.get('S3')?.label ?? 'El problema que resuelvo';
const problemHeadline = heading2(s3);
// Excluye tambien etiquetas sueltas del diagrama ASCII de "Asi trabajo"
// (ej. "TRADUZCO EN"): nunca aparece prosa en mayusculas en esta seccion.
const problemParas = paragraphs(s3).filter(
  (p) => !p.includes('\n') && !p.startsWith('┌') && p !== p.toUpperCase(),
);
const problemQuote = s3.find((b) => b.trim().startsWith('>'))?.trim().slice(1).trim() ?? '';

// --- SEO -------------------------------------------------------------------
const seo = sections.get('SEO')?.blocks ?? [];
const pageTitle = valueAfter(seo, 'Title') || 'Diego Maury · Strategic Program Director';
const pageDescription =
  valueAfter(seo, 'Meta description') ||
  'Strategic Program Director: diseño programas, procesos y sistemas que convierten la estrategia en ejecución y capacidad organizacional.';
---

<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>{pageTitle}</title>
<meta name="description" content={pageDescription}>
<meta property="og:type" content="website">
<meta property="og:title" content={pageTitle}>
<meta property="og:description" content={pageDescription}>
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content={pageTitle}>
<meta name="twitter:description" content={pageDescription}>
<!--
  Home construido desde Notion (Diego CMS). Fuente: siteCopy singleton,
  parseado por src/utils/parseSiteCopy.ts. Scaffold, no desplegado: construye
  a dist/, no toca el sitio LIVE (astro.config.mjs).
-->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,700;0,800;1,400&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0A0612;
    --bg-2: #1A1128;
    --border: #6A291B;
    --t1: #FAF8FC;
    --t2: #DDDBE0;
    --t3: #A8A6AC;
    --ember: #FF5C39;
    --ember-cta: #BF452B;
    --sans: 'Plus Jakarta Sans', system-ui, sans-serif;
    --mono: 'DM Mono', ui-monospace, monospace;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --wrap: 1160px;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg); color: var(--t1);
    font-family: var(--sans); line-height: 1.6; min-height: 100vh;
    -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;
  }
  a { color: var(--ember); }
  ::selection { background: var(--ember); color: var(--bg); }
  :focus-visible { outline: 2px solid var(--ember); outline-offset: 3px; border-radius: 4px; }

  .wrap { max-width: var(--wrap); margin: 0 auto; padding: 0 32px; }

  .eyebrow {
    font-family: var(--mono); font-size: 10px; font-weight: 500;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--ember);
    display: flex; align-items: center; gap: 10px;
  }
  .eyebrow::before { content: ""; width: 18px; height: 1px; background: var(--ember); }

  /* ── NAV ── */
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: rgba(10,6,18,0.92); backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .nav__inner { height: 60px; display: flex; align-items: center; justify-content: space-between; }
  .nav__brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--t1); font-size: 14px; font-weight: 700; letter-spacing: -0.01em; }
  .nav__mark { width: 22px; height: 22px; background: var(--ember); clip-path: polygon(50% 0%,100% 25%,100% 75%,50% 100%,0% 75%,0% 25%); }
  .nav__badge { font-family: var(--mono); font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--t3); border: 1px solid var(--border); padding: 5px 10px; border-radius: 5px; }

  /* ── HERO ── */
  .hero { padding: 96px 0 64px; }
  .hero__grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 56px; align-items: center; }
  .hero h1 {
    margin-top: 22px; font-size: clamp(2.1rem, 4.4vw, 3.6rem); font-weight: 300;
    letter-spacing: -0.02em; line-height: 1.16; max-width: 20ch;
  }
  .hero h1 .accent { color: var(--ember); }
  .hero p.sub { margin-top: 24px; font-size: 16px; color: var(--t2); max-width: 52ch; line-height: 1.7; }
  .hero__ctas { display: flex; gap: 14px; margin-top: 32px; flex-wrap: wrap; }
  .btn-primary, .btn-ghost {
    font-size: 14px; font-weight: 600; padding: 13px 24px; border-radius: 8px;
    text-decoration: none; transition: transform 160ms var(--ease), border-color 160ms var(--ease);
    display: inline-flex; align-items: center;
  }
  .btn-primary { background: var(--ember-cta); color: #fff; }
  .btn-primary:hover { transform: translateY(-1px); }
  .btn-ghost { border: 1px solid var(--border); color: var(--t1); }
  .btn-ghost:hover { border-color: var(--ember); }
  .hero__media {
    aspect-ratio: 4/5; border-radius: 16px; border: 1px solid var(--border);
    background: var(--bg-2); display: flex; align-items: center; justify-content: center;
    color: var(--t3); font-size: 12px; font-family: var(--mono); overflow: hidden;
  }
  .hero__media img { width: 100%; height: 100%; object-fit: cover; }

  .trust { margin-top: 64px; border-top: 1px solid var(--border); padding-top: 28px; }
  .trust__label { font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--t3); margin-bottom: 16px; }
  .trust__row { display: flex; flex-wrap: wrap; gap: 28px; align-items: center; }
  .trust__row img { height: 24px; width: auto; filter: grayscale(1) brightness(1.6); opacity: 0.7; }

  /* ── QUIEN SOY ── */
  .about { padding: 88px 0; background: var(--bg-2); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .about__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; }
  .about__tagline { font-family: var(--mono); font-size: 12px; letter-spacing: 0.06em; color: var(--ember); text-transform: uppercase; margin-bottom: 16px; }
  .about h2 { font-size: clamp(1.6rem, 2.8vw, 2.2rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.25; margin-bottom: 20px; }
  .about p { color: var(--t2); font-size: 15px; line-height: 1.75; margin-bottom: 16px; }
  .about__roles { margin-top: 24px; display: flex; flex-direction: column; gap: 14px; }
  .about__role { display: flex; gap: 12px; font-size: 14px; color: var(--t2); line-height: 1.6; }
  .about__role-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--ember); margin-top: 8px; flex-shrink: 0; }
  .about__bio { font-size: 15px; color: var(--t2); line-height: 1.75; }
  .about__stats { margin-top: 32px; display: flex; gap: 32px; flex-wrap: wrap; }
  .about__stat { font-family: var(--mono); font-size: 13px; color: var(--t3); }

  /* ── PROBLEMA ── */
  .problem { padding: 96px 0; }
  .problem h2 { margin-top: 14px; font-size: clamp(1.6rem, 2.8vw, 2.2rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.3; max-width: 26ch; }
  .problem p { margin-top: 20px; font-size: 15px; color: var(--t2); line-height: 1.75; max-width: 68ch; }
  .problem blockquote {
    margin-top: 40px; padding: 28px 32px; border-left: 2px solid var(--ember);
    background: var(--bg-2); border-radius: 0 10px 10px 0; font-size: 16px;
    color: var(--t1); font-weight: 500; line-height: 1.6;
  }

  @media (max-width: 860px) {
    .hero__grid, .about__grid { grid-template-columns: 1fr; }
    .hero__media { max-width: 320px; margin: 0 auto; }
  }
</style>
</head>
<body>

<nav class="nav" aria-label="Navegación principal">
  <div class="wrap nav__inner">
    <a href="#hero" class="nav__brand">
      <span class="nav__mark" aria-hidden="true"></span>
      <span>Diego Maury</span>
    </a>
    <span class="nav__badge">DIEGO CMS · HOME · FASE 1</span>
  </div>
</nav>

<section class="hero" id="hero">
  <div class="wrap">
    <div class="hero__grid">
      <div>
        <div class="eyebrow">{heroRole || 'Strategic Program Director'}</div>
        <h1>{heroHeadline || `${heroName} — Diseño programas, procesos y sistemas para convertir la visión en resultados tangibles.`}</h1>
        {heroSub && <p class="sub">{heroSub}</p>}
        {heroCtas.length > 0 && (
          <div class="hero__ctas">
            <a href="https://calendar.notion.so/meet/diegomaurymx/5aad3vun" class="btn-primary" target="_blank" rel="noopener">{heroCtas[0]}</a>
            {heroCtas[1] && <a href="/cv/diego-maury-cv.pdf" class="btn-ghost" download>{heroCtas[1]}</a>}
          </div>
        )}
      </div>
      <div class="hero__media">
        <img src="/cms-media/diego/diegomaurypng.png" alt={heroName || 'Diego Maury'} loading="eager" fetchpriority="high" width="700" height="875">
      </div>
    </div>
    {heroLogos.length > 0 && (
      <div class="trust">
        <div class="trust__label">He trabajado con</div>
        <div class="trust__row">
          {heroLogos.map((logo) => <img src={logo.src} alt={logo.alt} loading="lazy">)}
        </div>
      </div>
    )}
  </div>
</section>

<section class="about" id="quien-soy">
  <div class="wrap about__grid">
    <div>
      <div class="about__tagline">{aboutTagline}</div>
      <h2>{aboutHeadline}</h2>
      {aboutIntro.map((p) => <p>{p}</p>)}
      <div class="about__roles">
        {aboutRoles.map((role) => (
          <div class="about__role">
            <div class="about__role-dot"></div>
            <div>{role}</div>
          </div>
        ))}
      </div>
    </div>
    <div>
      <p class="about__bio">{aboutBio}</p>
      {aboutStats.length > 0 && (
        <div class="about__stats">
          {aboutStats.map((stat) => <div class="about__stat">{stat}</div>)}
        </div>
      )}
    </div>
  </div>
</section>

<section class="problem" id="problema">
  <div class="wrap">
    <div class="eyebrow">{problemLabel}</div>
    <h2>{problemHeadline}</h2>
    {problemParas.map((p) => <p>{p}</p>)}
    {problemQuote && <blockquote>{problemQuote}</blockquote>}
  </div>
</section>

</body>
</html>
