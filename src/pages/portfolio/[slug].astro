---
// Pagina individual de caso (Fase 2 · Diego CMS, punto 3; migrada a BaseLayout
// 2026-08-02 tras Design Lab: Navbar/Footer compartidos eran obligatorios y
// esta pagina no los tenia). El contenido narrativo (Contexto, Problema,
// Sistema, Evidencia, etc.) sale del `body` de cada ficha en Notion
// (Plantilla v2), no de datos hardcodeados.
// Solo se generan paginas para fichas publicadas (draft=false); Draft/Archivo
// no tienen ruta propia.
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { renderMarkdown, extractSections } from '../../utils/markdown.ts';
import { slugify } from '../../utils/slug.ts';
import '../../styles/case.css';

type CaseEntry = CollectionEntry<'cases'>;

export async function getStaticPaths() {
  const allCases = await getCollection('cases');
  const published = allCases.filter((c) => !c.data.draft);
  return published.map((entry) => ({
    params: { slug: slugify(entry.data.title) },
    props: { entry, allCases },
  }));
}

interface Props {
  entry: CaseEntry;
  allCases: CaseEntry[];
}

const { entry, allCases } = Astro.props as Props;
const idToTitle = new Map(allCases.map((c) => [c.id, c.data.title]));

const displayTitle = entry.data.resultHeadline || entry.data.title;

// El <title> de pestana/SERP necesita ser corto (<=60 car., ver
// docs/platform/seo-keyword-mapping-2026-08-03.md hallazgo tecnico 2): usar el
// resultHeadline narrativo completo aqui lo duplicaba con ~118 caracteres. El
// H1 visible (displayTitle arriba) SI sigue usando el resultHeadline completo,
// sin cambios. Match por nombre interno del caso, mismo patron que
// caseLink/systemsLogo en index.astro.
const SEO_SHORT_TITLES: Record<string, string> = {
  heineken: 'HEINEKEN Green Challenge · Innovación · Diego Maury',
  redux: 'REDUX · Bootcamp de economía circular · Diego Maury',
  hacksureste: 'HackSureste · Hackathon del sureste mexicano · Diego Maury',
  sofi: 'SOFI · Automatización comercial con IA · Diego Maury',
};
function seoTitle(title: string): string {
  const key = title.toLowerCase();
  const match = Object.entries(SEO_SHORT_TITLES).find(([k]) => key.includes(k));
  return match ? match[1] : `${title} · Diego Maury`;
}
const bodyHtml = renderMarkdown(entry.data.body);
const sections = extractSections(entry.data.body);
const editionTitles = entry.data.editions
  .map((id) => idToTitle.get(id))
  .filter((title): title is string => Boolean(title));

const DESCRIPTION_MAX = 155;
const rawDescription = entry.data.objective || entry.data.cardContext || entry.data.role;
const pageDescription =
  rawDescription.length > DESCRIPTION_MAX
    ? `${rawDescription.slice(0, DESCRIPTION_MAX)}…`
    : rawDescription;
const canonicalUrl = new URL(`/portfolio/${slugify(entry.data.title)}`, Astro.site).toString();

const creativeWorkJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: displayTitle,
  description: pageDescription,
  url: canonicalUrl,
  author: { '@type': 'Person', name: 'Diego Maury', url: 'https://diegomaury.mx' },
  ...(entry.data.banner ? { image: entry.data.banner } : {}),
};
---

<BaseLayout
  title={seoTitle(entry.data.title)}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  ogType="article"
  ogImage={entry.data.banner}
  jsonLd={creativeWorkJsonLd}
  enableGtm
>
  {entry.data.banner && (
    <div class="case-hero">
      <img src={entry.data.banner} alt={entry.data.title} width="1600" height="320" />
      {entry.data.logo && <img class="case-hero__logo" src={entry.data.logo} alt="" aria-hidden="true" width="56" height="56" />}
    </div>
  )}

  <div class="wrap-case">
    <div class="case-split">
      <aside class="case-rail">
        <div class="meta">{entry.data.organization ?? '—'} · {entry.data.year ?? '—'} · {entry.data.type ?? '—'}</div>
        <h1>{displayTitle}</h1>

        <div class="rail-block">
          <div class="label">Evidencia</div>
          {entry.data.hasVerifiedEvidence ? (
            <span class="badge--ok">✔ Verificada en este caso</span>
          ) : (
            <span class="badge--no">✖ Pendiente de verificar</span>
          )}
        </div>

        <div class="rail-block">
          <div class="label">Métrica ancla</div>
          <p>{entry.data.anchorMetric || 'Sin métrica ancla registrada'}</p>
        </div>

        {sections.length > 0 && (
          <nav class="rail-nav" aria-label="Secciones del caso">
            {sections.map((section) => (
              <a href={`#${section.id}`} data-rail-link>{section.title}</a>
            ))}
          </nav>
        )}
      </aside>

      <div class="case-prose">
        {bodyHtml ? (
          <div set:html={bodyHtml} />
        ) : (
          <p class="case-empty-note">Esta ficha todavía no tiene el cuerpo narrativo (Contexto, Problema, Sistema, Evidencia) escrito en Notion.</p>
        )}
      </div>
    </div>

    {(entry.data.evidenceMedia.length > 0 || entry.data.evidenceVideos.length > 0) && (
      <section class="case-evidence-media">
        <div class="eyebrow">Evidencia visual</div>
        {entry.data.evidenceMedia.length > 0 && (
          <div class="evidence-photo-grid">
            {entry.data.evidenceMedia.map((src) => (
              <a class="evidence-photo" href={src} target="_blank" rel="noopener">
                <img src={src} alt="" loading="lazy" width="400" height="300" />
              </a>
            ))}
          </div>
        )}
        {entry.data.evidenceVideos.length > 0 && (
          <div class="evidence-video-list">
            {entry.data.evidenceVideos.map((video) => (
              <a class="evidence-video-link" href={video.url} target="_blank" rel="noopener">{video.label}</a>
            ))}
          </div>
        )}
      </section>
    )}

    {editionTitles.length > 0 && (
      <section class="case-archive">
        <div class="eyebrow">Archivo de este caso</div>
        <div class="case-archive__row">
          {editionTitles.map((title) => <span class="case-archive__chip">{title}</span>)}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<script is:inline>
(function () {
  const links = document.querySelectorAll('[data-rail-link]');
  if (!links.length) return;

  const targets = [...links]
    .map((link) => document.querySelector(link.getAttribute('href') ?? ''))
    .filter(Boolean);

  if (!targets.length) return;

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        links.forEach((link) => {
          link.classList.toggle('is-active', link.getAttribute('href') === `#${entry.target.id}`);
        });
      });
    },
    { rootMargin: '-20% 0px -70% 0px' }
  );

  targets.forEach((target) => observer.observe(target));
})();
</script>
