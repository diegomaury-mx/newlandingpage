<!-- S6b PRUEBA SOCIAL -->
<section class="section" id={SECTION_IDS.S6b}>
  <div class="section-inner">
    <div class="section-label" data-reveal>{testimonialsLabelEn}</div>
    <h2 class="section-title" data-reveal style="--delay:.06s">{testimonialsHeadlineEn}</h2>

