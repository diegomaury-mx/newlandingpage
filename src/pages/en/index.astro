---
// Version /en del home (src/pages/index.astro). El parseo del markdown de
// Notion (lineas hasta el separador `---` de abajo) es una copia EXACTA,
// SIN MODIFICAR, de la logica de index.astro: los matches literales en
// espanol (`blocksAfterHeading(s5, '## Mi modelo de intervención')`,
// `valueAfter(s4, 'Centro')`, etc.) siguen operando sobre el markdown
// espanol crudo, tal cual sale de Notion — cero riesgo de romper el parseo.
// La traduccion a ingles ocurre DESPUES, a nivel de hoja (cada string ya
// extraido pasa por `t()`, que traduce via DeepL con cache), nunca sobre el
// markdown crudo. Ver hallazgo documentado en la sesion 2026-08-17.
//
// Simplificaciones conocidas frente a la version ES (documentadas, no bugs):
// - El acento ember sobre una frase especifica del H1 ("resultados
//   tangibles") depende de un match literal en espanol; en EN se pierde el
//   span de acento (el H1 se ve completo, sin subrayado de color).
// - Los titulos de "Sistemas propios"/testimonios usan el titulo ORIGINAL en
//   espanol (no el traducido) para resolver logo/link — nombres propios
//   (REDUX, SOFI, HackSureste, nombres de personas) nunca se traducen.
import { getCollection } from 'astro:content';
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/home.css";
import {
  parseSiteCopySections,
  heading1,
  heading2,
  paragraphs,
  ctaLabels,
  valueAfter,
  blocksBeforeHeading,
  blocksAfterHeading,
  bulletItems,
  headingCards,
  testimonials,
  firstCodeBlock,
  parseFlowDiagram,
} from '../../utils/parseSiteCopy.ts';
import { translateCached } from '../../services/deeplTranslationCache.ts';
import { toLocalePath } from '../../utils/locale.ts';
import { uiEn } from '../../i18n/ui.ts';
import {
  SECTION_IDS,
  heroLogosFrom,
  systemsLogo,
  evidenceNodesFrom,
  systemsCaseLink,
  ctaTarget,
} from '../../utils/homeContent.ts';

function t(text: string): Promise<string> {
  return text.trim() ? translateCached(text, 'EN-US', console) : Promise.resolve(text);
}
async function tAll(items: string[]): Promise<string[]> {
  return Promise.all(items.map(t));
}

const siteCopyEntries = await getCollection('siteCopy');
const siteCopy = siteCopyEntries.find((entry) => entry.id === 'site');
const sections = siteCopy ? parseSiteCopySections(siteCopy.data.markdown) : new Map();

const metricsEntries = await getCollection('metrics');
const incmtyMetric = metricsEntries.find((entry) => entry.id === 'incmty-participantes-inscritos');

const imageSlotEntries = await getCollection('imageSlots');
function slotSrc(slotId: string, fallback: string): string {
  const entry = imageSlotEntries.find((e) => e.id === slotId);
  return entry?.data.status === 'Listo' && entry.data.imageUrl ? entry.data.imageUrl : fallback;
}

const problemaDiagramaSlot = imageSlotEntries.find((e) => e.id === 'diagrama-problema');
const problemaDiagramaReady = Boolean(problemaDiagramaSlot?.data.status === 'Listo' && problemaDiagramaSlot.data.imageUrl);

// --- S1 · Hero (parseo ES sin modificar) --------------------------------------
const s1 = sections.get('S1')?.blocks ?? [];
const heroName = heading1(s1);
const heroHeadline =
  heading2(s1) ||
  `${heroName}. Diseño programas, procesos y sistemas para convertir la visión en resultados tangibles.`;
const heroParas = paragraphs(s1);
const heroRole = heroParas[0] ?? '';
const heroSub = heroParas[1] ?? '';
const heroCtas = ctaLabels(s1);

const heroLogos = heroLogosFrom(imageSlotEntries);

// --- S2 · Quien soy (parseo ES sin modificar) ---------------------------------
const s2 = sections.get('S2')?.blocks ?? [];
const aboutHeadline = heading2(s2);
const aboutParas = paragraphs(s2);
const aboutTagline = aboutParas[0] ?? '';
const aboutIntro = aboutParas.slice(1, 4);
const aboutRoles = aboutParas.slice(4, 7);
const aboutBio = aboutParas[7] ?? '';
const aboutStatsLine = aboutParas[8] ?? '';
const aboutStatsRaw = aboutStatsLine.split('•').map((s) => s.trim()).filter(Boolean);
const STAT_SUBLABELS_EN = [
  uiEn.home.statAccumulatedTrajectory,
  uiEn.home.statInnovationEcosystems,
  incmtyMetric?.data.en.mandatoryQualifier || incmtyMetric?.data.mandatoryQualifier || 'Aggregate of INCmty programs (HGC included), estimated',
];
const aboutStatsRawEn = await tAll(aboutStatsRaw);
const aboutStats = aboutStatsRawEn.map((raw, i) => {
  const match = raw.match(/^([\d.,]+\+?)\s*(.+)$/);
  const n = match ? match[1] : raw;
  const l = match ? match[2] : '';
  const countTo = i === 2 ? (incmtyMetric?.data.value ?? n).replace(/\D/g, '') : '';
  return { n, l, s: STAT_SUBLABELS_EN[i] ?? '', countTo };
});

// --- S3 · El problema que resuelvo (parseo ES sin modificar) ------------------
const s3 = sections.get('S3')?.blocks ?? [];
const problemLabel = sections.get('S3')?.label ?? 'El problema que resuelvo';
const problemHeadline = heading2(s3);
const problemParas = paragraphs(s3).filter(
  (p) => !p.includes('\n') && !p.startsWith('┌') && p !== p.toUpperCase(),
);
const problemQuote = s3.find((b: string) => b.trim().startsWith('>'))?.trim().slice(1).trim() ?? '';
const problemDiagram = parseFlowDiagram(firstCodeBlock(s3));

// --- S4 · Evidencia (parseo ES sin modificar) ---------------------------------
const s4 = sections.get('S4')?.blocks ?? [];
const evidenceLabel = sections.get('S4')?.label ?? 'Evidencia';
const evidenceTitle = heading1(s4);
const evidenceIntroText = paragraphs(blocksBeforeHeading(s4, ['Centro']))[0] ?? '';
const evidenceCenterNode = valueAfter(s4, 'Centro');
const evidenceFieldLabels = firstCodeBlock(s4)
  .split('\n')
  .map((line) => line.trim())
  .filter(Boolean);
const afterFieldsFence = blocksAfterHeading(blocksAfterHeading(s4, '```'), '```');
const evidenceClosing = paragraphs(afterFieldsFence)[0] ?? '';
const EVIDENCE_FIELDS = evidenceFieldLabels.map((label, i) => ({ key: `field-${i}`, label }));
const evidenceNodesEs = evidenceNodesFrom(EVIDENCE_FIELDS);

// --- S5 · Como trabajo (parseo ES sin modificar) ------------------------------
const s5 = sections.get('S5')?.blocks ?? [];
const workLabel = sections.get('S5')?.label ?? 'Cómo trabajo';
const workHeadline = heading1(s5);
const workIntro = paragraphs(blocksBeforeHeading(s5, ['## Mi modelo de intervención']));
const afterModel = blocksAfterHeading(s5, '## Mi modelo de intervención');
const workSteps = headingCards(blocksBeforeHeading(afterModel, ['## Lo que entrego']), '### ');
const afterDeliver = blocksAfterHeading(s5, '## Lo que entrego');
const deliverIntro = paragraphs(afterDeliver);
const deliverItems = bulletItems(afterDeliver);

// --- S6 · Sistemas propios (parseo ES sin modificar) --------------------------
const s6 = sections.get('S6')?.blocks ?? [];
const systemsLabel = sections.get('S6')?.label ?? 'Sistemas propios';
const systemsHeadline = heading1(s6);
const systemsIntro = paragraphs(blocksBeforeHeading(s6, ['## REDUX']));
const systemsCards = headingCards(blocksBeforeHeading(s6, ['## El verdadero entregable']), '## ');
const systemsClosingHeading =
  s6.find((b: string) => b.trim().startsWith('## El verdadero entregable'))?.trim().slice(3).trim() ??
  'El verdadero entregable';
const systemsClosing = paragraphs(blocksAfterHeading(s6, '## El verdadero entregable'));

// --- S6b · Prueba social (parseo ES sin modificar) ----------------------------
const s6b = sections.get('S6b')?.blocks ?? [];
const testimonialsLabel = sections.get('S6b')?.label ?? 'Prueba social';
const testimonialsHeadline = heading1(s6b);
const testimonialsIntro = paragraphs(blocksBeforeHeading(s6b, ['>']));
const testimonialItems = testimonials(s6b);
const moreExperiencesHeading =
  s6b.find((b: string) => b.trim() === '## Más experiencias')
    ?.replace(/^##\s*/, '') ?? '';
const moreExperiences = blocksAfterHeading(s6b, '## Más experiencias');
const senjaId = moreExperiences[0]?.trim();

// --- Destinos de CTA (ver homeContent.ts, resueltos por la etiqueta ORIGINAL en espanol) ---

// --- S8 · Siguiente paso (parseo ES sin modificar) ----------------------------
const s8 = sections.get('S8')?.blocks ?? [];
const finalLabel = sections.get('S8')?.label ?? 'Siguiente paso';
const finalHeadline = heading2(s8);
const finalIntro = paragraphs(blocksBeforeHeading(s8, ['### ']));
const finalStepCards = headingCards(s8, '### ');
const finalSteps = finalStepCards.map((card) => ({
  title: card.title,
  description: card.paragraphs[0] ?? '',
  tag: card.paragraphs[1] ?? '',
}));
const afterSteps = finalStepCards.length
  ? blocksAfterHeading(s8, `### ${finalStepCards[finalStepCards.length - 1].title}`)
  : [];
const finalCtas = ctaLabels(afterSteps);
const finalTrustLine = afterSteps.find((b) => b.includes('·') && !ctaLabels([b]).length)?.trim() ?? '';
const finalTrustParts = finalTrustLine.split('·').map((s) => s.trim()).filter(Boolean);

// --- SEO (parseo ES sin modificar) --------------------------------------------
const seo = sections.get('SEO')?.blocks ?? [];
const seoTitleEs = valueAfter(seo, 'Title');
const seoDescriptionEs = valueAfter(seo, 'Meta description');

// ═══════════════════════════════════════════════════════════════════════════
// Traduccion a nivel de hoja (DeepL, cacheada) — todo lo de arriba es ES puro.
// ═══════════════════════════════════════════════════════════════════════════

const heroHeadlineEn = await t(heroHeadline);
const heroRoleEn = await t(heroRole);
const heroSubEn = await t(heroSub);
const heroCtasEn = await tAll(heroCtas);

const aboutHeadlineEn = await t(aboutHeadline);
const aboutTaglineEn = await t(aboutTagline);
const aboutIntroEn = await tAll(aboutIntro);
const aboutRolesEn = await tAll(aboutRoles);
const aboutBioEn = await t(aboutBio);

const problemLabelEn = await t(problemLabel);
const problemHeadlineEn = await t(problemHeadline);
const problemParasEn = await tAll(problemParas);
const problemQuoteEn = await t(problemQuote);
const problemDiagramEn = problemDiagram && {
  fromLabel: await t(problemDiagram.fromLabel),
  connectorLabel: await t(problemDiagram.connectorLabel),
  toLabel: await t(problemDiagram.toLabel),
};

const evidenceLabelEn = await t(evidenceLabel);
const evidenceTitleEn = await t(evidenceTitle);
const evidenceIntroTextEn = await t(evidenceIntroText);
const evidenceCenterNodeEn = await t(evidenceCenterNode);
const evidenceClosingEn = await t(evidenceClosing);
const evidenceNodes = await Promise.all(
  evidenceNodesEs.map(async (n) => ({ ...n, label: await t(n.label) })),
);

const workLabelEn = await t(workLabel);
const workHeadlineEn = await t(workHeadline);
const workIntroEn = await tAll(workIntro);
const workStepsEn = await Promise.all(
  workSteps.map(async (step) => {
    const [n, ...titleParts] = step.title.split('·');
    const titlePart = titleParts.join('·').trim() || step.title;
    return {
      n: n.trim(),
      title: await t(titlePart),
      paragraph: await t(step.paragraphs[0] ?? ''),
    };
  }),
);
const deliverIntroEn = await tAll(deliverIntro);
const deliverItemsEn = await tAll(deliverItems);

const systemsLabelEn = await t(systemsLabel);
const systemsHeadlineEn = await t(systemsHeadline);
const systemsIntroEn = await tAll(systemsIntro);
const systemsCardsEn = await Promise.all(
  systemsCards.map(async (card) => ({
    originalTitle: card.title,
    title: await t(card.title),
    paragraphs: await tAll(card.paragraphs),
  })),
);
const systemsClosingHeadingEn = await t(systemsClosingHeading);
const systemsClosingEn = await tAll(systemsClosing);

const testimonialsLabelEn = await t(testimonialsLabel);
const testimonialsHeadlineEn = await t(testimonialsHeadline);
const testimonialsIntroEn = await tAll(testimonialsIntro);
const testimonialItemsEn = await Promise.all(
  testimonialItems.map(async (item) => ({
    quote: await t(item.quote),
    name: item.name,
    roleLines: item.roleLines,
  })),
);
const moreExperiencesHeadingEn = await t(moreExperiencesHeading);

const finalLabelEn = await t(finalLabel);
const finalHeadlineEn = await t(finalHeadline);
const finalIntroEn = await tAll(finalIntro);
const finalStepsEn = await Promise.all(
  finalSteps.map(async (step) => ({
    title: await t(step.title),
    description: await t(step.description),
    tag: await t(step.tag),
  })),
);
const finalCtasEn = await tAll(finalCtas);
const finalTrustPartsEn = await tAll(finalTrustParts);

const pageTitle = (seoTitleEs && (await t(seoTitleEs))) || uiEn.home.fallbackTitle;
const pageDescription = (seoDescriptionEs && (await t(seoDescriptionEs))) || uiEn.home.fallbackDescription;
const canonicalUrl = new URL('/en', Astro.site).toString();
const esUrl = new URL('/', Astro.site).toString();
const ogImage = new URL('/assets/img/diego-maury.png', Astro.site).toString();
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Diego Maury',
  url: 'https://diegomaury.mx',
  jobTitle: 'Strategic Program Director',
  sameAs: ['https://www.linkedin.com/in/diegomaury/'],
  knowsAbout: uiEn.home.knowsAbout,
};
---
<BaseLayout
  canonicalUrl={canonicalUrl}
  jsonLd={personJsonLd}
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImage}
  alternateUrls={[{ lang: 'es', url: esUrl }, { lang: 'en', url: canonicalUrl }]}
  otherLocaleHref={toLocalePath(Astro.url.pathname, 'es')}
  ctaLabel={uiEn.nav.ctaLabel}
>
<!-- Google Tag Manager -->
<script is:inline src="/js/gtm.js"></script>
<!-- End Google Tag Manager -->

<!-- S1 HERO -->
<section class="section" id={SECTION_IDS.S1}>
  <div class="section-inner">
    <div class="hero-grid">
      <div>
        <div class="hero-label" data-reveal>{heroRoleEn || 'Strategic Program Director'}</div>
        <h1 class="hero-h1" data-reveal style="--delay:.08s">{heroHeadlineEn}</h1>
        {heroSubEn && <p class="hero-sub" data-reveal style="--delay:.14s">{heroSubEn}</p>}
        {heroCtas.length > 0 && (
          <div class="hero-ctas" data-reveal style="--delay:.2s">
            {heroCtas.map((originalLabel, i) => {
              const target = ctaTarget(originalLabel, '/en/portfolio');
              return (
                <a
                  href={target.href}
                  class={i === 0 ? 'btn-primary' : 'btn-ghost'}
                  download={target.download}
                  target={target.external ? '_blank' : undefined}
                  rel={target.external ? 'noopener' : undefined}
                >{heroCtasEn[i]}</a>
              );
            })}
          </div>
        )}
      </div>
      <div class="hero-media" data-reveal style="--delay:.1s">
        <img src={slotSrc('foto-diego-hero', '/cms-media/diego/diegomaurypng.png')} alt={heroName || 'Diego Maury'} loading="eager" fetchpriority="high" width="700" height="875">
      </div>
    </div>
    {heroLogos.length > 0 && (
      <div class="trust" data-reveal style="--delay:.32s">
        <div class="trust-label">{uiEn.home.trustLabel}</div>
        <div class="trust-track-wrap">
          <div class="trust-track">
            {heroLogos.map((logo) => <div class="trust-logo"><img src={logo.src} alt={logo.alt} loading="lazy"></div>)}
            {heroLogos.map((logo) => <div class="trust-logo" aria-hidden="true"><img src={logo.src} alt="" loading="lazy"></div>)}
          </div>
        </div>
      </div>
    )}
  </div>
</section>

<!-- S2 QUIEN SOY -->
<section class="about-section" id={SECTION_IDS.S2}>
  <div class="about-body">
    <div class="about-header" data-reveal>
      <div class="about-name">{heroName || 'Diego Maury'}</div>
      {heroRoleEn && <div class="about-title-txt">{heroRoleEn}</div>}
      {aboutTaglineEn && <p class="about-tagline">{aboutTaglineEn}</p>}
    </div>

    {aboutIntroEn.length > 0 && (
      <div class="about-intro-full" data-reveal style="--delay:.14s">
        {aboutIntroEn.map((p) => <p class="about-intro-p">{p}</p>)}
      </div>
    )}

    {aboutRolesEn.length > 0 && (
      <div class="about-roles" data-reveal style="--delay:.18s">
        {aboutRolesEn.map((role) => (
          <div class="about-role">
            <div class="about-role-dot"></div>
            <div class="about-role-txt">{role}</div>
          </div>
        ))}
      </div>
    )}

    <div class="about-photo-wrap" data-reveal style="--delay:.1s">
      <div class="about-circle-bg"></div>
      <div class="about-photo-slot">
        <img src={slotSrc('foto-diego-about', '/cms-media/diego/diegomaurypng.png')} width="700" height="700" alt={heroName || 'Diego Maury'} loading="lazy">
      </div>
    </div>

    <div class="about-right" data-reveal style="--delay:.22s">
      {aboutBioEn && <p class="about-bio">{aboutBioEn}</p>}
      {aboutHeadlineEn && <p class="about-bio">{aboutHeadlineEn}</p>}
    </div>
  </div>
  {aboutStats.length > 0 && (
    <div style="max-width:1160px;margin:0 auto;padding:0 32px">
      <div class="metrics" data-reveal style="--delay:.26s">
        {aboutStats.map((stat) => (
          <div class="metric">
            <div class="metric-n" data-count={stat.countTo || undefined}>{stat.n}</div>
            <div class="metric-l">{stat.l}</div>
            {stat.s && <div class="metric-s">{stat.s}</div>}
          </div>
        ))}
      </div>
    </div>
  )}
</section>

<!-- S3 EL PROBLEMA QUE RESUELVO -->
<section class="section" id={SECTION_IDS.S3}>
  <div class="section-inner">
    <div class="problema-grid">
      <div class="problema-copy">
        <div class="section-label" data-reveal>{problemLabelEn}</div>
        <h2 class="section-title problema-title" data-reveal style="--delay:.06s">{problemHeadlineEn}</h2>
        {problemParasEn.map((p) => <p class="section-sub" data-reveal>{p}</p>)}
      </div>
      <div class="problema-media" data-reveal style="--delay:.1s">
        {problemaDiagramaReady ? (
          <img src={problemaDiagramaSlot!.data.imageUrl} alt={uiEn.home.problemDiagramAlt} loading="lazy">
        ) : (
          <svg viewBox="0 0 200 160" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={uiEn.home.problemDiagramAlt}>
            <circle cx="40" cy="30" r="16" stroke="var(--border)" stroke-width="2" fill="var(--bg)"></circle>
            <circle cx="160" cy="30" r="16" stroke="var(--border)" stroke-width="2" fill="var(--bg)"></circle>
            <circle cx="100" cy="130" r="24" stroke="var(--ember)" stroke-width="2.5" fill="rgba(255,92,57,0.1)"></circle>
            <line x1="46" y1="44" x2="90" y2="112" stroke="var(--border)" stroke-width="2"></line>
            <line x1="154" y1="44" x2="110" y2="112" stroke="var(--border)" stroke-width="2"></line>
            <line x1="56" y1="30" x2="144" y2="30" stroke="var(--border)" stroke-width="2" stroke-dasharray="4 5"></line>
          </svg>
        )}
      </div>
    </div>

    {problemDiagramEn && (
      <div class="problem-flow" data-reveal style="--delay:.22s">
        <div class="problem-flow-row">
          <span class="problem-flow-line"></span>
          <div class="problem-flow-node problem-flow-node-start">
            <span class="problem-flow-dot"></span>{problemDiagramEn.fromLabel}
          </div>
          <div class="problem-flow-center">
            <span class="problem-flow-center-label">{problemDiagramEn.connectorLabel}</span>
            <span class="problem-flow-center-arrow">›</span>
          </div>
          <div class="problem-flow-node problem-flow-node-end">
            <span class="problem-flow-dot"></span>{problemDiagramEn.toLabel}
          </div>
        </div>
      </div>
    )}

    {problemQuoteEn && <p class="problema-quote" data-reveal style="--delay:.28s">{problemQuoteEn}</p>}
  </div>
</section>

<!-- S4 EVIDENCIA -->
<section class="section" id={SECTION_IDS.S4}>
  <div class="section-inner">
    <div class="evidence-grid">
      <div class="evidence-copy">
        <div class="section-label" data-reveal>{evidenceLabelEn}</div>
        {evidenceTitleEn && <h2 class="section-title" data-reveal style="--delay:.06s">{evidenceTitleEn}</h2>}
        {evidenceIntroTextEn && <p class="section-sub" data-reveal style="--delay:.1s">{evidenceIntroTextEn}</p>}
        {evidenceClosingEn && <p class="section-sub evidence-closing" data-reveal style="--delay:.3s">{evidenceClosingEn}</p>}
      </div>

      {evidenceCenterNodeEn && evidenceNodes.length > 0 && (
        <div class="evidence-radial" data-reveal style="--delay:.18s" id="evidenceRadial">
          <svg class="evidence-radial-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            {evidenceNodes.map((n) => (
              <line class="evidence-line" data-field={n.key} x1={n.lineStart.x} y1={n.lineStart.y} x2={n.dot.x} y2={n.dot.y}></line>
            ))}
            {evidenceNodes.map((n) => (
              <circle class="evidence-dot" data-field={n.key} cx={n.dot.x} cy={n.dot.y} r="1.4"></circle>
            ))}
          </svg>
          {evidenceCenterNodeEn && (
            <div class="evidence-radial-center">
              <span>{evidenceCenterNodeEn}</span>
            </div>
          )}
          <ul class="evidence-fields">
            {evidenceNodes.map((n, i) => (
              <li
                class={`evidence-field evidence-field-${i}`}
                style={`--fx:${n.node.x}%; --fy:${n.node.y}%`}
                data-field={n.key}
                tabindex="0"
              >
                {n.label}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>
</section>

<!-- S5 CÓMO TRABAJO -->
<section class="section" id={SECTION_IDS.S5}>
  <div class="section-inner">
    <div class="section-label" data-reveal>{workLabelEn}</div>
    <h2 class="section-title" data-reveal style="--delay:.06s">{workHeadlineEn}</h2>
    {workIntroEn.map((p) => <p class="section-sub" data-reveal>{p}</p>)}

    {workStepsEn.length > 0 && (
      <div class="accordion-wrap" data-reveal style="--delay:.18s">
        <div class="accordion-list" id="accList">
          {workStepsEn.map((step, i) => (
            <div class={`acc-item${i === 0 ? ' is-active' : ''}`} data-n={step.n} data-t={step.title}>
              <button type="button" class="acc-item-head">
                <span class="acc-item-n">{step.n}</span>
                <span class="acc-item-t">{step.title}</span>
              </button>
              <div class="acc-detail">
                <div class="acc-d">{step.paragraph}</div>
              </div>
            </div>
          ))}
        </div>
        <div class="acc-panel" id="accPanel">
          <div class="acc-panel-n">{workStepsEn[0]?.n}</div>
          <div class="acc-panel-t">{workStepsEn[0]?.title}</div>
          <div class="acc-panel-d">{workStepsEn[0]?.paragraph}</div>
          <div class="acc-pips">
            {workStepsEn.map((_, i) => <span class={`acc-pip${i === 0 ? ' is-active' : ''}`}></span>)}
          </div>
        </div>
      </div>
    )}

    <h3 class="deliver-heading">{uiEn.home.deliverHeading}</h3>
    {deliverIntroEn.map((p) => <p class="section-sub">{p}</p>)}
    {deliverItemsEn.length > 0 && (
      <div class="about-roles">
        {deliverItemsEn.map((item) => (
          <div class="about-role">
            <div class="about-role-dot"></div>
            <div class="about-role-txt">{item}</div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>

