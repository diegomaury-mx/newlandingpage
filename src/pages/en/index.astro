<!-- S8 SIGUIENTE PASO -->
<section class="section cta-section" id={SECTION_IDS.S8}>
    <div class="section-inner cta-inner">
      <div class="cta-label-center" data-reveal>{finalLabelEn}</div>
      <h2 class="cta-h" data-reveal style="--delay:.06s">{finalHeadlineEn}</h2>
      {finalIntroEn.map((p) => <p class="cta-sub" data-reveal>{p}</p>)}

      {finalStepsEn.length > 0 && (
        <div class="cta-steps" data-reveal style="--delay:.18s">
          {finalStepsEn.map((step) => (
            <div class="cta-step">
              <div class="cta-step-n">{step.title}</div>
              {step.description && <div class="cta-step-d">{step.description}</div>}
              {step.tag && <div class="cta-step-tag">{step.tag}</div>}
            </div>
          ))}
        </div>
      )}

      <div class="cta-buttons" data-reveal style="--delay:.24s">
        {finalCtas.length > 0 && (
          <div class="hero-ctas" style="justify-content:center;margin-bottom:0">
            {finalCtas.map((originalLabel, i) => {
              const target = ctaTarget(originalLabel, '/en/portfolio');
              return (
                <a
                  href={target.href}
                  class={i === 0 ? 'btn-primary' : 'btn-ghost'}
                  download={target.download}
                  target={target.external ? '_blank' : undefined}
                  rel={target.external ? 'noopener' : undefined}
                >{finalCtasEn[i]}</a>
              );
            })}
          </div>
        )}
        {finalTrustPartsEn.length > 0 && (
          <div class="cta-trust">
            {finalTrustPartsEn.map((part, i) => (
              <>
                {i > 0 && <span class="dot"></span>}
                <span>{part}</span>
              </>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

<script>
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Scroll reveal ──
  if (!prefersReduced) {
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -60px 0px', threshold: 0.08 });
    document.querySelectorAll('[data-reveal]').forEach((el) => revealObserver.observe(el));
  } else {
    document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-visible'));
  }

  // ── Acordeon "Como trabajo" ──
  const accItems = document.querySelectorAll('.acc-item');
  const accPanelN = document.getElementById('accPanel')?.querySelector('.acc-panel-n');
  const accPanelT = document.getElementById('accPanel')?.querySelector('.acc-panel-t');
  const accPanelD = document.getElementById('accPanel')?.querySelector('.acc-panel-d');
  const accPips = document.querySelectorAll('.acc-pip');

  accItems.forEach((item, idx) => {
    const head = item.querySelector('.acc-item-head');
    head?.addEventListener('click', () => {
      accItems.forEach((other) => other.classList.remove('is-active'));
      item.classList.add('is-active');

      if (accPanelN) accPanelN.textContent = (item as HTMLElement).dataset.n ?? '';
      if (accPanelT) accPanelT.textContent = (item as HTMLElement).dataset.t ?? '';
      if (accPanelD) accPanelD.textContent = item.querySelector('.acc-d')?.textContent ?? '';
      accPips.forEach((pip, pIdx) => pip.classList.toggle('is-active', pIdx === idx));
    });
  });

  // ── Contadores de metricas ──
  if (!prefersReduced) {
    const countEls = document.querySelectorAll('[data-count]');
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

    function animateCount(el: Element) {
      const target = parseInt((el as HTMLElement).dataset.count ?? '0', 10);
      const duration = 1400;
      const start = performance.now();

      function frame(now: number) {
        const elapsed = now - start;
        const progress = Math.min(elapsed / duration, 1);
        const value = Math.round(easeOut(progress) * target);
        el.textContent = value.toLocaleString('en-US');
        if (progress < 1) requestAnimationFrame(frame);
      }

      requestAnimationFrame(frame);
    }

    const counterObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animateCount(entry.target);
          counterObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });

    countEls.forEach((el) => counterObserver.observe(el));
  }

  // ── Diagrama radial "Evidencia" ──
  const evidenceRadial = document.getElementById('evidenceRadial');
  if (evidenceRadial) {
    const fields = evidenceRadial.querySelectorAll('.evidence-field');
    fields.forEach((field) => {
      const key = (field as HTMLElement).dataset.field;
      const line = key ? evidenceRadial.querySelector(`.evidence-line[data-field="${key}"]`) : null;
      const dot = key ? evidenceRadial.querySelector(`.evidence-dot[data-field="${key}"]`) : null;

      const activate = () => {
        evidenceRadial.classList.add('has-active');
        field.classList.add('is-active');
        line?.classList.add('is-active');
        dot?.classList.add('is-active');
      };
      const deactivate = () => {
        evidenceRadial.classList.remove('has-active');
        field.classList.remove('is-active');
        line?.classList.remove('is-active');
        dot?.classList.remove('is-active');
      };

      field.addEventListener('mouseenter', activate);
      field.addEventListener('mouseleave', deactivate);
      field.addEventListener('focus', activate);
      field.addEventListener('blur', deactivate);
    });
  }
</script>
<script is:inline>
  (() => {
    const container = document.querySelector(".senja-embed");
    if (!container) return;

    const widgetId = container.getAttribute("data-id");
    if (!widgetId) return;

    if (!document.querySelector(`script[data-senja="${widgetId}"]`)) {
      const script = document.createElement("script");
      script.src = `https://widget.senja.io/widget/${widgetId}/platform.js`;
      script.async = true;
      script.dataset.senja = widgetId;
      document.body.appendChild(script);
    }
  })();
</script>
</BaseLayout>
