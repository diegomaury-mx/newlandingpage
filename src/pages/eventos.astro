---
/**
 * /eventos — agenda pública (quinta fuente de Diego CMS).
 * Fuente: colección `events` (loader en services/notionLoaders.ts, whitelist
 * 8.2 del "Pipeline de Eventos · Data Contract v2"). Solo lectura: Notion
 * define qué se publica, el código define cómo se muestra.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EventsAgenda from '../components/EventsAgenda.astro';
import { site } from '../config/site';
import type { EventData } from '../services/notionEvents.ts';

// Enlace público del formulario "Sugerir un evento" (Notion Site, funciona sin
// cuenta). Deposita en el Eventos Inbox; el sitio nunca recibe envíos.
const SUGGEST_EVENT_FORM_URL =
  'https://diegomaury.notion.site/8bc145de2ef046298ab63720d95787a4';

const events = (await getCollection('events')).map((entry) => entry.data as EventData);

const canonicalUrl = new URL('/eventos', Astro.site).toString();
const ogImage = new URL('/assets/img/diego-maury.png', Astro.site).toString();
// Descripción breve para SEO/social; el lede visible (copy.lede) es más largo.
const metaDescription =
  'Directorio curado de meetups, conferencias y summits de tecnología e innovación en México, con el enlace oficial de cada organizador. Actualizado continuamente.';
const copy = {
  eyebrow: 'Agenda pública',
  title: 'Directorio de eventos tech y de innovación en México',
  lede:
    'Tal vez aquí encuentres un evento de IA que te guste, un meetup de data science que te inspire o algo que no sabías que iba a pasar y justo te interese. Nunca sabes cuál será tu siguiente pasión. Directorio curado a mano, actualizado continuamente, con el enlace oficial de cada organizador.',
  suggestCta: 'Sugerir un evento',
  views: {
    week: 'Esta semana',
    next30: 'Próximos 30 días',
    next60: 'Próximos 60 días',
    calendar: 'Calendario',
    category: 'Por categoría',
  },
  allCategories: 'Todas',
  allTypes: 'Todos',
  onlyFree: 'Solo gratuitos',
  viewCase: 'Ver evento',
  free: 'Gratuito',
  checkLink: 'Consultar en el enlace',
  partOf: 'Parte de',
  empty: 'No hay eventos publicados en este momento. Vuelve pronto o sugiere uno.',
  closingTitle: '¿Organizas algo que debería estar aquí?',
  closingLede:
    'Si conoces un evento del ecosistema que valga la pena, compártelo. Si quieres conversar sobre programas o alianzas, agenda una llamada.',
  scheduleCta: 'Agendar una llamada',
  writeCta: 'Escríbeme',
};
---
<BaseLayout
  title="Directorio de Meetups y Eventos"
  description={metaDescription}
  canonicalUrl={canonicalUrl}
  ogImage={ogImage}
  enableGtm
  otherLocaleHref="/en/events"
  alternateUrls={[
    { lang: 'es', url: canonicalUrl },
    { lang: 'en', url: new URL('/en/events', Astro.site).toString() },
  ]}
>
  <EventsAgenda
    locale="es"
    events={events}
    copy={copy}
    suggestUrl={SUGGEST_EVENT_FORM_URL}
    scheduleUrl={site.links.scheduling}
    emailUrl={site.links.email}
  />
</BaseLayout>
