*.zip
.agents/
# Salida de build local (no es un worktree de git pese al nombre)
.worktrees/

# Config local de Claude Code: rutas de la maquina y tokens. Nunca se versiona.
.claude/settings.local.json

# QA visual (Playwright): screenshots regenerables, no se versionan
qa-output/screenshots/
qa-output/screenshots-astro/

# Salida del skill /video-pitch (Hyperframes): regenerable, no es codigo fuente del sitio
video-pitch-output/

# Cache de imagenes de Notion (descargadas en cada build por los content
# loaders, ver src/services/notionImageCache.ts): regenerable, no se versiona
public/cms-media/notion/*
!public/cms-media/notion/translations/

# Cache de traducciones DeepL (ver deeplTranslationCache.ts) SI se versiona
# (excepcion al patron de arriba): a diferencia de las imagenes, Cloudflare
# Pages clona el repo limpio en cada build y NO persiste este cache entre
# deploys — sin commitearlo, cada push re-traduce el sitio COMPLETO desde
# cero (29 cuerpos de caso + home + portfolio), lo cual agoto la cuota
# mensual gratuita de DeepL (500k caracteres) en una sola tarde de pruebas
# (2026-08-17). Commitear estos .txt es la unica forma de que la traduccion
# ya pagada sobreviva entre deploys con la arquitectura actual.

# Playwright: artefactos de test run locales
/test-results/
/playwright-report/
/blob-report/
