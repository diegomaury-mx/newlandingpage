node_modules/
*.tmp
.DS_Store
desktop.ini

# Config local de editor (VS Code)
.vscode/

# Astro (scaffold de migracion Diego CMS)
dist/
.astro/

# Secretos de entorno (token de Notion, etc.). NUNCA se versiona. Ver .env.example
.env
.env.*
!.env.example

# Artefactos de tooling local (no son parte del sitio)
.playwright-mcp/
.superpowers/
.claude-design/
_ds_import/
*.zip
.agents/
# Salida de build local (no es un worktree de git pese al nombre)
.worktrees/

# Config local de Claude Code: rutas de la maquina y tokens. Nunca se versiona.
.claude/settings.local.json

# QA visual (Playwright): screenshots regenerables, no se versionan
qa-output/screenshots/
qa-output/screenshots-astro/

# Salida del skill /video-pitch (Hyperframes): regenerable, no es codigo fuente del sitio
video-pitch-output/

# Cache de imagenes de Notion (descargadas y recomprimidas en build por los
# content loaders, ver src/services/notionImageCache.ts) y de traducciones
# DeepL (deeplTranslationCache.ts) SI se versionan: Cloudflare Pages clona el
# repo limpio en cada build y NO persiste nada fuera de git entre deploys —
# sin commitear este cache, cada push recomprime/re-traduce TODO desde cero
# (causa raiz del incidente de LCP 15.6s y de la cuota DeepL agotada el
# 2026-08-17). Commitearlo es la unica forma de que el trabajo ya pagado
# (fetch+sharp, o tokens de DeepL) sobreviva entre deploys con la
# arquitectura actual (SSG sin build cache persistente en Cloudflare Pages).
!public/cms-media/notion/

# Playwright: artefactos de test run locales
/test-results/
/playwright-report/
/blob-report/
